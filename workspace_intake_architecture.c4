  dynamic view configuration_flow {
    title "Create and start configuration"
    description "The wizard saves a profile; starting a migration is a separate confirmed action."
    operator -> intake.entry.wizard "enter settings and review choices"
    intake.entry.wizard -> inputs.files.config "save confirmed YAML"
    operator -> intake.entry.start "choose saved profile and start"
    inputs.files.config -> intake.entry.start "load and validate selected profile"
    intake.entry.start -> intake.startup.runner "call run_pipeline with the selected scope"
  }

  dynamic view startup_flow {
    title "Open a migration run"
    description "Shared startup precedes either the compatibility or indexed route."
    intake.entry.start -> intake.startup.runner "start new run"
    intake.startup.runner -> intake.startup.config "create and persist RunConfig"
    intake.startup.config -> intake.storage.run_db "initialize tables and save selected settings"
    intake.startup.runner -> intake.startup.toolchain "enter configured Java scope"
    intake.startup.runner -> intake.indexed.runner "if indexed-v1 or indexed map, use map-first route"
  }

  dynamic view classic_inventory_flow {
    title "Compatibility source inventory"
    description "This route discovers Java before map import; a cold cache can require global Java syntax work."
    intake.startup.runner -> intake.classic.sources "discover Java locations"
    intake.classic.sources -> intake.classic.classpath "resolve classpath for source roots"
    intake.classic.classpath -> intake.classic.inventory "provide source and dependency indexes"
    intake.classic.inventory -> intake.classic.scanner "request cached or new Java reference facts"
    intake.classic.scanner -> intake.classic.inventory "return saved or newly parsed syntax facts"
    intake.classic.inventory -> intake.classic.resolution "resolve reference documents with the shared Java policy"
    intake.classic.resolution -> intake.classic.inventory "return target files and issues without reparsing source"
    intake.classic.inventory -> intake.evidence.usage "calculate global usage with selected detail"
    intake.classic.inventory -> intake.evidence.reports "write selected inventory reports"
  }

  dynamic view classic_import_flow {
    title "Compatibility map import and intake checks"
    description "New-map generation is skipped for an existing map. A scoped import pauses before the non-scoped preflight and planning branch."
    intake.startup.runner -> intake.mapper.dispatch "if needed, generate a compatibility map"
    intake.startup.runner -> intake.classic.importer "import the chosen vault"
    intake.classic.importer -> intake.completion.checkpoint "pause if evidence changed or scoped inventory is ready"
    intake.startup.runner -> intake.completion.preflight "otherwise check behavior_units dependencies if applicable"
    intake.startup.runner -> intake.completion.planning "after checks, prepare non-scoped planning inputs"
    intake.completion.planning -> intake.completion.checkpoint "save planning_inputs_ready or hand off to optional plan flow"
  }

  dynamic view indexed_map_flow {
    title "Build a reusable indexed map"
    description "Runs globally only for a new indexed map, with configured heap, batch, file and database-cache budgets. File facts and caller edges may be reused safely; source verification precedes finalized notes and atomic descriptor publication."
    intake.indexed.runner -> intake.mapper.dispatch "request indexed-v1 map without channel filtering"
    intake.mapper.dispatch -> intake.mapper.session "open analysis session and capture source snapshot"
    intake.mapper.session -> intake.mapper.java "analyze changed Java batches"
    intake.mapper.session -> intake.mapper.xml "persist XML and configuration facts"
    intake.mapper.session -> intake.mapper.resolve "resolve ownership, Java edges and configured roots"
    intake.mapper.resolve -> intake.mapper.publish "render linked evidence and publish completed revision"
  }

  dynamic view indexed_selection_flow {
    title "Load selected dependencies from a map"
    description "Existing maps skip generation and valid receipts avoid repeated note hashing. Global source hashes are checked; SQL selects actual context Java roots, while indexed intake reports selected source and classpath evidence without another syntax scan."
    intake.indexed.runner -> intake.indexed.reader "verify map identity and current source hashes"
    intake.indexed.reader -> intake.indexed.selection "make saved facts available"
    intake.indexed.selection -> intake.classic.classpath "report class availability for selected source projects"
    intake.indexed.selection -> intake.classic.inventory "provide selected dependency closure through mapped readers"
    intake.classic.inventory -> intake.evidence.usage "preserve workspace-wide shared-use counts"
    intake.classic.inventory -> intake.evidence.reports "publish selected evidence reports"
    intake.indexed.runner -> intake.indexed.importer "import selected notes and pin the map revision"
    intake.indexed.runner -> intake.completion.checkpoint "pause at scoped_inventory_ready"
  }

  dynamic view planning_flow {
    title "Optional plan and approval handoff"
    description "Only reached by the applicable non-scoped behavior_units route after preflight; a mock profile avoids the model call."
    intake.completion.preflight -> intake.completion.planning "allow planning after dependency checks pass"
    intake.completion.planning -> intake.completion.plan "supply ordered eligible operations"
    intake.completion.plan -> model_api "for non-mock profile, request an operation-batch plan"
    model_api -> intake.completion.plan "return proposed plan"
    intake.completion.plan -> intake.storage.run_db "save validated plan and approval evidence"
    intake.completion.plan -> intake.completion.checkpoint "record approval-gate outcome"
  }

  dynamic view failure_flow {
    title "Failure and resource cleanup"
    description "Uncaught pipeline errors record intake_failed; shared cleanup also runs after a successful or paused intake."
    intake.startup.runner -> intake.completion.checkpoint "record failed and intake_failed on exception"
    intake.completion.checkpoint -> intake.storage.run_db "persist failure state"
    intake.startup.runner -> intake.startup.toolchain "leave Java scope in finally"
    intake.startup.runner -> intake.storage.scratch "close working records and remove temporary files"
  }

  dynamic view standalone_flow {
    title "Older environment-file startup"
    description "The separate workspace_intake.main entry point saves startup evidence and stops; it does not enter the migration pipeline."
    operator -> intake.entry.standalone "supply environment file or resume identifier"
    intake.entry.standalone -> intake.mapper.dispatch "for a new startup, run Composer mapper"
    intake.entry.standalone -> intake.storage.vault "validate map layout and channel evidence"
    intake.entry.standalone -> intake.storage.run_db "initialize and persist RunConfig, then return"
  }

  view intake_entry_resume_details of intake.entry.resume {
    title "Resume a pinned run: drill down"
    description "Read the numbered steps in order. The parent view shows callers and stored evidence."
    include intake.entry.resume.*
  }

