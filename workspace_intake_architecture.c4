// Workspace intake architecture, reviewed against local code at fbf2fb4.
// Includes indexed progress, validation receipts, bounded reuse and pinned-run resume.
// Start with view index. Click elements to open their scoped views.
// Logical containers share processes unless their descriptions state otherwise.
// Compatibility and indexed-v1 paths are separate; indexed source checks are global hashes.

specification {
  element actor { style { shape person } }
  element system
  element container
  element component
  element datastore { style { shape storage } }
  element step
}

model {
  operator = actor {
    title "Operator"
    description "Chooses a saved configuration, channels and operations, then starts or resumes a migration. Reads progress and decides whether a prepared conversion may continue."
  }
  inputs = system {
    title "Workspace inputs"
    description "Files supplied to workspace intake, including the chosen configuration and the Composer source tree. These are read locally; intake does not run the bank's business operations."
    files = container {
      title "Configuration and source files"
      description "Local files read by the Python converter and the Java Composer mapper. Their names, contents and hashes identify the evidence used by a run."
      config = datastore {
        title "PipelineConfiguration YAML"
        description "Stores source and output locations, map settings, selected operations, Java settings and model options. The wizard writes it and load_configuration reads it."
      }
      java = datastore {
        title "Java source files"
        description "Hold implementation classes, imports, method bodies and inheritance. The classic scanner reads them directly; indexed intake checks their hashes and uses saved facts."
      }
      xml = datastore {
        title "Composer XML"
        description "Holds channels, operations, OP steps, formats, contexts, decorators and their configured links. Mapper readers and the classic inventory extract these definitions."
      }
      project = datastore {
        title ".project / .classpath / dse.ini"
        description "Hold project ownership, source folders, classpath entries and Composer settings. Discovery and mapper readers use them to connect definitions to Java files."
      }
      jars = datastore {
        title "Classpath JARs"
        description "Contain dependency classes listed in workspace configuration. Classpath discovery indexes their available class names for evidence; the AST helper does not perform a full compiler type-check against them."
      }
    }
  }
  intake = system {
    title "Snapir workspace intake"
    description "Turns a source workspace and selected operations into checked evidence for conversion. The containers below are logical areas of the Python application and its Java mapper, rather than separate deployed services."
    entry = container {
      title "Configuration and entry points"
      description "Collects the operator's choices and starts the intake runner. Also contains the older environment-file entry point, which has a narrower startup role."
      // Source: source/cli/configuration_wizard.py; source/cli/configuration_flow.py
      wizard = component {
        title "configuration_wizard"
        description "Called by the CLI to gather and review settings before saving a YAML configuration. Offers the current map format, a reusable indexed-v1 map, or an existing map; saving does not start mapping."
        s1 = step {
          title "1. Collect settings"
          description "Keep a draft containing source paths, map format or existing-map location, selected operations and runtime settings; an indexed existing map supplies its saved workspace ID."
        }
        s2 = step {
          title "2. Review choices"
          description "Show the selected values and allow the operator to go back and change them."
        }
        s3 = step {
          title "3. Save configuration"
          description "Write the confirmed values to the configuration file for a later migration start."
        }
      }
      // Source: source/cli/main.py; source/runtime/configuration.py
      start = component {
        title "cli.main / load_configuration"
        description "The migration menu loads and validates a saved PipelineConfiguration, confirms the start and completes operation selection. It passes the resulting profile to run_pipeline."
        s1 = step {
          title "1. Load saved profile"
          description "Read YAML, resolve paths and check required fields and map references."
        }
        s2 = step {
          title "2. Confirm selected scope"
          description "Confirm the migration start and complete the channel or operation choices."
        }
        s3 = step {
          title "3. Call run_pipeline"
          description "Pass the validated profile and new run identifier to the runtime."
        }
      }
      // Source: source/workspace_intake.py
      standalone = component {
        title "workspace_intake.main"
        description "An older entry point reads environment settings, runs the mapper and saves RunConfig after validation. Its main function explicitly defers the orchestrator start; it is not the run.cmd pipeline."
        s1 = step {
          title "1. Read environment settings"
          description "Load an optional environment file and validate source and required startup settings."
        }
        s2 = step {
          title "2. Map and validate vault"
          description "Run the Composer mapper, validate its output and report blocking problems."
        }
        s3 = step {
          title "3. Save startup record"
          description "Initialize the database and persist RunConfig; the resume branch only checks the run identifier."
        }
      }
      // Source: source/runtime/checkpoints.py
      resume = component {
        title "resume_pipeline"
        description "Called by the resume command to reopen saved configuration and checkpoint state. Indexed runs recheck source hashes and the pinned map and selection, bind mapped readers and hand off to the existing scoped workflow without regenerating the map."
        s1 = step {
          title "1. Open saved run"
          description "Load profile.json, RunConfig and checkpoint state from the existing run directory and database."
        }
        s2 = step {
          title "2. Restore indexed evidence"
          description "Open the saved map using its validation receipt, verify source hashes and reject a different pinned revision or selection."
        }
        s3 = step {
          title "3. Resume qualified workflow"
          description "Bind MappedInventory and mapped_scope, then continue the scoped runner and approval gates; release the mapped scope and reader afterward."
        }
      }
    }
    startup = container {
      title "Run setup and routing"
      description "Creates an identifiable run before analysis and selects the applicable intake route. Owns shared cleanup and failed-run recording."
      // Source: source/runtime/pipeline_runner.py
      runner = component {
        title "run_pipeline"
        description "Called by the migration CLI to create run folders, open the run database and select classic or indexed intake. Records intake_failed on exceptions and closes run resources in finally."
        s1 = step {
          title "1. Open run workspace"
          description "Create state, reports, logs and generated folders, and choose an external or run-local map location."
        }
        s2 = step {
          title "2. Select intake route"
          description "Use indexed intake for indexed-v1 configuration or an indexed map; otherwise use the compatibility route."
        }
        s3 = step {
          title "3. Record outcome and clean up"
          description "Keep the route's checkpoint or record failure, then close temporary storage, Java scope and the database."
        }
      }
      // Source: source/tools/workspace_intake_tools/run_factory.py; source/runtime/pipeline_runner.py
      config = component {
        title "create_run_config / persist_run_config"
        description "run_pipeline combines profile values with runtime settings and saves the exact run configuration. The snapshot is held in the run database and run reports, alongside profile.json."
        s1 = step {
          title "1. Build RunConfig"
          description "Combine selected channels and operations with mapper, output, model and gate settings."
        }
        s2 = step {
          title "2. Initialize state tables"
          description "Open the run SQLite database and create the tables required by intake."
        }
        s3 = step {
          title "3. Persist run settings"
          description "Save RunConfig and the profile snapshot so later stages use the same choices."
        }
      }
      // Source: source/runtime/java_toolchain.py; source/runtime/indexed_intake.py
      toolchain = component {
        title "java_scope / run_java"
        description "Selects the required local JDK and launches Java helpers with that environment. The indexed mapper launch monitors output and database activity against an inactivity timeout."
        s1 = step {
          title "1. Select local JDK"
          description "Resolve the configured Java version and executable and report the selected JDK."
        }
        s2 = step {
          title "2. Launch and watch command"
          description "Start the scanner or mapper with the selected environment; monitored calls distinguish inactivity from launch errors."
        }
        s3 = step {
          title "3. Release Java scope"
          description "Restore the previous runtime context when the intake runner leaves its Java scope."
        }
      }
    }
    classic = container {
      title "Compatibility inventory route"
      description "Discovers source files and builds converter-side inventory before importing a Composer map. A map may already exist, but this route still maintains its own Java analysis cache."
      // Source: source/tools/source_discovery_tools/discovery.py
      sources = component {
        title "discover_java_sources"
        description "run_pipeline asks this module to locate source roots and Java class names and report source-layout issues. Its source index feeds classpath discovery and component inventory."
        s1 = step {
          title "1. Find source roots"
          description "Read project metadata and source layout to determine where Java packages belong."
        }
        s2 = step {
          title "2. Index class locations"
          description "Associate source class names with their files while excluding empty or comment-only garbage files."
        }
        s3 = step {
          title "3. Report discovery issues"
          description "Persist the source index and stop intake when blocking source-layout issues remain."
        }
      }
      // Source: source/tools/source_discovery_tools/classpath.py
      classpath = component {
        title "discover_java_classpath"
        description "Indexes locally available JAR and JDK classes and reports missing dependency entries. The compatibility route inspects workspace metadata, while indexed intake supplies selected source roots to filter project metadata; this is an availability report, not full compiler type-checking."
        s1 = step {
          title "1. Read dependency entries"
          description "Read classpath and project metadata associated with discovered sources."
        }
        s2 = step {
          title "2. Resolve local dependencies"
          description "Locate configured JARs and JDK modules, index their class names and report unresolved entries."
        }
        s3 = step {
          title "3. Save classpath index"
          description "Return the resolved classpath information for analysis and its run report."
        }
      }
      // Source: source/tools/java_analysis_tools/source_dependencies/parser.py; source/tools/state_store_tools/workspace_analysis.py; source/java-analysis-core
      scanner = component {
        title "SourceAnalysis / WorkspaceAnalysis"
        description "The compatibility inventory invokes the shared java-analysis-core parser through analysis_runtime and keeps facts in WorkspaceAnalysis. The helper is compiled once per toolchain and source fingerprint, then reused for bounded batches; a cold compatibility run can still parse Java globally."
        s1 = step {
          title "1. Check workspace fingerprints"
          description "Read file identities and hashes to identify reusable cache records."
        }
        s2 = step {
          title "2. Analyze uncached Java"
          description "Reuse the shared helper to collect declarations, calls, inheritance and reference locations in bounded batches; the converter has no second AST implementation."
        }
        s3 = step {
          title "3. Publish complete revision"
          description "Verify the source snapshot and publish the completed analysis revision for later reuse."
        }
      }
      // Source: source/tools/component_inventory_tools
      inventory = component {
        title "build_component_inventory"
        description "Called by either intake route to connect configured Composer definitions to Java implementations. Uses InventoryRecords for working records; indexed calls obtain saved facts through mapped_scope rather than starting the Java scanner."
        s1 = step {
          title "1. Read configured definitions"
          description "Collect operation, OP-step, format, context and related definition facts from XML or the mapped fact adapter."
        }
        s2 = step {
          title "2. Connect Java implementations"
          description "Resolve configured implementations and Java references using source or saved-map facts."
        }
        s3 = step {
          title "3. Apply conversion scope"
          description "Keep detailed dependency evidence for the selected operations and their reachable dependencies."
        }
        s4 = step {
          title "4. Persist selected inventory"
          description "Save selected records, scope and compact usage results into the run database."
        }
      }
      // Source: source/agents/legacy_composer_analysis/agent.py; source/tools/composer_mapper_tools/vault_importer.py
      importer = component {
        title "run_legacy_composer_analysis"
        description "After optional map generation, imports the compatibility vault into run state and checks changed content. May pause for operator action when changed evidence requires a rerun; its deterministic import does not invoke an AI model."
        s1 = step {
          title "1. Import map notes"
          description "Load and validate the map's definitions and operation execution evidence."
        }
        s2 = step {
          title "2. Check changed evidence"
          description "Compare content hashes and invalidate affected downstream records."
        }
        s3 = step {
          title "3. Save import outcome"
          description "Record task status and either pause for operator action or mark inventory complete."
        }
      }
      // Source: source/tools/java_analysis_tools/source_dependencies/resolution_process.py; source/tools/java_analysis_tools/source_dependencies/resolution_index.py
      resolution = component {
        title "ResolutionWorker / resolution_index"
        description "The compatibility inventory sends bounded source-document requests to one shared Java resolver worker, using a temporary SQLite declaration index. Requests and responses are limited to 4 MiB, document caching is bounded and inactivity enforcement watches real worker activity."
        s1 = step {
          title "1. Capture declaration index"
          description "Store the discovered type names, source ownership and project visibility in temporary SQLite rather than sending a complete index for every reference."
        }
        s2 = step {
          title "2. Resolve document requests"
          description "Reuse one ReferenceResolutionMain worker with a 256 MiB heap and bounded messages and cached document results."
        }
        s3 = step {
          title "3. Return source relationships"
          description "Return resolved target files and issues to inventory; reuse the same SourceReferenceResolver policy as the mapper."
        }
      }
    }
    indexed = container {
      title "Indexed map-first intake"
      description "The opt-in indexed-v1 route reuses saved facts for selected operations and dependencies, with global source checks and shared-use counts. Compatibility defaults remain available, and an old map needs regeneration to provide the indexed Java graph."
      // Source: source/runtime/indexed_intake.py
      runner = component {
        title "run_indexed_intake"
        description "run_pipeline calls this route for indexed-v1 settings or a detected indexed map. One logged progress lifetime covers mapping, validation, source checks, selected loading and import before scoped_inventory_ready."
        s1 = step {
          title "1. Obtain indexed map"
          description "Reuse the chosen map or invoke the mapper globally with indexed-v1, configured resource budgets and no channel filter; stream its output to mapper.log and progress counters."
        }
        s2 = step {
          title "2. Open checked analysis"
          description "Open IndexedAnalysis with a saved validation receipt or fresh-publication proof, match the workspace ID and verify source hashes without parsing."
        }
        s3 = step {
          title "3. Build selected snapshot"
          description "Bind MappedInventory, report selected Java sources and project-filtered classpath, build inventory from saved facts and import selected evidence."
        }
        s4 = step {
          title "4. Pause at scoped checkpoint"
          description "Record scoped_inventory_ready; later conversion remains subject to its existing gates."
        }
      }
      // Source: source/tools/composer_mapper_tools/indexed_analysis.py
      reader = component {
        title "IndexedAnalysis"
        description "Checks the schema-4 descriptor, database digest, completion, required capabilities and links, then opens SQLite read-only. A matching validation receipt or just-completed mapper publication avoids rehashing every note; source hashes and imported note bodies remain checked."
        s1 = step {
          title "1. Check published map"
          description "Reject incomplete maps, unsafe paths, changed databases and missing Java edges, original-consumer or context-Java-root capabilities; reuse valid note-validation proof."
        }
        s2 = step {
          title "2. Verify source snapshot"
          description "Stream source-file hashes and detect changes or additions against the saved revision."
        }
        s3 = step {
          title "3. Expose saved records"
          description "Read one saved record at a time, limiting each decoded record or selected context to 4 MiB and the descriptor to 64 KiB; never decode a project-wide JSON graph."
        }
      }
      // Source: source/tools/component_inventory_tools/mapped_inventory.py; source/tools/composer_mapper_tools/mapped_scope.py
      selection = component {
        title "MappedInventory / mapped_scope"
        description "Selects requested operation contexts, adds required called contexts, then follows their saved context_java_roots and Java edges in SQL. Exposes selected implementations while retaining the full declaration index only for lookups, and serves XML or syntax facts without source parsing."
        s1 = step {
          title "1. Seed selected contexts"
          description "Apply configured channels and included or excluded operations to execution contexts."
        }
        s2 = step {
          title "2. Follow dependency closure"
          description "Add required called-operation contexts, seed Java from each consuming context's actual implementation roots and follow saved caller-to-target edges."
        }
        s3 = step {
          title "3. Bind mapped readers"
          description "Route definition and syntax requests to saved facts during intake and resume; hydrate only bounded requested XML subtrees or Java facts."
        }
      }
      // Source: source/tools/composer_mapper_tools/indexed_vault_importer.py
      importer = component {
        title "import_indexed_vault / pin_map"
        description "Reads selected Markdown bodies and execution bindings, checks them against the map revision and writes selected evidence to the run database. Uses a savepoint so incomplete imports are rolled back."
        s1 = step {
          title "1. Select required notes"
          description "Choose notes for selected contexts, reachable Java classes and necessary canonical definitions."
        }
        s2 = step {
          title "2. Verify and import evidence"
          description "Check bounded note content and hashes, then save definitions, usages, execution contexts and bindings."
        }
        s3 = step {
          title "3. Pin completed map revision"
          description "Recheck source hashes and map identity after import, pin the revision and selection, then commit; roll back the savepoint on failure."
        }
      }
      // Source: source/tools/state_store_tools/map_snapshot.py; source/tools/composer_mapper_tools/indexed_analysis.py
      snapshot = component {
        title "validation_receipt / pin_map"
        description "Keeps note-validation proof outside the input map and records the exact map generation and selected scope in run SQLite. New intake and resume reject replacement evidence or a changed selection instead of silently mixing snapshots."
        s1 = step {
          title "1. Find validation proof"
          description "Use output_root/.map-validation to look up proof keyed by map location, descriptor digest and analysis database digest."
        }
        s2 = step {
          title "2. Record validated generation"
          description "After initial note validation or trusted fresh publication, atomically save the receipt; selected imported notes still require content checks."
        }
        s3 = step {
          title "3. Pin revision and scope"
          description "Persist map location, descriptor and database hashes, workspace ID and operation selection; require the same values when reopening the run."
        }
      }
    }
    mapper = container {
      title "Composer mapper Java process"
      description "Maps Composer source definitions, execution paths and Java relationships into reusable files. Indexed generation is global: the converter's selected operation does not restrict what the mapper maps."
      // Source: source/tools/workspace_intake_tools/mapper_generation.py; source/composer-mapper/src/main/java
      dispatch = component {
        title "mapper_command / Main"
        description "The launcher passes layout, analysis format and resource budgets to Main, which selects indexed or compatibility generation. Indexed mode uses a fresh scoped destination and stable workspace ID; reuse-analysis and resume-analysis are mutually exclusive mapper options."
        s1 = step {
          title "1. Build mapper command"
          description "Pass source, destination, layout and analysis mode; indexed defaults are a 768 MiB JVM heap, 100-file or 4 MiB batches, an 8 MiB Java-file limit and a 32 MiB writer cache."
        }
        s2 = step {
          title "2. Choose generation mode"
          description "Select indexed AnalysisSession or the scoped or legacy compatibility generation path."
        }
        s3 = step {
          title "3. Report mapper result"
          description "Return the process exit status and mapper diagnostics to the intake caller."
        }
      }
      // Source: source/composer-mapper/src/main/java; source/java-analysis-core
      session = component {
        title "AnalysisSession / AnalysisStore"
        description "Coordinates source capture and fact reuse, enforcing batch, file and bounded-record limits. AnalysisStore keeps working facts in SQLite with disk-based temporary work, paged reads and commits after 500 writes or roughly 4 MiB of write data."
        s1 = step {
          title "1. Prepare source snapshot"
          description "Create a fresh destination, analysis database and in-progress marker; discover relevant files and reject source paths that escape the workspace."
        }
        s2 = step {
          title "2. Reuse or collect file facts"
          description "Check compatible complete reuse records, then capture changed Java or XML facts in bounded batches; oversized files or definitions fail with an explicit limit."
        }
        s3 = step {
          title "3. Expose persisted readers"
          description "Make saved Java metadata and XML views available to mapper generation rather than reparsing source files."
        }
      }
      // Source: source/composer-mapper/src/main/java; source/java-analysis-core
      java = component {
        title "JavaFactReader / SourceAnalysis"
        description "Uses the shared Java analysis core to collect Java metadata and references for indexed generation. Stores per-file facts and diagnostics; this parses source and does not execute application business code."
        s1 = step {
          title "1. Receive source batch"
          description "Take captured source contents and identities from AnalysisSession within its batch limits."
        }
        s2 = step {
          title "2. Read Java syntax and references"
          description "Extract declarations, imports, inheritance, calls and other reference facts using the shared AST analysis."
        }
        s3 = step {
          title "3. Store Java file facts"
          description "Persist per-file metadata, raw references and diagnostics for dependency resolution and reuse."
        }
      }
      // Source: source/composer-mapper/src/main/java
      xml = component {
        title "XmlFactReader / SqlXmlViews"
        description "Reads Composer XML into stored facts and exposes document views for existing mapping logic. Project metadata and supported configuration files also contribute source ownership and discovery facts."
        s1 = step {
          title "1. Capture supported files"
          description "Read relevant XML and configuration bytes and store their identities and hashes."
        }
        s2 = step {
          title "2. Extract XML facts"
          description "Use the secure XML reader to persist structural facts once for indexed source capture."
        }
        s3 = step {
          title "3. Provide document views"
          description "Build requested views from stored facts so mapping readers can retain their existing XML behavior."
        }
      }
      // Source: source/composer-mapper/src/main/java
      resolve = component {
        title "JavaDependencyResolver / CanonicalComponentRoots"
        description "Uses shared SourceReferenceResolver and IndexedTypeLookup to connect saved facts to owned source files. Preserves canonical original-consumer weights separately from actual consuming-context Java roots, so local overrides affect selection without inflating shared-use counts."
        s1 = step {
          title "1. Resolve source ownership"
          description "Connect Java classes to source projects and resolve reference candidates and ambiguous cases."
        }
        s2 = step {
          title "2. Store Java edges"
          description "Reuse completed caller edges when source and declaration or visibility policy match; otherwise resolve saved reference facts without reparsing unchanged sources."
        }
        s3 = step {
          title "3. Connect operation roots"
          description "Save canonical operation roots and original usage weights, plus actual Java roots for each channel-specific execution context."
        }
      }
      // Source: source/composer-mapper/src/main/java
      publish = component {
        title "ScopedVaultGenerationService / IndexedManifestWriter"
        description "Preserves inherited channel rules, ordered steps, routing and calls in canonical Markdown and saved execution records. Finalizes notes in bounded pages, copies verified identical prior notes when possible and atomically publishes a small descriptor after the database is closed."
        s1 = step {
          title "1. Assemble execution paths"
          description "Resolve channel inheritance, routing, ordered steps, calls and supporting format, context and decorator definitions."
        }
        s2 = step {
          title "2. Write mapper products"
          description "Write note and context facts to SQLite, preserve unused inventory and finalize Markdown in pages; verify and copy byte-identical prior notes instead of hard-linking files."
        }
        s3 = step {
          title "3. Publish completed descriptor"
          description "Verify source membership and hashes, checkpoint and close SQLite, then atomically publish vault-manifest.json with hashes, capabilities, JDK, policies and budgets."
        }
      }
      // Source: source/composer-mapper/src/main/java
      compatibility = component {
        title "IndexBuildService / StreamingGenerationService"
        description "Preserves the older mapping routes selected by Main. These routes use their existing parser and writer behavior, including Markdown and Excel products; the indexed fact store is a separate mode."
        s1 = step {
          title "1. Build compatibility index"
          description "Discover supported sources and build the existing legacy or scoped mapping index."
        }
        s2 = step {
          title "2. Generate existing products"
          description "Use the compatibility parsers and renderers to write their established Markdown and export products."
        }
        s3 = step {
          title "3. Complete compatibility map"
          description "Report errors and finish the layout-specific manifest or generation outputs."
        }
      }
      // Source: source/composer-mapper/src/main/java/il/co/dcd/composermapper/storage/FileFactReuse.java; source/composer-mapper/src/main/java/il/co/dcd/composermapper/storage/NoteReuse.java
      reuse = component {
        title "FileFactReuse / NoteReuse"
        description "Reads an earlier analysis into a fresh destination, copying only complete compatible facts and verified identical notes. Mapper CLI recovery can reuse completed facts from a failed builder, while normal reuse requires an intact published map."
        s1 = step {
          title "1. Check prior analysis policy"
          description "Match analyzer code and JDK policy before reusing a completed file with the same bytes; incompatible facts are parsed again."
        }
        s2 = step {
          title "2. Reuse safe file facts and edges"
          description "Copy unchanged AST or XML facts; reuse completed edges only when source hashes and declaration or project-visibility policy match."
        }
        s3 = step {
          title "3. Copy identical finalized notes"
          description "Match the newly produced note hash to the old note and verify its bytes while copying; never hard-link mutable input files."
        }
      }
    }
    evidence = container {
      title "Usage, reports and progress"
      description "Maintains workspace-wide shared-use information while publishing detailed evidence for the selected scope. Reports and diagnostics make long-running work visible without constructing a giant output string."
      // Source: source/tools/component_inventory_tools/segmented_java_usage.py; source/tools/component_inventory_tools/mapped_graph.py
      usage = component {
        title "build_segmented_usage / build_mapped_graph"
        description "Inventory keeps full-workspace original-consumer counts while exposing detailed uses only for selected dependencies. Indexed mode attaches the completed map read-only, joins global edges in SQL and reads selected reference sites and diagnostics; global metadata work remains even for one operation."
        s1 = step {
          title "1. Retain global consumer facts"
          description "Stream global implementation identities and root weights, and join saved Java edges into working SQL tables without materializing source bodies or a Python graph."
        }
        s2 = step {
          title "2. Propagate original usage"
          description "Preserve weighted uses from each original operation, including repeated steps and indirect paths; channel-specific selection does not multiply those original consumers."
        }
        s3 = step {
          title "3. Expose selected detail"
          description "Return compact usage summaries and detailed records for the requested implementations and configured definitions."
        }
      }
      // Source: source/runtime/selected_inventory_reports.py; source/runtime/inventory_reports.py
      reports = component {
        title "selected_inventory / write_json_report"
        description "Both routes project selected evidence from the run database and write inventory and dependency reports incrementally. The writer uses a temporary file and replaces the report after a successful write."
        s1 = step {
          title "1. Project selected records"
          description "Query selected inventory, conversion scope and implementation or configured-component usage."
        }
        s2 = step {
          title "2. Write records incrementally"
          description "Encode report records as they are read rather than building one complete project-sized JSON string."
        }
        s3 = step {
          title "3. Publish finished report"
          description "Replace the completed report file and report writing progress."
        }
      }
      // Source: source/runtime/inventory_work.py; source/runtime/intake_progress.py; source/composer-mapper/src/main/java
      progress = component {
        title "InventoryWork / IndexedMapperProgress"
        description "IndexedMapperProgress turns changed mapper completion counts into InventoryWork phases and counters throughout indexed intake. Process output and watched result-file changes reset inactivity timers; repeated console heartbeats do not count as completed work."
        s1 = step {
          title "1. Record completed work"
          description "Track source capture, dependency resolution, original-consumer counting, source indexing, operation mapping, inventory and note publication; repeated counts do not advance work."
        }
        s2 = step {
          title "2. Show periodic progress"
          description "Keep console heartbeats, intake.log and intake-progress.json active before mapping and through validation, selected loading and import; stream mapper output to mapper.log."
        }
        s3 = step {
          title "3. Diagnose inactivity"
          description "Capture thread stacks after a prolonged converter stall and apply the configured inactivity policy to monitored Java calls."
        }
      }
    }
    storage = container {
      title "Local intake storage"
      description "The run database and working SQLite files hold structured records, while the vault and reports hold human-readable evidence. These are local files, with no server database or queue required by intake itself."
      run_db = datastore {
        title "Run SQLite database"
        description "Stores RunConfig, selected component records, scope, operation evidence, usage summaries and checkpoints. Intake writers commit evidence here and later conversion reads the saved run."
      }
      analysis_db = datastore {
        title "analysis/analysis.sqlite"
        description "Stores source identities, per-file facts, shared Java edges, canonical consumer counts, actual context Java roots and note hashes. Mapper writers checkpoint and close it before publication; readers keep the completed revision read-only."
      }
      vault = datastore {
        title "Composer map Markdown vault"
        description "Holds canonical source notes, operation execution evidence and links. Mapper writers create it, and vault importers read and check the required notes."
      }
      descriptor = datastore {
        title "Map descriptor / manifest"
        description "The small vault-manifest.json holds schema, workspace, database hash, capabilities, parser and resolver policies, producer JDK and budgets. It contains no global entity or dependency arrays, and unfinished builds retain a separate generation marker."
      }
      cache = datastore {
        title "WorkspaceAnalysis SQLite cache"
        description "Stores converter-side source fingerprints and reusable syntax facts for the compatibility route. The converter checks and publishes complete workspace revisions here."
      }
      scratch = datastore {
        title "Temporary inventory and type-index SQLite"
        description "Holds working inventory, graph edges and usage calculations for either route. Compatibility resolution also creates a temporary SQLite declaration index; scoped lifetimes and worker cleanup release these working files."
      }
      output = datastore {
        title "Run reports and logs"
        description "Hold configuration snapshots, selected inventory JSON, dependency and usage reports, mapper logs and progress diagnostics. Operators read these files to understand results and stalls."
      }
      receipts = datastore {
        title ".map-validation receipts"
        description "Small proof files under output_root/.map-validation identify a previously checked immutable map generation. IndexedAnalysis reads or atomically updates them outside the source map; they do not bypass source checks or selected-note verification."
      }
    }
    completion = container {
      title "Intake checks and handoff"
      description "Records a stable stopping point before conversion. Scoped routes stop with selected evidence; other routes may check operation dependencies and prepare a reviewable plan."
      // Source: source/tools/component_inventory_tools/service_inventory.py; source/tools/operation_call_tools/preflight.py
      preflight = component {
        title "service_inventory / run_intake_preflight"
        description "For the behavior_units compatibility route, reads configured service evidence and checks qualified operation dependencies. Missing required operations, unresolved evidence or cycles can block intake before planning."
        s1 = step {
          title "1. Collect service definitions"
          description "Read configured channel and service information and save its evidence without calling live services."
        }
        s2 = step {
          title "2. Check operation dependencies"
          description "Check required operation inclusion, qualified calls and dependency cycles."
        }
        s3 = step {
          title "3. Publish blockers or pass"
          description "Write preflight evidence and pause for operator action when blockers remain."
        }
      }
      // Source: source/runtime/pipeline_runner.py; source/tools/conversion_tools/context_hierarchy_resolver_tool.py; source/runtime/intake_plan.py
      planning = component {
        title "Context hierarchy / planning inputs"
        description "The compatibility route builds context hierarchies and shared-artifact classifications, then selects operations for planning. Writes planning_inputs.json and either pauses or calls prepare_intake_plan for behavior_units."
        s1 = step {
          title "1. Build context hierarchy"
          description "Connect imported operation and source evidence into the context structure used by later stages."
        }
        s2 = step {
          title "2. Classify shared artifacts"
          description "Classify shared items and obtain the operations eligible for the configured conversion scope."
        }
        s3 = step {
          title "3. Save planning inputs"
          description "Persist the operation list and either hand it to plan preparation or stop at planning_inputs_ready."
        }
      }
      // Source: source/runtime/intake_plan.py; source/runtime/planning.py; source/runtime/model_execution/adk_executor.py
      plan = component {
        title "prepare_intake_plan / prepare_plan"
        description "An optional post-check handoff builds and validates an operation-batch plan, saves JSON and Markdown for review and evaluates the approval gate. Non-mock profiles call AdkExecutor; indexed scoped intake does not reach this call during its initial intake."
        s1 = step {
          title "1. Prepare planning request"
          description "Order qualified operation dependencies and provide the requested scope and plan schema."
        }
        s2 = step {
          title "2. Obtain and validate plan"
          description "Use the configured AI model or mock executor, then validate run ownership, task identities, counts and ordering."
        }
        s3 = step {
          title "3. Save plan and evaluate gate"
          description "Save the plan and review reports, then keep conversion behind the required approval checks."
        }
      }
      // Source: source/tools/state_store_tools/runs.py; source/runtime/pipeline_runner.py; source/runtime/indexed_intake.py
      checkpoint = component {
        title "update_run_status"
        description "Stores the run's outcome so status and resume commands know what evidence is available. Distinguishes selected inventory ready, planning inputs ready, operator blockers and intake failure."
        s1 = step {
          title "1. Record ready checkpoint"
          description "Store scoped_inventory_ready for scoped intake or planning_inputs_ready for the compatibility planning boundary."
        }
        s2 = step {
          title "2. Record blocking evidence"
          description "Store the appropriate operator-action or plan-blocked state when checks do not pass."
        }
        s3 = step {
          title "3. Record failed intake"
          description "Store failed and intake_failed when the runtime catches an intake exception."
        }
      }
    }
  }
  jdk = system {
    title "Local Java toolchain"
    description "The selected local JDK runs the Composer mapper and packaged shared Java analysis tools. The shared parser and reference resolver come from java-analysis-core, rather than separate converter and mapper implementations."
    tools = container {
      title "JDK and shared Java helpers"
      description "Installed Java executables plus the locally built java-analysis-core parser and resolver. They analyze source and saved facts locally, without running business operations."
      // Source: source/runtime/java_toolchain.py
      runtime = component {
        title "java executable"
        description "run_java launches the selected executable for mapper and scanner subprocesses. Returns process output and an exit status to the Python caller."
        s1 = step {
          title "1. Start requested Java tool"
          description "Launch the mapper JAR or Java analysis helper in the selected environment."
        }
        s2 = step {
          title "2. Return process outcome"
          description "Supply stdout, stderr and the exit result, or report launch and monitored inactivity failures."
        }
      }
      // Source: source/java-analysis-core
      compiler = component {
        title "JavacTask / shared analysis core"
        description "The Java analysis core uses JavacTask.parse to extract source structure and references; separate resolvers connect those facts to source files. Mapper indexed batches and the converter compatibility scanner share this parser, without full compiler type-checking."
        s1 = step {
          title "1. Read source batch"
          description "Receive bounded captured Java source files and their identities."
        }
        s2 = step {
          title "2. Extract source facts"
          description "Parse declarations and reference expressions without annotation processing or application execution; later resolvers decide which source files they refer to."
        }
      }
      // Source: source/java-analysis-core/src/main/java/il/co/dcd/javaanalysis
      resolver = component {
        title "SourceReferenceResolver / IndexedTypeLookup"
        description "One shared source-reference policy resolves imports, names and project visibility against declarations in SQLite. Mapper calls it directly; the compatibility converter reaches it through ReferenceResolutionMain and a bounded message protocol."
        s1 = step {
          title "1. Read facts and visibility"
          description "Use saved reference expressions, imports, local names and declared project references to establish the lookup context."
        }
        s2 = step {
          title "2. Query eligible declarations"
          description "Find candidate source files through IndexedTypeLookup, preserving ambiguity or unresolved-reference issues."
        }
        s3 = step {
          title "3. Return targets and diagnostics"
          description "Return resolved source-file targets and diagnostics without another AST parse or full compiler type-check."
        }
      }
    }
  }
  model_api = system {
    title "Configured AI model endpoint"
    description "AdkExecutor can call the configured model when the optional migration-plan handoff runs. The endpoint may be on-premises; source scanning and indexed fact reuse do not require an AI call."
  }

  // Calls, evidence movement and storage access.
  operator -> intake.entry.wizard "enters and reviews configuration"
  operator -> intake.entry.start "selects a configuration and starts migration"
  operator -> intake.entry.standalone "optionally invokes environment-file startup"
  intake.entry.wizard -> inputs.files.config "writes confirmed YAML settings"
  inputs.files.config -> intake.entry.start "supplies saved profile and selected scope"
  intake.entry.start -> intake.startup.runner "passes validated profile and run identifier"
  intake.entry.standalone -> intake.mapper.dispatch "runs the older startup mapper command"
  intake.entry.standalone -> intake.storage.run_db "persists validated startup configuration"
  intake.startup.runner -> intake.startup.config "creates and saves RunConfig"
  intake.startup.runner -> intake.startup.toolchain "enters the selected Java environment"
  intake.startup.config -> intake.storage.run_db "initializes tables and saves RunConfig"
  intake.startup.config -> intake.storage.output "writes configuration and profile snapshots"
  intake.startup.runner -> intake.classic.sources "starts compatibility source discovery"
  intake.startup.runner -> intake.indexed.runner "selects indexed-v1 map-first route"
  intake.classic.sources -> inputs.files.java "reads source layout and class names"
  intake.classic.sources -> inputs.files.project "reads source-root ownership"
  intake.classic.sources -> intake.classic.classpath "provides source locations and roots"
  intake.classic.classpath -> inputs.files.project "reads classpath and project declarations"
  intake.classic.classpath -> inputs.files.jars "locates dependency type information"
  intake.classic.classpath -> intake.classic.inventory "supplies source and classpath indexes"
  intake.classic.inventory -> inputs.files.xml "reads definitions on the compatibility route"
  intake.classic.inventory -> intake.classic.scanner "requests source syntax on the compatibility route"
  intake.classic.scanner -> inputs.files.java "reads source identities and uncached content"
  intake.classic.scanner -> intake.storage.cache "checks cached facts and publishes revisions"
  intake.classic.scanner -> intake.startup.toolchain "launches the Java scanner when facts are missing"
  intake.startup.toolchain -> jdk.tools.runtime "launches mapper or scanner with local JDK"
  jdk.tools.runtime -> jdk.tools.compiler "runs the shared Java analysis helper"
  intake.classic.scanner -> intake.classic.inventory "returns declarations and reference facts"
  intake.classic.inventory -> intake.storage.scratch "writes disk-backed working inventory"
  intake.classic.inventory -> intake.evidence.usage "requests scoped detail and global usage counts"
  intake.evidence.usage -> intake.storage.scratch "reads and writes graph and weighted consumer records"
  intake.evidence.usage -> intake.storage.run_db "persists compact usage results"
  intake.classic.inventory -> intake.storage.run_db "saves selected inventory and conversion scope"
  intake.classic.inventory -> intake.evidence.reports "provides selected inventory for reports"
  intake.evidence.reports -> intake.storage.run_db "queries selected inventory and usage"
  intake.evidence.reports -> intake.storage.output "streams selected JSON reports"
  intake.classic.inventory -> intake.evidence.progress "reports real phase and completed-work counters"
  intake.evidence.reports -> intake.evidence.progress "reports incremental writing activity"
  intake.evidence.progress -> intake.storage.output "writes progress state and stall diagnostics"
  intake.evidence.progress -> operator "shows periodic progress and diagnostic locations"
  intake.startup.runner -> intake.mapper.dispatch "generates compatibility map only when no existing map was chosen"
  intake.startup.runner -> intake.classic.importer "imports the selected compatibility vault"
  intake.classic.importer -> intake.storage.vault "reads map notes and execution evidence"
  intake.classic.importer -> intake.storage.run_db "imports evidence and invalidates changed dependent records"
  intake.classic.importer -> intake.completion.checkpoint "returns import completion or pause condition"
  intake.indexed.runner -> intake.mapper.dispatch "requests a global indexed map only when a new map is required"
  intake.indexed.runner -> intake.indexed.reader "opens completed map and verifies source snapshot"
  intake.indexed.reader -> intake.storage.descriptor "checks format, capabilities and revision identity"
  intake.indexed.reader -> intake.storage.analysis_db "opens immutable completed SQLite facts"
  intake.indexed.reader -> intake.storage.vault "checks persisted note hashes and map evidence"
  intake.indexed.reader -> inputs.files "verifies source hashes and detects additions without AST parsing"
  intake.indexed.reader -> intake.indexed.selection "supplies checked persisted facts"
  intake.indexed.selection -> intake.storage.analysis_db "queries selected contexts and reachable Java edges"
  intake.indexed.selection -> intake.classic.inventory "provides mapped definitions and syntax facts"
  intake.indexed.selection -> intake.evidence.usage "supplies global edge and consumer metadata with selected detail"
  intake.indexed.runner -> intake.indexed.importer "requests selected evidence import"
  intake.indexed.importer -> intake.storage.analysis_db "queries selected note identities and execution bindings"
  intake.indexed.importer -> intake.storage.vault "reads and verifies selected Markdown bodies"
  intake.indexed.importer -> intake.storage.run_db "commits selected definitions, bindings and pinned revision"
  intake.indexed.runner -> intake.completion.checkpoint "records scoped_inventory_ready after selected import"
  intake.mapper.dispatch -> intake.startup.toolchain "starts the selected Java mapper JAR"
  intake.mapper.dispatch -> intake.mapper.session "opens AnalysisSession for indexed-v1"
  intake.mapper.dispatch -> intake.mapper.compatibility "selects scoped or legacy compatibility generation"
  intake.mapper.session -> inputs.files "captures changed source files and checks reusable file identities"
  intake.mapper.session -> intake.storage.analysis_db "stores snapshot identities and reusable file facts"
  intake.mapper.session -> intake.mapper.java "submits bounded changed-Java batches"
  intake.mapper.session -> intake.mapper.xml "submits XML and project configuration files"
  intake.mapper.java -> jdk.tools.compiler "extracts Java AST and reference facts"
  intake.mapper.java -> intake.storage.analysis_db "persists Java metadata and raw reference facts"
  intake.mapper.xml -> intake.storage.analysis_db "persists XML facts and reads requested views"
  intake.mapper.session -> intake.mapper.resolve "starts ownership, edge and root resolution"
  intake.mapper.resolve -> intake.storage.analysis_db "reads saved facts and writes edges, diagnostics and roots"
  intake.mapper.resolve -> intake.mapper.publish "provides linked source and configured execution evidence"
  intake.mapper.xml -> intake.mapper.publish "supplies stored document views"
  intake.mapper.publish -> intake.storage.vault "writes canonical Markdown and execution links"
  intake.mapper.publish -> intake.storage.analysis_db "writes context parts, bindings and note hashes"
  intake.mapper.publish -> intake.storage.descriptor "publishes completed indexed map revision"
  intake.mapper.publish -> intake.evidence.progress "reports mapping counts and durable mapper activity"
  intake.mapper.compatibility -> inputs.files "reads sources using existing parser behavior"
  intake.mapper.compatibility -> intake.storage.vault "writes existing Markdown and export products"
  intake.mapper.compatibility -> intake.storage.descriptor "writes layout-specific compatibility manifest"
  intake.startup.runner -> intake.completion.preflight "checks dependencies for non-scoped behavior_units intake"
  intake.completion.preflight -> inputs.files.xml "reads configured channel and service definitions"
  intake.completion.preflight -> intake.storage.run_db "reads qualified operation evidence and saves preflight results"
  intake.completion.preflight -> intake.completion.checkpoint "records dependency blockers when required"
  intake.startup.runner -> intake.completion.planning "builds planning inputs after successful non-scoped import and checks"
  intake.completion.planning -> intake.storage.run_db "reads imported evidence and saves hierarchy and shared classification"
  intake.completion.planning -> intake.storage.output "writes planning_inputs.json"
  intake.completion.planning -> intake.completion.plan "optionally prepares a behavior_units conversion plan"
  intake.completion.plan -> model_api "sends planning instructions and operation evidence for non-mock profiles"
  model_api -> intake.completion.plan "returns proposed plan JSON"
  intake.completion.plan -> intake.storage.run_db "saves validated plan and approval evidence"
  intake.completion.plan -> intake.storage.output "writes reviewable conversion plan JSON and Markdown"
  intake.completion.plan -> intake.completion.checkpoint "records gate and plan readiness outcomes"
  intake.completion.planning -> intake.completion.checkpoint "records planning_inputs_ready when no plan handoff runs"
  intake.startup.runner -> intake.completion.checkpoint "records failed intake when an exception escapes"
  intake.completion.checkpoint -> intake.storage.run_db "writes status and checkpoint"


  // Indexed validation, actual consuming-context selection and shared Java policy.
  operator -> intake.entry.resume "chooses an existing run checkpoint"
  intake.entry.resume -> intake.storage.run_db "reads saved RunConfig, checkpoint and pinned map evidence"
  intake.entry.resume -> intake.storage.output "reads the saved profile snapshot"
  intake.entry.resume -> intake.indexed.reader "opens indexed facts and verifies current source hashes"
  intake.entry.resume -> intake.indexed.snapshot "requires the pinned map revision and selected scope"
  intake.entry.resume -> intake.indexed.selection "restores mapped readers for the scoped workflow"
  intake.entry.resume -> intake.completion.checkpoint "continues existing qualified gates from the saved checkpoint"
  intake.indexed.runner -> intake.evidence.progress "keeps mapping, validation and selection within one logged lifetime"
  intake.indexed.runner -> intake.indexed.snapshot "locates validation receipt before opening indexed facts"
  intake.indexed.reader -> intake.indexed.snapshot "uses validated-generation proof to avoid repeated global note hashing"
  intake.indexed.snapshot -> intake.storage.receipts "reads or atomically writes external validation receipts"
  intake.indexed.snapshot -> intake.storage.run_db "pins map hashes, workspace identity and exact selection"
  intake.indexed.importer -> intake.indexed.snapshot "pins the verified map inside the selected-import savepoint"
  intake.indexed.importer -> inputs.files "rechecks source hashes and membership before committing"
  intake.indexed.selection -> intake.classic.classpath "restricts project metadata discovery to selected Java roots"
  intake.indexed.runner -> intake.evidence.reports "writes selected source index and filtered classpath evidence"
  intake.classic.inventory -> intake.classic.resolution "resolves compatibility Java facts to source targets"
  intake.classic.resolution -> intake.storage.scratch "writes bounded on-disk declaration and visibility metadata"
  intake.classic.resolution -> jdk.tools.runtime "starts or reuses one 256 MiB reference-resolution worker"
  intake.classic.resolution -> jdk.tools.resolver "uses shared Java policy through bounded request and response frames"
  jdk.tools.runtime -> jdk.tools.resolver "runs ReferenceResolutionMain for compatibility requests"
  intake.classic.resolution -> intake.classic.inventory "returns resolved target paths and reference diagnostics"
  intake.mapper.resolve -> jdk.tools.resolver "uses shared resolution policy against saved declarations"
  intake.mapper.session -> intake.mapper.reuse "checks prior complete file facts and matching parser policy"
  intake.mapper.resolve -> intake.mapper.reuse "reuses completed caller edges when resolution policy matches"
  intake.mapper.publish -> intake.mapper.reuse "copies verified identical finalized prior notes"
  intake.mapper.reuse -> intake.storage.analysis_db "reads prior facts and copies safe records into the fresh revision"
  intake.mapper.reuse -> intake.storage.vault "verifies and copies byte-identical prior note content"

  // Internal steps for reusable-map verification, resume and bounded resolution.
  intake.entry.resume.s1 -> intake.entry.resume.s2 "continues"
  intake.entry.resume.s2 -> intake.entry.resume.s3 "continues"
  intake.classic.resolution.s1 -> intake.classic.resolution.s2 "continues"
  intake.classic.resolution.s2 -> intake.classic.resolution.s3 "continues"
  intake.indexed.snapshot.s1 -> intake.indexed.snapshot.s2 "continues"
  intake.indexed.snapshot.s2 -> intake.indexed.snapshot.s3 "continues"
  intake.mapper.reuse.s1 -> intake.mapper.reuse.s2 "continues"
  intake.mapper.reuse.s2 -> intake.mapper.reuse.s3 "continues"
  jdk.tools.resolver.s1 -> jdk.tools.resolver.s2 "continues"
  jdk.tools.resolver.s2 -> jdk.tools.resolver.s3 "continues"

  // Ordered internal steps are visible only in each component's own drill-down.
  intake.entry.wizard.s1 -> intake.entry.wizard.s2 "continues"
  intake.entry.wizard.s2 -> intake.entry.wizard.s3 "continues"
  intake.entry.start.s1 -> intake.entry.start.s2 "continues"
  intake.entry.start.s2 -> intake.entry.start.s3 "continues"
  intake.entry.standalone.s1 -> intake.entry.standalone.s2 "continues"
  intake.entry.standalone.s2 -> intake.entry.standalone.s3 "continues"
  intake.startup.runner.s1 -> intake.startup.runner.s2 "continues"
  intake.startup.runner.s2 -> intake.startup.runner.s3 "continues"
  intake.startup.config.s1 -> intake.startup.config.s2 "continues"
  intake.startup.config.s2 -> intake.startup.config.s3 "continues"
  intake.startup.toolchain.s1 -> intake.startup.toolchain.s2 "continues"
  intake.startup.toolchain.s2 -> intake.startup.toolchain.s3 "continues"
  intake.classic.sources.s1 -> intake.classic.sources.s2 "continues"
  intake.classic.sources.s2 -> intake.classic.sources.s3 "continues"
  intake.classic.classpath.s1 -> intake.classic.classpath.s2 "continues"
  intake.classic.classpath.s2 -> intake.classic.classpath.s3 "continues"
  intake.classic.scanner.s1 -> intake.classic.scanner.s2 "continues"
  intake.classic.scanner.s2 -> intake.classic.scanner.s3 "continues"
  intake.classic.inventory.s1 -> intake.classic.inventory.s2 "continues"
  intake.classic.inventory.s2 -> intake.classic.inventory.s3 "continues"
  intake.classic.inventory.s3 -> intake.classic.inventory.s4 "continues"
  intake.classic.importer.s1 -> intake.classic.importer.s2 "continues"
  intake.classic.importer.s2 -> intake.classic.importer.s3 "continues"
  intake.indexed.runner.s1 -> intake.indexed.runner.s2 "continues"
  intake.indexed.runner.s2 -> intake.indexed.runner.s3 "continues"
  intake.indexed.runner.s3 -> intake.indexed.runner.s4 "continues"
  intake.indexed.reader.s1 -> intake.indexed.reader.s2 "continues"
  intake.indexed.reader.s2 -> intake.indexed.reader.s3 "continues"
  intake.indexed.selection.s1 -> intake.indexed.selection.s2 "continues"
  intake.indexed.selection.s2 -> intake.indexed.selection.s3 "continues"
  intake.indexed.importer.s1 -> intake.indexed.importer.s2 "continues"
  intake.indexed.importer.s2 -> intake.indexed.importer.s3 "continues"
  intake.mapper.dispatch.s1 -> intake.mapper.dispatch.s2 "continues"
  intake.mapper.dispatch.s2 -> intake.mapper.dispatch.s3 "continues"
  intake.mapper.session.s1 -> intake.mapper.session.s2 "continues"
  intake.mapper.session.s2 -> intake.mapper.session.s3 "continues"
  intake.mapper.java.s1 -> intake.mapper.java.s2 "continues"
  intake.mapper.java.s2 -> intake.mapper.java.s3 "continues"
  intake.mapper.xml.s1 -> intake.mapper.xml.s2 "continues"
  intake.mapper.xml.s2 -> intake.mapper.xml.s3 "continues"
  intake.mapper.resolve.s1 -> intake.mapper.resolve.s2 "continues"
  intake.mapper.resolve.s2 -> intake.mapper.resolve.s3 "continues"
  intake.mapper.publish.s1 -> intake.mapper.publish.s2 "continues"
  intake.mapper.publish.s2 -> intake.mapper.publish.s3 "continues"
  intake.mapper.compatibility.s1 -> intake.mapper.compatibility.s2 "continues"
  intake.mapper.compatibility.s2 -> intake.mapper.compatibility.s3 "continues"
  intake.evidence.usage.s1 -> intake.evidence.usage.s2 "continues"
  intake.evidence.usage.s2 -> intake.evidence.usage.s3 "continues"
  intake.evidence.reports.s1 -> intake.evidence.reports.s2 "continues"
  intake.evidence.reports.s2 -> intake.evidence.reports.s3 "continues"
  intake.evidence.progress.s1 -> intake.evidence.progress.s2 "continues"
  intake.evidence.progress.s2 -> intake.evidence.progress.s3 "continues"
  intake.completion.preflight.s1 -> intake.completion.preflight.s2 "continues"
  intake.completion.preflight.s2 -> intake.completion.preflight.s3 "continues"
  intake.completion.planning.s1 -> intake.completion.planning.s2 "continues"
  intake.completion.planning.s2 -> intake.completion.planning.s3 "continues"
  intake.completion.plan.s1 -> intake.completion.plan.s2 "continues"
  intake.completion.plan.s2 -> intake.completion.plan.s3 "continues"
  intake.completion.checkpoint.s1 -> intake.completion.checkpoint.s2 "continues"
  intake.completion.checkpoint.s2 -> intake.completion.checkpoint.s3 "continues"
  jdk.tools.runtime.s1 -> jdk.tools.runtime.s2 "continues"
  jdk.tools.compiler.s1 -> jdk.tools.compiler.s2 "continues"
}

views {
  view index {
    title "Workspace intake: start here"
    description "Five top-level participants. Open Snapir workspace intake, then choose a logical area or an ordered flow; every element with children has its own drill-down."
    include operator, inputs, intake, jdk, model_api
  }

  view inputs_details of inputs {
    title "Workspace inputs: drill down"
    description "Direct children only. Open a child to see its internal steps or storage details."
    include inputs.*
  }

  view inputs_files_details of inputs.files {
