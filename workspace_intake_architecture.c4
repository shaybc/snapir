  }

  view intake_mapper_reuse_details of intake.mapper.reuse {
    title "Incremental fact and note reuse: drill down"
    description "Read the numbered steps in order. The parent view shows callers and stored evidence."
    include intake.mapper.reuse.*
  }

  view jdk_tools_resolver_details of jdk.tools.resolver {
    title "Shared source-reference resolver: drill down"
    description "Read the numbered steps in order. The parent view shows callers and stored evidence."
    include jdk.tools.resolver.*
  }

  dynamic view map_reuse_flow {
    title "Rebuild from compatible saved facts"
    description "A rebuild uses a fresh destination. Complete-map reuse can copy identical notes; mapper CLI recovery uses only complete compatible facts from an interrupted builder."
    intake.mapper.dispatch -> intake.mapper.session "start indexed generation with reuse-analysis or CLI resume-analysis"
    intake.mapper.session -> intake.mapper.reuse "check source hashes, completion and analyzer or JDK policy"
    intake.mapper.reuse -> intake.storage.analysis_db "copy compatible unchanged file facts to the fresh revision"
    intake.mapper.session -> intake.mapper.resolve "rebuild ownership and resolve or reuse stored reference edges"
    intake.mapper.resolve -> intake.mapper.publish "rebuild consuming contexts and finalize map products"
    intake.mapper.publish -> intake.mapper.reuse "for completed-map reuse, copy verified identical notes"
    intake.mapper.publish -> intake.storage.descriptor "verify sources, close the database and publish completed revision"
  }

  dynamic view map_validation_flow {
    title "Validate and pin selected map evidence"
    description "An existing map gets full initial note validation; a matching receipt or fresh successful mapper publication avoids repeating that full note pass. Source fingerprints are checked before loading and again before selected import commits."
    intake.indexed.runner -> intake.indexed.snapshot "find external validation receipt"
    intake.indexed.runner -> intake.indexed.reader "check descriptor, database, links and note-validation proof"
    intake.indexed.reader -> intake.indexed.snapshot "persist proof for this immutable generation"
    intake.indexed.reader -> intake.indexed.selection "verify sources and expose selected dependencies"
    intake.indexed.runner -> intake.indexed.importer "import selected checked notes and contexts"
    intake.indexed.importer -> intake.indexed.snapshot "pin exact map revision and selected scope"
    intake.indexed.importer -> intake.storage.run_db "recheck sources and map, then commit or roll back selected evidence"
  }

  dynamic view indexed_resume_flow {
    title "Resume without remapping"
    description "Restores saved indexed evidence before handing off to existing scoped conversion gates. A changed map revision, selection or source snapshot blocks reuse."
    operator -> intake.entry.resume "choose saved migration checkpoint"
    intake.entry.resume -> intake.storage.run_db "load RunConfig, checkpoint and pinned snapshot"
    intake.entry.resume -> intake.indexed.reader "open map with receipt and verify source hashes"
    intake.entry.resume -> intake.indexed.snapshot "require the same map generation and selected operations"
    intake.entry.resume -> intake.indexed.selection "restore mapped readers for subsequent evidence requests"
    intake.entry.resume -> intake.completion.checkpoint "continue scoped workflow and approval gates"
  }

}

