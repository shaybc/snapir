        <mxCell id="title" value="&lt;b&gt;The components behind a Composer conversion&lt;/b&gt;&lt;br&gt;Snapir · Component context · Not execution order" parent="1" vertex="1" style="text;html=1;align=left;fontColor=#c1cbd2;fontSize=19;whiteSpace=wrap;">
