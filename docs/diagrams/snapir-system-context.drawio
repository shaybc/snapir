  <diagram id="snapir-system-context" name="L1 · Snapir conversion workflow">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2440" pageHeight="1600" background="#20252b">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="diagram-title" value="SNAPIR · SYSTEM CONTEXT&lt;br&gt;&lt;b&gt;Composer → Native Java → Microservices&lt;/b&gt;&lt;br&gt;Level 1 · Current default workflow · Stable component IDs support future drill-downs" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#c3cdd7;fontSize=24;">
          <mxGeometry as="geometry" x="56" y="35" width="1800" height="100" />
        </mxCell>
        <mxCell id="default-policy" value="&lt;b&gt;DEFAULT FULL-CONVERSION POLICY&lt;/b&gt;&lt;br&gt;Facts OFF · AI tests + mocks ON&lt;br&gt;Shared reuse · Standalone + Microservice" parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#c3cdd7;fontSize=16;">
          <mxGeometry as="geometry" x="1960" y="180" width="360" height="110" />
        </mxCell>
        <mxCell id="diagram-legend" value="C01–C05: configure, analyze and plan. C06–C10: reuse, convert, validate and package.&lt;br&gt;Cyan: conversion flow · Purple: state/reuse · Gray: model tasks · Amber: user action&lt;br&gt;Deployment is a user action. Standalone calls external URLs; microservices call internal Services.&lt;br&gt;Drill down by component ID, for example C04, C07 or S02." parent="1" vertex="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#c3cdd7;fontSize=17;">
          <mxGeometry as="geometry" x="80" y="1430" width="2240" height="125" />
        </mxCell>
        <mxCell id="snapir-converter" value="SNAPIR CONVERTER" parent="1" vertex="1" style="rounded=1;html=1;verticalAlign=top;align=right;spacing=16;fillColor=#1b2229;strokeColor=#465c6c;dashed=1;fontColor=#8ea4b4;fontSize=16;container=1;collapsible=0;">
          <mxGeometry as="geometry" x="50" y="345" width="2300" height="710" />
        </mxCell>
        <mxCell id="U01" value="&lt;b&gt;&lt;font color=&quot;#9daebc&quot;&gt;U01&lt;/font&gt; · Migration operator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Configure source and selected operations&lt;br&gt;Start / resume; review and approve gates" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#30353a;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="80" y="180" width="360" height="110" />
        </mxCell>
        <mxCell id="E01" value="&lt;b&gt;&lt;font color=&quot;#9daebc&quot;&gt;E01&lt;/font&gt; · Composer workspace&lt;/b&gt;&lt;br&gt;&lt;br&gt;Java + XML across source projects&lt;br&gt;Classpath, Maven and external dependencies" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#30353a;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="550" y="180" width="360" height="110" />
        </mxCell>
        <mxCell id="S00" value="&lt;b&gt;&lt;font color=&quot;#ba9af5&quot;&gt;S00&lt;/font&gt; · Reusable analysis / AST index&lt;/b&gt;&lt;br&gt;&lt;br&gt;Indexed Composer map + source fingerprints&lt;br&gt;Reuse verified analysis; rebuild stale or missing inputs" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#302c3e;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="1020" y="180" width="830" height="110" />
        </mxCell>
        <mxCell id="C01" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C01&lt;/font&gt; · Configuration wizard&lt;/b&gt;&lt;br&gt;&lt;br&gt;Create Default Config / Advanced Configuration&lt;br&gt;Choose source, root operations, JDK and Maven&lt;br&gt;Set LiteLLM model + credential variable name&lt;br&gt;Set shared storage, namespace and service URLs&lt;br&gt;Save configs/&amp;lt;name&amp;gt;.yaml; no conversion yet" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="30" y="35" width="360" height="220" />
        </mxCell>
        <mxCell id="C02" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C02&lt;/font&gt; · Run startup &amp;amp; profile&lt;/b&gt;&lt;br&gt;&lt;br&gt;Load YAML; validate and resolve settings&lt;br&gt;Create an isolated run_id and run directories&lt;br&gt;Persist effective state/profile.json&lt;br&gt;Open the run database and save run settings&lt;br&gt;Credentials stay in the environment" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="500" y="35" width="360" height="220" />
        </mxCell>
        <mxCell id="C03" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C03&lt;/font&gt; · Composer Mapper &amp;amp; AST&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generate indexed/scoped map OR use existing&lt;br&gt;Read Java, XML, definitions and source links&lt;br&gt;Verify workspace identity and source hashes&lt;br&gt;Reuse valid map / analysis-cache entries&lt;br&gt;Collect dependency evidence; facts are OFF" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="970" y="35" width="360" height="220" />
        </mxCell>
        <mxCell id="C04" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C04&lt;/font&gt; · Automatic dependency closure&lt;/b&gt;&lt;br&gt;&lt;br&gt;Expand each selected root operation&lt;br&gt;Resolve operations, formats and OpSteps&lt;br&gt;Find classes and sources across projects&lt;br&gt;Identify shared candidates and HTTP targets&lt;br&gt;No extra channel selection is required" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="1440" y="35" width="360" height="220" />
        </mxCell>
        <mxCell id="C05" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C05&lt;/font&gt; · Plan, gates &amp;amp; orchestration&lt;/b&gt;&lt;br&gt;&lt;br&gt;Persist operation scope, dependencies and order&lt;br&gt;Create typed tasks and dependency-first batches&lt;br&gt;Apply configured approval gates&lt;br&gt;Checkpoint work; retry or resume from state&lt;br&gt;Detect stale inputs and incomplete artifacts" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="1910" y="35" width="360" height="220" />
        </mxCell>
        <mxCell id="C06" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C06&lt;/font&gt; · Shared reuse resolver&lt;/b&gt;&lt;br&gt;&lt;br&gt;Consult compatible, versioned shared entries&lt;br&gt;Reuse base classes, formats and OpStep code&lt;br&gt;Restore source, contracts and compiled JARs&lt;br&gt;Use registered HTTP APIs for called operations&lt;br&gt;Convert missing or incompatible dependencies" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="30" y="455" width="360" height="220" />
        </mxCell>
        <mxCell id="C07" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C07&lt;/font&gt; · Native Java conversion&lt;/b&gt;&lt;br&gt;&lt;br&gt;Generate components first, in dependency order&lt;br&gt;Separate Java, API metadata and test stages&lt;br&gt;Specialize configured formats and OpSteps&lt;br&gt;Assemble operation flow and HTTP clients&lt;br&gt;AI prepares tests, shared fixtures and mocks" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="500" y="455" width="360" height="220" />
        </mxCell>
        <mxCell id="C08" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C08&lt;/font&gt; · Build &amp;amp; validation&lt;/b&gt;&lt;br&gt;&lt;br&gt;Compile Java and execute Maven / JUnit tests&lt;br&gt;Compare XML formats with tests and mocks&lt;br&gt;Check source freshness, APIs and settings&lt;br&gt;Advisory mutation tests and AI review&lt;br&gt;Fact collection and fact validation are OFF" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="970" y="455" width="360" height="220" />
        </mxCell>
        <mxCell id="C09" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C09&lt;/font&gt; · Standalone &amp;amp; portable output&lt;/b&gt;&lt;br&gt;&lt;br&gt;Build a runnable operation and launch scripts&lt;br&gt;Include a validated example XML request&lt;br&gt;Package shared JARs and a local Maven repo&lt;br&gt;Retain runtime settings and test/demo assets&lt;br&gt;Called services use external URLs" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="1440" y="455" width="360" height="220" />
        </mxCell>
        <mxCell id="C10" value="&lt;b&gt;&lt;font color=&quot;#65d6e7&quot;&gt;C10&lt;/font&gt; · Microservice &amp;amp; Helm output&lt;/b&gt;&lt;br&gt;&lt;br&gt;Wrap accepted operation with Spring Boot HTTP&lt;br&gt;Produce executable JAR and Helm chart&lt;br&gt;Seed values.yaml with namespace and port&lt;br&gt;Validate build, tests, Helm lint/render/package&lt;br&gt;Called services use internal OpenShift DNS" parent="snapir-converter" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#28343d;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="1910" y="455" width="360" height="220" />
        </mxCell>
        <mxCell id="S01" value="&lt;b&gt;&lt;font color=&quot;#ba9af5&quot;&gt;S01&lt;/font&gt; · Run state · SQLite&lt;/b&gt;&lt;br&gt;&lt;br&gt;&amp;lt;run&amp;gt;/state/migration.db&lt;br&gt;Tasks, attempts, approvals and checkpoints&lt;br&gt;Dependencies, pinned revisions and evidence&lt;br&gt;All stages persist progress here&lt;br&gt;Resume reads the database + saved profile" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#302c3e;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="80" y="1190" width="360" height="220" />
        </mxCell>
        <mxCell id="S02" value="&lt;b&gt;&lt;font color=&quot;#ba9af5&quot;&gt;S02&lt;/font&gt; · Persistent shared registries&lt;/b&gt;&lt;br&gt;&lt;br&gt;shared/components · shared/operations&lt;br&gt;Converted source, typed contracts and JARs&lt;br&gt;Operation HTTP contracts and address settings&lt;br&gt;Manifests, hashes and rebuildable indexes&lt;br&gt;Current-run validation still guards reuse" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#302c3e;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="550" y="1190" width="360" height="220" />
        </mxCell>
        <mxCell id="S03" value="&lt;b&gt;&lt;font color=&quot;#9daebc&quot;&gt;S03&lt;/font&gt; · Live AI provider&lt;/b&gt;&lt;br&gt;&lt;br&gt;LiteLLM → Gemini Studio / configured model&lt;br&gt;API key read from the process environment&lt;br&gt;Generates Java, tests, fixtures and mocks&lt;br&gt;Receives source and accepted dependency APIs&lt;br&gt;AI claims do not replace executed validation" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#30353a;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="1020" y="1190" width="360" height="220" />
        </mxCell>
        <mxCell id="S04" value="&lt;b&gt;&lt;font color=&quot;#ba9af5&quot;&gt;S04&lt;/font&gt; · Deliverables &amp;amp; evidence&lt;/b&gt;&lt;br&gt;&lt;br&gt;Per-run generated projects and portable packages&lt;br&gt;Standalone + microservice JARs / Helm charts&lt;br&gt;reports/ · logs/ · validation receipts&lt;br&gt;Source/configuration fingerprints and manifests&lt;br&gt;Artifacts remain traceable to their conversion" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#302c3e;strokeColor=#53616d;arcSize=8;">
          <mxGeometry as="geometry" x="1490" y="1190" width="360" height="220" />
        </mxCell>
        <mxCell id="S05" value="&lt;b&gt;&lt;font color=&quot;#9daebc&quot;&gt;S05&lt;/font&gt; · OpenShift &amp;amp; deployed services&lt;/b&gt;&lt;br&gt;&lt;br&gt;USER publishes images and deploys services&lt;br&gt;Called operations are assumed available&lt;br&gt;Standalone callers → external service URLs&lt;br&gt;Microservices → internal Service DNS&lt;br&gt;Conversion does not deploy the cluster" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fontSize=16;fontColor=#eff5fa;fillColor=#30353a;strokeColor=#53616d;arcSize=8;">
