{"parts":[{"text":"{\"unit\": {\"unit_id\": \"configured_step-83d87fed10bb148669e0f846\", \"kind\": \"configured_step\", \"logical_id\": \"OverviewValidateLinks\", \"configuration_xml\": \"<opStep id=\\\"OverviewValidateLinks\\\" implClass=\\\"com.ibm.il.dse.cc.cut.CCComplexOpStep\\\" opExecuteName=\\\"ValidateClientLinksOp\\\" on0Do=\\\"OverviewRefreshLinks\\\" onOtherDo=\\\"end\\\" />\\n    \", \"sources\": [{\"identity\": \"com.ibm.dse.base.CCOperationStep\", \"content\": \"package com.ibm.dse.base;\\n\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\n/** Demo step contract with a shared operation context and explicitly registered services. */\\npublic abstract class CCOperationStep {\\n    private Context context;\\n    private final Map<String, Object> services = new HashMap<>();\\n\\n    public abstract int execute() throws Exception;\\n\\n    public void setContext(Context context) {\\n        this.context = Objects.requireNonNull(context, \\\"Operation context\\\");\\n    }\\n\\n    public Context getContext() {\\n        if (context == null) {\\n            throw new IllegalStateException(\\\"Configure an operation context before executing a step\\\");\\n        }\\n        return context;\\n    }\\n\\n    public void setService(String name, Object service) {\\n        services.put(Objects.requireNonNull(name, \\\"Service name\\\"), Objects.requireNonNull(service, \\\"Service\\\"));\\n    }\\n\\n    public Object getService(String name) {\\n        Object service = services.get(Objects.requireNonNull(name, \\\"Service name\\\"));\\n        if (service == null) {\\n            throw new IllegalStateException(\\\"Configure the named service before executing a step: \\\" + name);\\n        }\\n        return service;\\n    }\\n}\\n\", \"content_hash\": \"bdba80eb19b1472b584f9e327d0e51c64249bc354b6f84f97ab3828e3e026bff\"}, {\"identity\": \"com.ibm.dse.base.Context\", \"content\": \"package com.ibm.dse.base;\\n\\nimport java.sql.Connection;\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\n/** Demo operation context containing named values and an externally supplied JDBC connection. */\\npublic class Context {\\n    private final Map<String, Object> values = new HashMap<>();\\n    private Connection connection;\\n\\n    public Object getValueAt(String name) {\\n        return values.get(Objects.requireNonNull(name, \\\"Context field name\\\"));\\n    }\\n\\n    public void setValueAt(String name, Object value) {\\n        values.put(Objects.requireNonNull(name, \\\"Context field name\\\"), value);\\n    }\\n\\n    /** The caller owns the connection and its transaction lifecycle. */\\n    public void setConnection(Connection connection) {\\n        this.connection = Objects.requireNonNull(connection, \\\"JDBC connection\\\");\\n    }\\n\\n    public Connection getConnection() {\\n        if (connection == null) {\\n            throw new IllegalStateException(\\\"Configure a JDBC connection before executing a database step\\\");\\n        }\\n        return connection;\\n    }\\n}\\n\", \"content_hash\": \"2ecbe34eb7f561dab6bdbe5d9949b56e652f33c8a8e792994fdba33114cacf71\"}, {\"identity\": \"com.ibm.il.dse.cc.cut.CCComplexOpStep\", \"content\": \"package com.ibm.il.dse.cc.cut;\\n\\nimport com.ibm.dse.base.CCOperationStep;\\n\\n/** Demo nested-operation dispatch sharing the caller's context and return code. */\\npublic class CCComplexOpStep extends CCOperationStep {\\n    private String opExecuteName;\\n\\n    public void setOpExecuteName(String opExecuteName) {\\n        this.opExecuteName = opExecuteName;\\n    }\\n\\n    /** Register the target operation executor with setService using its operation name. */\\n    @Override\\n    public int execute() throws Exception {\\n        if (opExecuteName == null || opExecuteName.isBlank()) {\\n            throw new IllegalStateException(\\\"Configure opExecuteName before dispatch\\\");\\n        }\\n        CCOperationStep target = (CCOperationStep) getService(opExecuteName);\\n        target.setContext(getContext());\\n        return target.execute();\\n    }\\n}\\n\", \"content_hash\": \"1950e5fc713b62993c02033c3436f49e8eed764b6b243f801640baaa0c17e7ca\"}], \"consumers\": [\"INTERNET/GetClientOverviewOp\"], \"external_dependencies\": [], \"referenced_definitions\": [], \"operation_calls\": [{\"callee\": \"INTERNET/ValidateClientLinksOp\", \"caller\": \"INTERNET/GetClientOverviewOp\", \"evidence_hash\": \"308968b743be37657b7d1146a5c7a88662857d46d13d1c0e94062dfd53d521b6\", \"note\": \"opsteps\\\\OverviewValidateLinks.md\", \"parameters\": {\"opExecuteName\": \"ValidateClientLinksOp\"}, \"step\": \"OverviewValidateLinks\", \"transitions\": {\"on0Do\": \"OverviewRefreshLinks\", \"onOtherDo\": \"end\"}, \"service_contract\": {\"base_url_property\": \"operations.1ddd76166b6f.base-url\", \"call_evidence\": [{\"callee\": \"INTERNET/GetClientLinksOp\", \"caller\": \"INTERNET/ValidateClientLinksOp\", \"evidence_hash\": \"9fa02bfacf511806fb9cb54cf4349959174eff97a45909101bfae20af276cc1d\", \"note\": \"opsteps\\\\ValidateClientLinksFetch.md\", \"parameters\": {\"opExecuteName\": \"GetClientLinksOp\"}, \"step\": \"ValidateClientLinksFetch\", \"transitions\": {\"on0Do\": \"end\", \"onOtherDo\": \"end\"}}], \"error_policy\": \"Preserve target error XML and map evidenced return outcomes; report unknown mappings.\", \"formats\": {\"csErrorReplyFormat\": {\"markdown\": \"# StandardErrorRSFmt\\n\\n---\\nentity_type: format\\nentity_id: StandardErrorRSFmt\\nconversion_status: not_started\\nshared: true\\nused_by_operations:\\n  - GetAccountDetailsOp\\n  - GetClientAccountsOp\\n  - GetClientLinksOp\\n  - GetClientOverviewOp\\n  - TransferFundsOp\\n  - ValidateClientLinksOp\\nsource_file: C:\\\\GitHub\\\\shaybc\\\\snapir\\\\bank-demo\\\\composer\\\\Workspace\\\\WSBCC_XML\\\\src\\\\Xml Definition\\\\Channel\\\\XML\\\\defaultFile\\\\dseformat.xml\\nsource_hash: c1896648708bc8b2fcef4dfea7b956580922d