{"parts":[{"text":"{\"unit_id\": \"configured_step-3643d2141e0adb1bddc660d7\", \"kind\": \"configured_step\", \"logical_id\": \"NoLinksFound\", \"configuration_xml\": \"<opStep id=\\\"NoLinksFound\\\" implClass=\\\"com.ibm.il.dse.operations.common.MapErrorByValueAlways\\\" ErrorCategory=\\\"20\\\" ErrorNumber=\\\"1\\\" on0Return=\\\"ErrorBody\\\" onOtherDo=\\\"end\\\" />\\n\\n    \", \"sources\": [{\"identity\": \"com.ibm.dse.base.CCOperationStep\", \"content\": \"package com.ibm.dse.base;\\n\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\n/** Demo step contract with a shared operation context and explicitly registered services. */\\npublic abstract class CCOperationStep {\\n    private Context context;\\n    private final Map<String, Object> services = new HashMap<>();\\n\\n    public abstract int execute() throws Exception;\\n\\n    public void setContext(Context context) {\\n        this.context = Objects.requireNonNull(context, \\\"Operation context\\\");\\n    }\\n\\n    public Context getContext() {\\n        if (context == null) {\\n            throw new IllegalStateException(\\\"Configure an operation context before executing a step\\\");\\n        }\\n        return context;\\n    }\\n\\n    public void setService(String name, Object service) {\\n        services.put(Objects.requireNonNull(name, \\\"Service name\\\"), Objects.requireNonNull(service, \\\"Service\\\"));\\n    }\\n\\n    public Object getService(String name) {\\n        Object service = services.get(Objects.requireNonNull(name, \\\"Service name\\\"));\\n        if (service == null) {\\n            throw new IllegalStateException(\\\"Configure the named service before executing a step: \\\" + name);\\n        }\\n        return service;\\n    }\\n}\\n\", \"content_hash\": \"bdba80eb19b1472b584f9e327d0e51c64249bc354b6f84f97ab3828e3e026bff\"}, {\"identity\": \"com.ibm.dse.base.Context\", \"content\": \"package com.ibm.dse.base;\\n\\nimport java.sql.Connection;\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\n/** Demo operation context containing named values and an externally supplied JDBC connection. */\\npublic class Context {\\n    private final Map<String, Object> values = new HashMap<>();\\n    private Connection connection;\\n\\n    public Object getValueAt(String name) {\\n        return values.get(Objects.requireNonNull(name, \\\"Context field name\\\"));\\n    }\\n\\n    public void setValueAt(String name, Object value) {\\n        values.put(Objects.requireNonNull(name, \\\"Context field name\\\"), value);\\n    }\\n\\n    /** The caller owns the connection and its transaction lifecycle. */\\n    public void setConnection(Connection connection) {\\n        this.connection = Objects.requireNonNull(connection, \\\"JDBC connection\\\");\\n    }\\n\\n    public Connection getConnection() {\\n        if (connection == null) {\\n            throw new IllegalStateException(\\\"Configure a JDBC connection before executing a database step\\\");\\n        }\\n        return connection;\\n    }\\n}\\n\", \"content_hash\": \"2ecbe34eb7f561dab6bdbe5d9949b56e652f33c8a8e792994fdba33114cacf71\"}, {\"identity\": \"com.ibm.il.dse.operations.common.MapErrorByValueAlways\", \"content\": \"package com.ibm.il.dse.operations.common;\\n\\nimport com.ibm.dse.base.CCOperationStep;\\nimport com.ibm.dse.base.Context;\\n\\n/**\\n * Shared utility opStep. Sets ErrorCategory and ErrorNumber in context.\\n * Used by virtually every operation for error handling.\\n *\\n * XML attributes (passed via setter methods):\\n *   ErrorCategory - string category code (e.g. \\\"10\\\", \\\"99\\\")\\n *   ErrorNumber   - string error number within category (e.g. \\\"0\\\", \\\"4\\\")\\n *\\n * Returns:\\n *   0 - always (mapping always succeeds)\\n */\\npublic class MapErrorByValueAlways extends CCOperationStep {\\n\\n    private String errorCategory = \\\"99\\\";\\n    private String errorNumber   = \\\"0\\\";\\n\\n    public void setErrorCategory(String errorCategory) {\\n        this.errorCategory = errorCategory;\\n    }\\n\\n    public void setErrorNumber(String errorNumber) {\\n        this.errorNumber = errorNumber;\\n    }\\n\\n    @Override\\n    public int execute() throws Exception {\\n        Context ctx = getContext();\\n        ctx.setValueAt(\\\"ErrorCategory\\\",   errorCategory);\\n        ctx.setValueAt(\\\"ErrorNumber\\\",     errorNumber);\\n        ctx.setValueAt(\\\"ErrorDescription\\\", resolveErrorDescription(errorCategory, errorNumber));\\n        return 0;\\n    }\\n\\n    private String resolveErrorDescription(String category, String number) {\\n        // Lookup from error message catalog (simplified for demo)\\n        String key = category + \\\"_\\\" + number;\\n        switch (key) {\\n            case \\\"10_2\\\": return \\\"Validation failed: required field missing or invalid\\\";\\n            case \\\"20_1\\\": return \\\"No data found for the provided criteria\\\";\\n            case \\\"20_4\\\": return \\\"Account not found\\\";\\n            case \\\"30_5\\\": return \\\"Access denied: insufficient permissions\\\";\\n            case \\\"40_3\\\": return \\\"Daily transfer limit exceeded\\\";\\n            case \\\"40_4\\\": return \\\"Insufficient funds\\\";\\n            case \\\"40_5\\\": return \\\"Account not eligible for this operation\\\";\\n            case \\\"50_2\\\": return \\\"Transfer blocked: fraud risk detected\\\";\\n            case \\\"60_6\\\": return \\\"Core banking system rejected the request\\\";\\n            case \\\"60_7\\\": return \\\"Transfer already processed\\\";\\n            case \\\"99_0\\\": return \\\"Technical error: unexpected system failure\\\";\\n            case \\\"99_8\\\": return \\\"Technical error: database connection failure\\\";\\n            default:     return \\\"System error (category=\\\" + category + \\\", number=\\\" + number + \\\")\\\";\\n        }\\n    }\\n}\\n\", \"content_hash\": \"728019a09f6eaca78ce390b7464dc3b102fb895c35486189fc8b5fd6ff340aad\"}], \"consumers\": [\"INTERNET/GetClientAccountsOp\", \"INTERNET/GetClientLinksOp\", \"IVR/GetClientAccountsOp\"], \"external_dependencies\": [], \"referenced_definitions\": [], \"fingerprint\": \"3643d2141e0adb1bddc660d7cd996fb892f5480e097d39ba326416f3328ff0ba\", \"schema_version\": \"v1\", \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-3643d2141e0adb1bddc660d7\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.common.MapErrorByValueAlways\"], \"converted_dependency_apis\": [{\"unit_id\": \"configured_step-3a42c4326e3d7f21467b61b2\", \"planned_apis\": [{\"type_name\": \"com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\", \"public java.lang.String getErrorCategory()\", \"public java.lang.String getErrorNumber()\"]}, {\"type_name\": \"com.company.generated.units.u3a42c4326e3d.OperationContext\", \"method_signatures\": [\"public java.lang.Object getValueAt(java.lang.String)\", \"public void setValueAt(java.lang.String, java.lang.Object)\", \"public void setConnection(java.sql.Connection)\", \"public java.sql.Connection getConnection()\"]}], \"verified_api_surface\": {\"src/main/java/com/company/generated/units/u3a42c4326e3d/OperationContext.java\": {\"imports\": [\"import java.sql.Connection;\", \"import java.util.HashMap;\", \"import java.util.Map;\", \"import java.util.Objects;\"], \"public_declarations\": [\"public class OperationContext\", \"public Object getValueAt(String name)\", \"public void setValueAt(String name, Object value)\", \"public void setConnection(Connection connection)\", \"public Connection getConnection()\"]}, \"src/main/java/com/company/generated/units/u3a42c4326e3d/DatabaseErrorStep.java\": {\"imports\": [\"import java.util.Objects;\"], \"public_declarations\": [\"public class DatabaseErrorStep\", \"public DatabaseErrorStep()\", \"public DatabaseErrorStep(String errorCategory, String errorNumber)\", \"public int execute(OperationContext context)\", \"public String getErrorCategory()\", \"public String getErrorNumber()\"]}}, \"input_type\": \"com.company.generated.units.u3a42c4326e3d.OperationContext\", \"output_type\": \"java.lang.Integer\", \"wire_type\": null}, {\"unit_id\": \"configured_step-9d214a54d7b141366dcd456c\", \"planned_apis\": [{\"type_name\": \"com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\", \"public java.lang.String getErrorCategory()\", \"public java.lang.String getErrorNumber()\"]}], \"verified_api_surface\": {\"src/main/java/com/company/generated/units/u9d214a54d7b1/TechnicalErrorStep.java\": {\"imports\": [\"import com.company.generated.units.u3a42c4326e3d.OperationContext;\", \"import java.util.Objects;\"], \"public_declarations\": [\"public class TechnicalErrorStep\", \"public TechnicalErrorStep()\", \"public TechnicalErrorStep(String errorCategory, String errorNumber)\", \"public int execute(OperationContext context)\", \"public String getErrorCategory()\", \"public String getErrorNumber()\"]}}, \"input_type\": \"com.company.generated.units.u3a42c4326e3d.OperationContext\", \"output_type\": \"java.lang.Integer\", \"wire_type\": null}], \"java_version\": 25, \"native_package\": \"com.company.generated.units.u3643d2141e0a\", \"artifact_owner\": null, \"artifact_targets\": {\"INTERNET/GetClientLinksOp\": \"C:\\\\GitHub\\\\shaybc\\\\snapir\\\\work\\\\migration_runs\\\\bank-operation-calls-e2e-20261019\\\\generated\\\\INTERNET\\\\GetClientLinksOp\"}, \"managed_dependencies\": [{\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-33e19da28f26\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for this run\", \"required_classes\": []}, {\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-33e19da28f26\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for this run\", \"required_classes\": []}], \"known_dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"com.fasterxml.jackson.dataformat\", \"artifact_id\": \"jackson-dataformat-xml\", \"version\": \"2.17.2\", \"scope\": \"compile\", \"reason\": \"Current target POM dependency\", \"required_classes\": []}, {\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-33e19da28f26\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for this run\", \"required_classes\": []}], \"testing_contract\": {\"requirement\": {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}, \"java_version\": 25, \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"rules\": [\"Keep each test focused on one evidenced outcome or side effect.\", \"Cover meaningful behavior across the bundle, not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\npublic class AdapterContractTest {\\n    @Test void adapterPassesTheIdentifierToItsDependency() throws Exception {\\n        Connection connection = mock(Connection.class);\\n        CallableStatement statement = mock(CallableStatement.class);\\n        when(connection.prepareCall(\\\"{call sample(?)}\\\")).thenReturn(statement);\\n        when(statement.getString(1)).thenReturn(\\\"sample-result\\\");\\n        try (CallableStatement call = connection.prepareCall(\\\"{call sample(?)}\\\")) {\\n            call.setString(1, \\\"sample-id\\\");\\n            call.execute();\\n            assertEquals(\\\"sample-result\\\", call.getString(1));\\n        }\\n        verify(statement).setString(1, \\\"sample-id\\\");\\n        verify(statement).execute();\\n        verify(statement).close();\\n    }\\n}\\n\"}, {\"path\": \"BusinessBehaviorTest.java\", \"content\": \"package example;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Reference structure only: derive real expected values from migration evidence. */\\npublic class BusinessBehaviorTest {\\n    interface NotificationPort { void send(String reference); }\\n    static class CompletionService {\\n        private final NotificationPort notifications;\\n        CompletionService(NotificationPort notifications) { this.notifications = notifications; }\\n        String complete(String reference) { notifications.send(reference); return reference; }\\n    }\\n\\n    @Test void returnsTheCompletedReference() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        CompletionService service = new CompletionService(notifications);\\n        assertEquals(\\\"sample-reference\\\", service.complete(\\\"sample-reference\\\"));\\n    }\\n\\n    @Test void notifiesTheCollaboratorOnce() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        new CompletionService(notifications).complete(\\\"sample-reference\\\");\\n        verify(notifications).send(\\\"sample-reference\\\");\\n        verifyNoMoreInteractions(notifications);\\n    }\\n}\\n\"}]}, \"final_validation_feedback\": null, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\", \"versioned_requirements\": [{\"requirement_id\": \"business\", \"version\": 1, \"description\": \"Preserve this complete configured unit's evidenced behavior\"}, {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}], \"schema\": {\"$defs\": {\"MavenDependency\": {\"additionalProperties\": false, \"description\": \"Identify a pinned Maven artifact and the APIs that justify its inclusion.\", \"properties\": {\"group_id\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Group Id\", \"type\": \"string\"}, \"artifact_id\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Artifact Id\", \"type\": \"string\"}, \"version\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Version\", \"type\": \"string\"}, \"scope\": {\"default\": \"compile\", \"enum\": [\"compile\", \"runtime\", \"provided\", \"test\"], \"title\": \"Scope\", \"type\": \"string\"}, \"reason\": {\"minLeng