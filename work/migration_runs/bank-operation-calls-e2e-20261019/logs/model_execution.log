tring xml) throws Exception {\\n        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\\n        factory.setNamespaceAware(true);\\n        return factory.newDocumentBuilder().parse(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))).getDocumentElement();\\n    }\\n\\n    @Test\\n    public void verifiesXmlStructureAndNamespaces() throws Exception {\\n        StandardErrorRSFmtMapper.ErrorReply reply = new StandardErrorRSFmtMapper.ErrorReply(\\\"CAT\\\", \\\"999\\\", \\\"Desc\\\", null);\\n        String xml = mapper.format(reply);\\n        Element root = parseXml(xml);\\n\\n        assertEquals(\\\"ErrorReply\\\", root.getTagName());\\n        assertFalse(xml.startsWith(\\\"<?xml\\\"));\\n\\n        Element reqIdElem = (Element) root.getElementsByTagName(\\\"RequestId\\\").item(0);\\n        assertNotNull(reqIdElem);\\n        assertEquals(\\\"true\\\", reqIdElem.getAttributeNS(XSI, \\\"nil\\\"));\\n    }\\n}\\n\"}], \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"JUnit Jupiter tests and execution engine\", \"required_classes\": [\"org.junit.jupiter.api.Test\", \"org.junit.jupiter.api.Assertions\"]}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Mockito for mocking\", \"required_classes\": []}, {\"group_id\": \"com.fasterxml.jackson.dataformat\", \"artifact_id\": \"jackson-dataformat-xml\", \"version\": \"2.15.2\", \"scope\": \"compile\", \"reason\": \"Jackson XML serialization and deserialization\", \"required_classes\": [\"com.fasterxml.jackson.dataformat.xml.XmlMapper\", \"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty\", \"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement\", \"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlText\", \"com.fasterxml.jackson.dataformat.xml.ser.ToXmlGenerator\"]}]