     validateClientLinksFetch.setContext(context);\\\\n        \\\\n        int rc = validateClientLinksFetch.execute();\\\\n        \\\\n        // Routing rules for ValidateClientLinksFetch: on0Do -> end, onOtherDo -> end\\\\n        // Both outcomes lead to 'end', which returns the reply format.\\\\n        // If an error reply format was substituted or if standard reply is used, fetch step handles serialization or context state.\\\\n        Object responseObj = context.getValueAt(\\\\\\\"GetClientLinksResponse\\\\\\\");\\\\n        if (responseObj instanceof GetClientLinksRSFmtMapper.GetClientLinksResponse resp) {\\\\n            GetClientLinksRSFmtMapper mapper = new GetClientLinksRSFmtMapper();\\\\n            return mapper.format(resp);\\\\n        }\\\\n\\\\n        Object errorObj = context.getValueAt(\\\\\\\"ErrorReply\\\\\\\");\\\\n        if (errorObj instanceof StandardErrorRSFmtMapper.ErrorReply err) {\\\\n            StandardErrorRSFmtMapper errorMapper = new StandardErrorRSFmtMapper();\\\\n            return errorMapper.format(err);\\\\n        }\\\\n\\\\n        return requestXml;\\\\n    }\\\\n}\\\\n\\\"\\n    }\\n  ],\\n  \\\"dependencies\\\": [\\n    {\\n      \\\"group_id\\\": \\\"com.fasterxml.jackson.dataformat\\\",\\n      \\\"artifact_id\\\": \\\"jackson-dataformat-xml\\\",\\n      \\\"version\\\": \\\"2.17.2\\\",\\n      \\\"scope\\\": \\\"compile\\\",\\n      \\\"reason\\\": \\\"XML binding and serialization support\\\",\\n      \\\"required_classes\\\": [\\n        \\\"com.fasterxml.jackson.dataformat.xml.XmlMapper\\\"\\n      ]\\n    },\\n    {\\n      \\\"group_id\\\": \\\"com.company.migration\\\",\\n      \\\"artifact_id\\\": \\\"shared-26209c8451ff\\\",\\n      \\\"version\\\": \\\"1.0.0-4d092659baf5\\\",\\n      \\\"scope\\\": \\\"compile\\\",\\n      \\\"reason\\\": \\\"Accepted native behavior library for shared error formats\\\",\\n      \\\"required_classes\\\": [\\n        \\\"com.company.generated.units.u66bf2c108225.StandardE