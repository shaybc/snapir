"files\": [{\"path\": \"src/main/java/com/company/generated/operations/GetClientLinksOpService.java\", \"content\": \"package com.company.generated.operations;\\n\\nimport com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep;\\nimport com.company.generated.units.u3a42c4326e3d.OperationContext;\\nimport com.company.generated.units.u3643d2141e0a.NoLinksFoundStep;\\nimport com.company.generated.units.u42b95631a186.GetClientLinksStep;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\\nimport com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep;\\n\\nimport javax.sql.DataSource;\\nimport java.sql.Connection;\\nimport java.util.List;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\npublic class GetClientLinksOpService {\\n\\n    private final GetClientLinksStep getClientLinksStep;\\n    private final NoLinksFoundStep noLinksFoundStep;\\n    private final DatabaseErrorStep databaseErrorStep;\\n    private final TechnicalErrorStep technicalError;\\n    private final DataSource dataSource;\\n\\n    private final GetClientLinksRequestUnformatMapper requestUnformatMapper;\\n    private final GetClientLinksRSFmtMapper replyFormatMapper;\\n    private final StandardErrorRSFmtMapper errorReplyFormatMapper;\\n\\n    public GetClientLinksOpService(\\n            GetClientLinksStep getClientLinksStep,\\n            NoLinksFoundStep noLinksFoundStep,\\n            DatabaseErrorStep databaseErrorStep,\\n            TechnicalErrorStep technicalError,\\n            DataSource dataSource) {\\n        this.getClientLinksStep = Objects.requireNonNull(getClientLinksStep);\\n        this.noLinksFoundStep = Objects.requireNonNull(noLinksFoundStep);\\n        this.databaseErrorStep = Objects.requireNonNull(databaseErrorStep);\\n        this.technicalError = Objects.requireNonNull(technicalError);\\n        this.dataSource = Objects.requireNonNull(dataSource);\\n\\n        this.requestUnformatMapper = new GetClientLinksRequestUnformatMapper();\\n        this.replyFormatMapper = new GetClientLinksRSFmtMapper();\\n        this.errorReplyFormatMapper = new StandardErrorRSFmtMapper();\\n    }\\n\\n    public String execute(GetClientLinksRequestXml requestXml) throws Exception {\\n        GetClientLinksRequest request = requestUnformatMapper.toBusinessInput(requestXml);\\n        OperationContext context = new OperationContext();\\n        context.setValueAt(\\\"ClientId\\\", request.getClientId());\\n        context.setValueAt(\\\"BankId\\\", request.getBankId());\\n        context.setValueAt(\\\"HOST_HEADER.HOST_KEY\\\", \\\"GCLN\\\");\\n\\n        int rc;\\n        try (Connection connection = dataSource.getConnection()) {\\n            context.setConnection(connection);\\n            rc = getClientLinksStep.execute(context);\\n        }\\n\\n        if (rc == 0) {\\n            String clientId = (String) context.getValueAt(\\\"ClientId\\\");\\n            List<Object> rawLinks = (List<Object>) context.getValueAt(\\\"Links\\\");\\n            List<GetClientLinksRSFmtMapper.LinkDto> linkDtos = new java.util.ArrayList<>();\\n\\n            if (rawLinks != null) {\\n                for (Object rawLink : rawLinks) {\\n                    if (rawLink instanceof Map) {\\n                        Map<?, ?> map = (Map<?, ?>) rawLink;\\n                        String linkId = (String) map.get(\\\"LinkId\\\");\\n                        String linkDescription = (String) map.get(\\\"LinkDescription\\\");\\n                        String linkUrl = (String) map.get(\\\"LinkUrl\\\");\\n                        Boolean isExternal = (Boolean) map.get(\\\"IsExternal\\\");\\n                        String iconCode = (String) map.get(\\\"IconCode\\\");\\n                        linkDtos.add(new GetClientLinksRSFmtMapper.LinkDto(linkId, linkDescription, linkUrl, isExternal, iconCode));\\n                    }\\n                }\\n            }\\n\\n            GetClientLinksRSFmtMapper.GetClientLinksResponse response = \\n                new GetClientLinksRSFmtMapper.GetClientLinksResponse(clientId, linkDtos);\\n            return replyFormatMapper.format(response);\\n        } else {\\n            String errorCategory;\\n            String errorNumber;\\n            String errorDescription;\\n\\n            if (rc == 4) {\\n                noLinksFoundStep.execute(context);\\n                errorCategory = noLinksFoundStep.getErrorCategory();\\n                errorNumber = noLinksFoundStep.getErrorNumber();\\n            } else if (rc == 8) {\\n                databaseErrorStep.execute(context);\\n                errorCategory = databaseErrorStep.getErrorCategory();\\n                errorNumber = databaseErrorStep.getErrorNumber();\\n            } else {\\n                technicalError.execute(context);\\n                errorCategory = technicalError.getErrorCategory();\\n                errorNumber = technicalError.getErrorNumber();\\n            }\\n\\n            errorDescription = (String) context.getValueAt(\\\"ErrorDescription\\\");\\n            String requestId = (String) context.getValueAt(\\\"RequestId\\\");\\n\\n            StandardErrorRSFmtMapper.ErrorReply errorReply = \\n                new StandardErrorRSFmtMapper.ErrorReply(errorCategory, errorNumber, errorDescription, requestId);\\n            return errorReplyFormatMapper.format(errorReply);\\n        }\\n    }\\n}\\n\"}, {\"path\": \"src/test/java/com/company/generated/operations/routing/Routef51512412cadTest.java\", \"content\": \"package com.company.generated.operations.routing;\\n\\nimport com.company.generated.operations.GetClientLinksOpService;\\nimport com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep;\\nimport com.company.generated.units.u3a42c4326e3d.OperationContext;\\nimport com.company.generated.units.u3643d2141e0a.NoLinksFoundStep;\\nimport com.company.generated.units.u42b95631a186.GetClientLinksStep;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep;\\n\\nimport org.junit.jupiter.api.Test;\\n\\nimport javax.sql.DataSource;\\nimport java.sql.Connection;\\nimport java.util.ArrayList;\\nimport java.util.HashMap;\\nimport java.util.List;\\nimport java.util.Map;\\n\\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\\nimport static org.junit.jupiter.api.Assertions.assertTrue;\\nimport static org.mockito.ArgumentMatchers.any;\\nimport static org.mockito.Mockito.mock;\\nimport static org.mockito.Mockito.verify;\\nimport static org.mockito.Mockito.when;\\n\\npublic class Routef51512412cadTest {\\n\\n    @Test\\n    void testGetClientLinksSuccessRoute() throws Exception {\\n        GetClientLinksStep getClientLinksStep = mock(GetClientLinksStep.class);\\n        NoLinksFoundStep noLinksFoundStep = mock(NoLinksFoundStep.class);\\n        DatabaseErrorStep databaseErrorStep = mock(DatabaseErrorStep.class);\\n        TechnicalErrorStep technicalErrorStep = mock(TechnicalErrorStep.class);\\n        DataSource dataSource = mock(DataSource.class);\\n        Connection connection = mock(Connection.class);\\n\\n        when(dataSource.getConnection()).thenReturn(connection);\\n\\n        when(getClientLinksStep.execute(any(OperationContext.class))).thenAnswer(invocation -> {\\n            OperationContext ctx = invocation.getArgument(0);\\n            ctx.setValueAt(\\\"ClientId\\\", \\\"C123\\\");\\n            List<Object> links = new ArrayList<>();\\n            Map<String, Object> link = new HashMap<>();\\n            link.put(\\\"LinkId\\\", \\\"L1\\\");\\n            link.put(\\\"LinkDescription\\\", \\\"Home Page\\\");\\n            link.put(\\\"LinkUrl\\\", \\\"https://bank.com\\\");\\n            link.put(\\\"IsExternal\\\", Boolean.FALSE);\\n            link.put(\\\"IconCode\\\", \\\"HOME\\\");\\n            links.add(link);\\n            ctx.setValueAt(\\\"Links\\\", links);\\n            return 0;\\n        });\\n\\n        GetClientLinksOpService service = new GetClientLinksOpService(\\n                getClientLinksStep,\\n                noLinksFoundStep,\\n                databaseErrorStep,\\n                technicalErrorStep,\\n                dataSource\\n        );\\n\\n        GetClientLinksRequestXml requestXml = new GetClientLinksRequestXml();\\n        requestXml.clientId = \\\"C123\\\";\\n        requestXml.bankId = \\\"B1\\\";\\n\\n        String result = service.execute(requestXml);\\n\\n        assertNotNull(result);\\n        assertTrue(result.contains(\\\"C123\\\"));\\n        assertTrue(result.contains(\\\"L1\\\"));\\n        assertTrue(result.contains(\\\"Home Page\\\"));\\n\\n        verify(getClientLinksStep).execute(any(OperationContext.class));\\n        verify(dataSource).getConnection();\\n        verify(connection).close();\\n    }\\n}\\n\"}, {\"path\": \"src/test/java/com/company/generated/operations/routing/Routeb87df916f080Test.java\", \"content\": \"package com.company.generated.operations.routing;\\n\\nimport com.company.generated.operations.GetClientLinksOpService;\\nimport com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep;\\nimport com.company.generated.units.u3a42c4326e3d.OperationContext;\\nimport com.company.generated.units.u3643d2141e0a.NoLinksFoundStep;\\nimport com.company.generated.units.u42b95631a186.GetClientLinksStep;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep;\\nimport org.junit.jupiter.api.Test;\\n\\nimport javax.sql.DataSource;\\nimport java.sql.Connection;\\n\\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\\nimport static org.junit.jupiter.api.Assertions.assertTrue;\\nimport static org.mockito.ArgumentMatchers.any;\\nimport static org.mockito.Mockito.*;\\n\\npublic class Routeb87df916f080Test {\\n\\n    @Test\\n    public void testGetClientLinksNoLinksFoundRouting() throws Exception {\\n        GetClientLinksStep getClientLinksStep = mock(GetClientLinksStep.class);\\n        NoLinksFoundStep noLinksFoundStep = mock(NoLinksFoundStep.class);\\n        DatabaseErrorStep databaseErrorStep = mock(DatabaseErrorStep.class);\\n        TechnicalErrorStep technicalErrorStep = mock(TechnicalErrorStep.class);\\n        DataSource dataSource = mock(DataSource.class);\\n        Connection connection = mock(Connection.class);\\n\\n        when(dataSource.getConnection()).thenReturn(connection);\\n        when(getClientLinksStep.execute(any(OperationContext.class))).thenReturn(4);\\n        when(noLinksFoundStep.getErrorCategory()).thenReturn(\\\"BUSINESS\\\");\\n        when(noLinksFoundStep.getErrorNumber()).thenReturn(\\\"404\\\");\\n\\n        GetClientLinksOpService service = new GetClientLinksOpService(\\n                getClientLinksStep,\\n                noLinksFoundStep,\\n                databaseErrorStep,\\n                technicalErrorStep,\\n                dataSource\\n        );\\n\\n        GetClientLinksRequestXml requestXml = new GetClientLinksRequestXml();\\n        requestXml.clientId = \\\"C12345\\\";\\n        requestXml.bankId = \\\"1\\\";\\n\\n        String result = service.execute(requestXml);\\n\\n        assertNotNull(result);\\n        assertTrue(result.contains(\\\"404\\\") || result.contains(\\\"BUSINESS\\\"));\\n\\n        verify(getClientLinksStep).execute(any(OperationContext.class));\\n        verify(noLinksFoundStep).execute(any(OperationContext.class));\\n        verify(noLinksFoundStep).getErrorCategory();\\n        verify(noLinksFoundStep).getErrorNumber();\\n        verifyNoInteractions(databaseErrorStep);\\n        verifyNoInteractions(technicalErrorStep);\\n    }\\n}\\n\"}, {\"path\": \"src/test/java/com/company/generated/operations/routing/Route499b0c464ae0Test.java\", \"content\": \"package com.company.generated.operations.routing;\\n\\nimport com.company.generated.operations.GetClientLinksOpService;\\nimport com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep;\\nimport com.company.generated.units.u3643d2141e0a.NoLinksFoundStep;\\nimport com.company.generated.units.u42b95631a186.GetClientLinksStep;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep;\\nimport org.junit.jupiter.api.Test;\\n\\nimport javax.sql.DataSource;\\nimport java.sql.Connection;\\n\\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\\nimport static org.mockito.ArgumentMatchers.any;\\nimport static org.mockito.Mockito.*;\\n\\npublic class Route499b0c464ae0Test {\\n\\n    @Test\\n    void testGetClientLinksDatabaseErrorRoute() throws Exception {\\n        GetClientLinksStep getClientLinksStep = mock(GetClientLinksStep.class);\\n        NoLinksFoundStep noLinksFoundStep = mock(NoLinksFoundStep.class);\\n        DatabaseErrorStep databaseErrorStep = mock(DatabaseErrorStep.class);\\n        TechnicalErrorStep technicalErrorStep = mock(TechnicalErrorStep.class);\\n        DataSource dataSource = mock(DataSource.class);\\n        Connection connection = mock(Connection.class);\\n\\n        when(dataSource.getConnection()).thenReturn(connection);\\n        when(getClientLinksStep.execute(any())).thenReturn(8);\\n        when(databaseErrorStep.getErrorCategory()).thenReturn(\\\"DB_ERROR_CAT\\\");\\n        when(databaseErrorStep.getErrorNumber()).thenReturn(\\\"8000\\\");\\n\\n        GetClientLinksOpService service = new GetClientLinksOpService(\\n                getClientLinksStep,\\n                noLinksFoundStep,\\n                databaseErrorStep,\\n                technicalErrorStep,\\n                dataSource\\n        );\\n\\n        GetClientLinksRequestXml requestXml = new GetClientLinksRequestXml();\\n        requestXml.clientId = \\\"client-123\\\";\\n        requestXml.bankId = \\\"bank-1\\\";\\n\\n        String result = service.execute(requestXml);\\n\\n        assertNotNull(result);\\n        verify(getClientLinksStep).execute(any());\\n        verify(databaseErrorStep).execute(any());\\n        verifyNoInteractions(noLinksFoundStep);\\n        verifyNoInteractions(technicalErrorStep);\\n        verify(connection).close();\\n    }\\n}\\n\"}, {\"path\": \"src/test/java/com/company/generated/operations/routing/Routedae09ff86bacTest.java\", \"content\": \"package com.company.generated.operations.routing;\\n\\nimport com.company.generated.operations.GetClientLinksOpService;\\nimport com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep;\\nimport com.company.generated.units.u3643d2141e0a.NoLinksFoundStep;\\nimport com.company.generated.units.u42b95631a186.GetClientLinksStep;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep;\\nimport org.junit.jupiter.api.Test;\\n\\nimport javax.sql.DataSource;\\nimport java.sql.Connection;\\n\\nimport static org.junit.jupiter.api.Assertions.assertNotNull;\\nimport static org.junit.jupiter.api.Assertions.assertTrue;\\nimport static org.mockito.Mockito.*;\\n\\npublic class Routedae09ff86bacTest {\\n\\n    @Test\\n    public void executesTechnicalErrorRouteWhenUnexpectedReturnCodeOccurs() throws Exception {\\n        GetClientLinksStep getClientLinksStep = mock(GetClientLinksStep.class);\\n        NoLinksFoundStep noLinksFoundStep = mock(NoLinksFoundStep.class);\\n        DatabaseErrorStep databaseErrorStep = mock(DatabaseErrorStep.class);\\n        TechnicalErrorStep technicalErrorStep = mock(TechnicalErrorStep.class);\\n        DataSource dataSource = mock(DataSource.class);\\n        Connection connection = mock(Connection.class);\\n\\n        when(dataSource.getConnection()).thenReturn(connection);\\n        when(getClientLinksStep.execute(any())).thenReturn(99); // unexpected return code triggering onOtherDo -> TechnicalError\\n        when(technicalErrorStep.getErrorCategory()).thenReturn(\\\"TECH\\\");\\n        when(technicalErrorStep.getErrorNumber()).thenReturn(\\\"500\\\");\\n\\n        GetClientLinksOpService service = new GetClientLinksOpService(\\n                getClientLinksStep,\\n                noLinksFoundStep,\\n                databaseErrorStep,\\n                technicalErrorStep,\\n                dataSource\\n        );\\n\\n        GetClientLinksRequestXml requestXml = new GetClientLinksRequestXml();\\n        requestXml.clientId = \\\"123456\\\";\\n        requestXml.bankId = \\\"01\\\";\\n\\n        String result = service.execute(requestXml);\\n\\n        assertNotNull(result);\\n        assertTrue(result.contains(\\\"TECH\\\"));\\n        assertTrue(result.contains(\\\"500\\\"));\\n\\n        verify(getClientLinksStep).execute(any());\\n        verify(technicalErrorStep).execute(any());\\n        verifyNoInteractions(noLinksFoundStep);\\n        verifyNoInteractions(databaseErrorStep);\\n        verify(connection).close();\\n    }\\n}\\n\"}], \"dependencies\": [{\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-33e19da28f26\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for DatabaseErrorStep, TechnicalErrorStep, and OperationContext\", \"required_classes\": [\"com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep\", \"com.company.generated.units.u3a42c4326e3d.OperationContext\", \"com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep\"]}, {\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-26209c8451ff\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for StandardErrorRSFmtMapper\", \"required_classes\": [\"com.compa