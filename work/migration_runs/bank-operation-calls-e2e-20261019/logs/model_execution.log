scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"com.fasterxml.jackson.dataformat\", \"artifact_id\": \"jackson-dataformat-xml\", \"version\": \"2.17.2\", \"scope\": \"compile\", \"reason\": \"Current target POM dependency\", \"required_classes\": []}, {\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-26209c8451ff\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for this run\", \"required_classes\": []}], \"testing_contract\": {\"requirement\": {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}, \"java_version\": 25, \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"rules\": [\"Keep each test focused on one evidenced outcome or side effect.\", \"Cover meaningful behavior across the bundle, not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\npublic class AdapterContractTest {\\n    @Test void adapterPassesTheIdentifierToItsDependency() throws Exception {\\n        Connection connection = mock(Connection.class);\\n        CallableStatement statement = mock(CallableStatement.class);\\n        when(connection.prepareCall(\\\"{call sample(?)}\\\")).thenReturn(statement);\\n        when(statement.getString(1)).thenReturn(\\\"sample-result\\\");\\n        try (CallableStatement call = connection.prepareCall(\\\"{call sample(?)}\\\")) {\\n            call.setString(1, \\\"sample-id\\\");\\n            call.execute();\\n            assertEquals(\\\"sample-result\\\", call.getString(1));\\n        }\\n        verify(statement).setString(1, \\\"sample-id\\\");\\n        verify(statement).execute();\\n        verify(statement).close();\\n    }\\n}\\n\"}, {\"path\": \"BusinessBehaviorTest.java\", \"content\": \"package example;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Reference structure only: derive real expected values from migration evidence. */\\npublic class BusinessBehaviorTest {\\n    interface NotificationPort { void send(String reference); }\\n    static class CompletionService {\\n        private final NotificationPort notifications;\\n        CompletionService(NotificationPort notifications) { this.notifications = notifications; }\\n        String complete(String reference) { notifications.send(reference); return reference; }\\n    }\\n\\n    @Test void returnsTheCompletedReference() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        CompletionService service = new CompletionService(notifications);\\n        assertEquals(\\\"sample-reference\\\", service.complete(\\\"sample-reference\\\"));\\n    }\\n\\n    @Test void notifiesTheCollaboratorOnce() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        new CompletionService(notifications).complete(\\\"sample-reference\\\");\\n        verify(notifications).send(\\\"sample-reference\\\");\\n        verifyNoMoreInteractions(notifications);\\n    }\\n}\\n\"}]}, \"final_validation_feedback\": null, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\"}, \"generated_bundle\": {\"files\": [{\"path\": \"src/main/java/com/company/generated/units/u83d87fed10bb/OverviewValidateLinksStep.java\", \"content\": \"package com.company.generated.units.u83d87fed10bb;\\n\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\\nimport com.fasterxml.jackson.dataformat.xml.XmlMapper;\\nimport java.net.URI;\\nimport java.net.http.HttpClient;\\nimport java.net.http.HttpRequest;\\nimport java.net.http.HttpResponse;\\nimport java.time.Duration;\\nimport java.util.Objects;\\n\\npublic class OverviewValidateLinksStep {\\n    private final String baseUrl;\\n    private final HttpClient httpClient;\\n    private final GetClientLinksRequestUnformatMapper requestMapper;\\n    private final GetClientLinksRSFmtMapper responseMapper;\\n    private final StandardErrorRSFmtMapper errorMapper;\\n    private final XmlMapper xmlMapper;\\n\\n    public OverviewValidateLinksStep(String baseUrl,\\n                                     HttpClient httpClient,\\n                                     GetClientLinksRequestUnformatMapper requestMapper,\\n                                     GetClientLinksRSFmtMapper responseMapper,\\n                                     StandardErrorRSFmtMapper errorMapper) {\\n        this.baseUrl = Objects.requireNonNull(baseUrl, \\\"baseUrl\\\");\\n        this.httpClient = Objects.requireNonNull(httpClient, \\\"httpClient\\\");\\n        this.requestMapper = Objects.requireNonNull(requestMapper, \\\"requestMapper\\\");\\n        this.responseMapper = Objects.requireNonNull(responseMapper, \\\"responseMapper\\\");\\n        this.errorMapper = Objects.requireNonNull(errorMapper, \\\"errorMapper\\\");\\n        this.xmlMapper = new XmlMapper();\\n    }\\n\\n    public int execute(String clientId, String bankId) throws Exception {\\n        GetClientLinksRequestXml requestXml = new GetClientLinksRequestXml();\\n        requestXml.clientId = clientId;\\n        requestXml.bankId = bankId;\\n\\n        GetClientLinksRequest businessInput = requestMapper.toBusinessInput(requestXml);\\n        if (businessInput.getClientId() == null || businessInput.getClientId().isBlank()) {\\n            return 1; // non-zero indicates other / error routing per onOtherDo=end or route\\n        }\\n\\n        String requestPayload = xmlMapper.writeValueAsString(requestXml);\\n\\n        String targetUrl = baseUrl.replaceAll(\\\"/$\\\", \\\"\\\") + \\\"/operations/INTERNET/ValidateClientLinksOp\\\";\\n        HttpRequest httpRequest = HttpRequest.newBuilder()\\n                .uri(URI.create(targetUrl))\\n                .timeout(Duration.ofSeconds(30))\\n                .header(\\\"Content-Type\\\", \\\"application/xml\\\")\\n                .header(\\\"Accept\\\", \\\"application/xml\\\")\\n                .POST(HttpRequest.BodyPublishers.ofString(requestPayload))\\n                .build();\\n\\n        HttpResponse<String> response;\\n        try {\\n            response = httpClient.send(httpRequest, HttpResponse.BodyHandlers.ofString());\\n        } catch (Exception e) {\\n            return 1; // timeout or transport failure routes to onOtherDo (end)\\n        }\\n\\n        int statusCode = response.statusCode();\\n        String responseBody = response.body();\\n\\n        if (statusCode >= 200 && statusCode < 300) {\\n            try {\\n                GetClientLinksRSFmtMapper.GetClientLinksResponse parsedResponse = responseMapper.unformat(responseBody);\\n                if (parsedResponse != null && parsedResponse.clientId() != null) {\\n                    return 0; // on0Do = OverviewRefreshLinks (represented by 0)\\n                }\\n            } catch (Exception e) {\\n                return 1;\\n            }\\n            return 1;\\n        } else {\\n            try {\\n                StandardErrorRSFmtMapper.ErrorReply errorReply = errorMapper.unformat(responseBody);\\n                if (errorReply != null) {\\n                    return 1;\\n                }\\n            } catch (Exception e) {\\n                return 1;\\n            }\\n            return 1;\\n        }\\n    }\\n}\"}, {\"path\": \"src/test/java/com/company/generated/units/u83d87fed10bb/OverviewValidateLinksStepBusinessTest.java\", \"content\": \"package com.company.generated.units.u83d87fed10bb;\\n\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\\nimport java.net.http.HttpClient;\\nimport java.net.http.HttpResponse;\\nimport java.util.List;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.ArgumentMatchers.any;\\nimport static org.mockito.Mockito.*;\\n\\npublic class OverviewValidateLinksStepBusinessTest {\\n\\n    @Test\\n    public void testValidClientLinksReturnsSuccessCodeZero() throws Exception {\\n        HttpClient httpClient = mock(HttpClient.class);\\n        HttpResponse<String> httpResponse = mock(HttpResponse.class);\\n        GetClientLinksRequestUnformatMapper requestMapper = mock(GetClientLinksRequestUnformatMapper.class);\\n        GetClientLinksRSFmtMapper responseMapper = mock(GetClientLinksRSFmtMapper.class);\\n        StandardErrorRSFmtMapper errorMapper = mock(StandardErrorRSFmtMapper.class);\\n\\n        GetClientLinksRequest businessReq = new GetClientLinksRequest(\\\"123456\\\", \\\"0012\\\");\\n        when(requestMapper.toBusinessInput(any(GetClientLinksRequestXml.class))).thenReturn(businessReq);\\n\\n        GetClientLinksRSFmtMapper.GetClientLinksResponse successResp =\\n                new GetClientLinksRSFmtMapper.GetClientLinksResponse(\\\"123456\\\", List.of());\\n        when(responseMapper.unformat(any(String.class))).thenReturn(successResp);\\n\\n        when(httpClient.<String>send(any(), any())).thenReturn(httpResponse);\\n        when(httpResponse.statusCode()).thenReturn(200);\\n        when(httpResponse.body()).thenReturn(\\\"<GetClientLinksResponse><ClientId>123456</ClientId></GetClientLinksResponse>\\\");\\n\\n        OverviewValidateLinksStep step = new OverviewValidateLinksStep(\\n                \\\"http://localhost:8080\\\", httpClient, requestMapper, responseMapper, errorMapper);\\n\\n        int rc = step.execute(\\\"123456\\\", \\\"0012\\\");\\n        assertEquals(0, rc);\\n        verify(httpClient).send(any(), any());\\n    }\\n\\n    @Test\\n    public void testBlankClientIdReturnsOtherCodeOne() throws Exception {\\n        HttpClient httpClient = mock(HttpClient.class);\\n        GetClientLinksRequestUnformatMapper requestMapper = mock(GetClientLinksRequestUnformatMapper.class);\\n        GetClientLinksRSFmtMapper responseMapper = mock(GetClientLinksRSFmtMapper.class);\\n        StandardErrorRSFmtMapper errorMapper = mock(StandardErrorRSFmtMapper.class);\\n\\n        GetClientLinksRequest businessReq = new GetClientLinksRequest(\\\"\\\", \\\"0012\\\");\\n        when(requestMapper.toBusinessInput(any(GetClientLinksRequestXml.class))).thenReturn(businessReq);\\n\\n        OverviewValidateLinksStep step = new OverviewValidateLinksStep(\\n                \\\"http://localhost:8080\\\", httpClient, requestMapper, responseMapper, errorMapper);\\n\\n        int rc = step.execute(\\\"\\\", \\\"0012\\\");\\n        assertEquals(1, rc);\\n        verifyNoInteractions(httpClient);\\n    }\\n}\"}, {\"path\": \"src/test/java/com/company/generated/units/u83d87fed10bb/OverviewValidateLinksStepAdapterTest.java\", \"content\": \"package com.company.generated.units.u83d87fed10bb;\\n\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\\nimport java.io.IOException;\\nimport java.net.http.HttpClient;\\nimport java.net.http.HttpResponse;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.ArgumentMatchers.any;\\nimport static org.mockito.Mockito.*;\\n\\npublic class OverviewValidateLinksStepAdapterTest {\\n\\n    @Test\\n    public void testHttpTimeoutOrTransportFailureReturnsOtherCode() throws Exception {\\n        HttpClient httpClient = mock(HttpClient.class);\\n        GetClientLinksRequestUnformatMapper requestMapper = mock(GetClientLinksRequestUnformatMapper.class);\\n        GetClientLinksRSFmtMapper responseMapper = mock(GetClientLinksRSFmtMapper.class);\\n        StandardErrorRSFmtMapper errorMapper = mock(StandardErrorRSFmtMapper.class);\\n\\n        GetClientLinksRequest businessReq = new GetClientLinksRequest(\\\"123456\\\", \\\"0012\\\");\\n        when(requestMapper.toBusinessInput(any(GetClientLinksRequestXml.class))).thenReturn(businessReq);\\n\\n        when(httpClient.<String>send(any(), any())).thenThrow(new IOException(\\\"Timeout or transport failure\\\"));\\n\\n        OverviewValidateLinksStep step = new OverviewValidateLinksStep(\\n                \\\"http://localhost:8080\\\", httpClient, requestMapper, responseMapper, errorMapper);\\n\\n        int rc = step.execute(\\\"123456\\\", \\\"0012\\\");\\n        assertEquals(1, rc);\\n    }\\n\\n    @Test\\n    public void testTargetBusinessErrorReplyReturnsOtherCode() throws Exception {\\n        HttpClient httpClient = mock(HttpClient.class);\\n        HttpResponse<String> httpResponse = mock(HttpResponse.class);\\n        GetClientLinksRequestUnformatMapper requestMapper = mock(GetClientLinksRequestUnformatMapper.class);\\n        GetClientLinksRSFmtMapper responseMapper = mock(GetClientLinksRSFmtMapper.class);\\n        StandardErrorRSFmtMapper errorMapper = mock(StandardErrorRSFmtMapper.class);\\n\\n        GetClientLinksRequest businessReq = new GetClientLinksRequest(\\\"123456\\\", \\\"0012\\\");\\n        when(requestMapper.toBusinessInput(any(GetClientLinksRequestXml.class))).thenReturn(businessReq);\\n\\n        StandardErrorRSFmtMapper.ErrorReply errorReply =\\n                new StandardErrorRSFmtMapper.ErrorReply(\\\"SYSTEM\\\", \\\"E001\\\", \\\"Invalid Client Links\\\", \\\"req-123\\\");\\n        when(errorMapper.unformat(any(String.class))).thenReturn(errorReply);\\n\\n        when(httpClient.<String>send(any(), any())).thenReturn(httpResponse);\\n        when(httpResponse.statusCode()).thenReturn(500);\\n        when(httpResponse.body()).thenReturn(\\\"<ErrorReply><ErrorCategory>SYSTEM</ErrorCategory><ErrorNumber>E001</ErrorNumber><ErrorDescription>Invalid Client Links</ErrorDescription><RequestId>req-123</RequestId></ErrorReply>\\\");\\n\\n        OverviewValidateLinksStep step = new OverviewValidateLinksStep(\\n                \\\"http://localhost:8080\\\", httpClient, requestMapper, responseMapper, errorMapper);\\n\\n        int rc = step.execute(\\\"123456\\\", \\\"0012\\\");\\n        assertEquals(1, rc);\\n        verify(errorMapper).unformat(any(String.class));\\n    }\\n}\"}], \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": [\"org.junit.jupiter.api.Test\", \"org.junit.jupiter.api.Assertions\"]}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": [\"org.mockito.Mockito\", \"org.mockito.ArgumentMatchers\"]}, {\"group_id\": \"com.fasterxml.jackson.dataformat\", \"artifact_id\": \"jackson-dataformat-xml\", \"version\": \"2.17.2\", \"scope\": \"compile\", \"reason\": \"Current target POM dependency\", \"required_classes\": [\"com.fasterxml.jackson.dataformat.xml.XmlMapper\"]}, {\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-26209c8451ff\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for this run\", \"required_classes\": []}], \"coverage\": {\"business\": [\"src/test/java/com/company/generated/units/u83d87fed10bb/OverviewValidateLinksStepBusinessTest.java\"], \"native-operation-calls\": [\"src/test/java/com/company/generated/units/u83d87fed10bb/OverviewValidateLinksStepAdapterTest.java\"]}, \"evidence_ids\": [\"configured_step-83d87fed10bb148669e0f846\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.cc.cut.CCComplexOpStep\"], \"unresolved_questions\": [], \"unit_contract\": {\"unit_id\": \"configured_step-83d87fed10bb148669e0f846\", \"apis\": [{\"type_name\": \"com.company.generated.units.u83d87fed10bb.OverviewValidateLinksStep\", \"method_signatures\": [\"public int execute(java.lang.String, java.lang.String) throws java.lang.Exception\"]}], \"dependency_units\": [\"re