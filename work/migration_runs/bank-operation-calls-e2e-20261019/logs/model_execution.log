unds\";\n            case \"40_5\": return \"Account not eligible for this operation\";\n            case \"50_2\": return \"Transfer blocked: fraud risk detected\";\n            case \"60_6\": return \"Core banking system rejected the request\";\n            case \"60_7\": return \"Transfer already processed\";\n            case \"99_0\": return \"Technical error: unexpected system failure\";\n            case \"99_8\": return \"Technical error: database connection failure\";\n            default:     return \"System error (category=\" + category + \", number=\" + number + \")\";\n        }\n    }\n}\n"}, {"path": "src/test/java/com/company/generated/units/u3643d2141e0a/NoLinksFoundStepBusinessTest.java", "content": "package com.company.generated.units.u3643d2141e0a;\n\nimport com.company.generated.units.u3a42c4326e3d.OperationContext;\nimport org.junit.jupiter.api.Test;\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\npublic class NoLinksFoundStepBusinessTest {\n    @Test\n    public void setsErrorCategoryAndDescriptionForNoLinksFound() {\n        OperationContext context = new OperationContext();\n        NoLinksFoundStep step = new NoLinksFoundStep();\n        int result = step.execute(context);\n\n        assertEquals(0, result);\n        assertEquals(\"20\", context.getValueAt(\"ErrorCategory\"));\n        assertEquals(\"1\", context.getValueAt(\"ErrorNumber\"));\n        assertEquals(\"No data found for the provided criteria\", context.getValueAt(\"ErrorDescription\"));\n    }\n}\n"}], "dependencies": [{"group_id": "com.company.migration", "artifact_id": "shared-33e19da28f26", "version": "1.0.0-4d092659baf5", "scope": "compile", "reason": "Accepted native behavior library for this run", "required_classes": []}, {"group_id": "org.junit.jupiter", "artifact_id": "junit-jupiter", "version": "5.10.0", "scope": "test", "reason": "Application-owned Java 25 test template", "required_classes": ["org.junit.jupiter.api.Test", "org.junit.jupiter.api.Asser