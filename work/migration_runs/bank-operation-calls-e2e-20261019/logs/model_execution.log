{"files": [{"path": "src/main/java/com/company/generated/units/u5d8854ada12b/ValidateClientLinksFetchStep.java", "content": "package com.company.generated.units.u5d8854ada12b;\n\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\nimport com.ibm.dse.base.CCOperationStep;\nimport com.ibm.dse.base.Context;\nimport java.net.URI;\nimport java.net.http.HttpClient;\nimport java.net.http.HttpRequest;\nimport java.net.http.HttpResponse;\nimport java.time.Duration;\nimport java.util.Objects;\n\npublic class ValidateClientLinksFetchStep extends CCOperationStep {\n    private final String baseUrl;\n    private final HttpClient httpClient;\n    private final GetClientLinksRequestUnformatMapper requestUnformatMapper;\n    private final GetClientLinksRSFmtMapper responseMapper;\n    private final StandardErrorRSFmtMapper errorMapper;\n\n    public ValidateClientLinksFetchStep(String baseUrl) {\n        this(baseUrl, HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(10)).build(), \n             new GetClientLinksRequestUnformatMapper(), new GetClientLinksRSFmtMapper(), new StandardErrorRSFmtMapper());\n    }\n\n    public ValidateClientLinksFetchStep(String baseUrl, HttpClient httpClient,\n                                      GetClientLinksRequestUnformatMapper requestUnformatMapper,\n                                      GetClientLinksRSFmtMapper responseMapper,\n                                      StandardErrorRSFmtMapper errorMapper) {\n        this.baseUrl = Objects.requireNonNull(baseUrl, \"Base URL\");\n        this.httpClient = Objects.requireNonNull(httpClient, \"HTTP Client\");\n        this.requestUnformatMapper = Objects.requireNonNull(requestUnformatMapper, \"Request Unformat Mapper\");\n        this.responseMapper = Objects.requireNonNull(responseMapper, \"Response Mapper\");\n        this.errorMapper = Objects.requireNonNull(errorMapper, \"Error Mapper\");\n    }\n\n    @Override\n    public int execute() throws Exception {\n        Context ctx = getContext();\n        String clientId = (String) ctx.getValueAt(\"ClientId\");\n        String bankId = (String) ctx.getValueAt(\"BankId\");\n\n        GetClientLinksRequest requestDto = new GetClientLinksRequest(clientId, bankId);\n        \n        GetClientLinksRequestXml reqXml = new GetClientLinksRequestXml();\n        reqXml.clientId = requestDto.getClientId();\n        reqXml.bankId = requestDto.getBankId();\n        com.fasterxml.jackson.dataformat.xml.XmlMapper xmlMapper = new com.fasterxml.jackson.dataformat.xml.XmlMapper();\n        String requestPayload = xmlMapper.writeValueAsString(reqXml);\n\n        String endpoint = baseUrl + (baseUrl.endsWith(\"/\") ? \"\" : \"/\") + \"operations/INTERNET/GetClientLinksOp\";\n        HttpRequest httpRequest = HttpRequest.newBuilder()\n                .uri(URI.create(endpoint))\n                .header(\"Content-Type\", \"application/xml\")\n                .header(\"Accept\", \"application/xml\")\n                .POST(HttpRequest.BodyPublishers.ofString(requestPayload))\n                .timeout(Duration.ofSeconds(30))\n                .build();\n\n        HttpResponse<String> response = httpClient.send(httpRequest, HttpResponse.BodyHandlers.ofString());\n        int statusCode = response.statusCode();\n        String responseBody = response.body();\n\n        if (statusCode >= 200 && statusCode < 300) {\n            GetClientLinksRSFmtMapper.GetClientLinksResponse respObj = responseMapper.unformat(responseBody);\n            ctx.setValueAt(\"GetClientLinksResponse\", respObj);\n            ctx.setValueAt(\"ClientId\", respObj.clientId());\n            ctx.setValueAt(\"Links\", respObj.links());\n            return 0;\n        } else {\n            try {\n                StandardErrorRSFmtMapper.ErrorReply errorReply = errorMapper.unformat(responseBody);\n                ctx.setValueAt(\"ErrorReply\", errorReply);\n                ctx.setValueAt(\"ERROR_CATEGORY\", errorReply.errorCategory());\n                ctx.setValueAt(\"ERROR_NUMBER\", errorReply.errorNumber());\n                ctx.setValueAt(\"ERROR_DESCRIPTION\", errorReply.errorDescription());\n            } catch (Exception e) {\n                ctx.setValueAt(\"ERROR_DESCRIPTION\", responseBody);\n            }\n            return statusCode;\n        }\n    }\n}"}, {"path": "src/test/java/com/company/generated/units/u5d8854ada12b/ValidateClientLinksFetchStepTest.java", "content": "package com.company.generated.units.u5d8854ada12b;\n\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\nimport com.ibm.dse.base.Context;\nimport com.sun.net.httpserver.HttpServer;\nimport com.sun.net.httpserver.HttpHandler;\nimport com.sun.net.httpserver.HttpExchange;\nimport org.junit.jupiter.api.AfterEach;\nimport org.junit.jupiter.api.BeforeEach;\nimport org.junit.jupiter.api.Test;\n\nimport java.io.IOException;\nimport java.io.OutputStream;\nimport java.net.InetSocketAddress;\nimport java.util.List;\n\nimport static org.junit.jupiter.api.Assertions.*;\n\npublic class ValidateClientLinksFetchStepTest {\n    private HttpServer server;\n    private String baseUrl;\n    private int responseStatus = 200;\n    private String responsePayload = \"<GetClientLinksResponse><ClientId>12345</ClientId><Links><Link><LinkId>L1</LinkId><LinkUrl>http://example.com</LinkUrl><IsExternal>false</IsExternal></Link></Links></GetClientLinksResponse>\";\n\n    @BeforeEach\n    public void setUp() throws IOException {\n        server = HttpServer.create(new InetSocketAddress(0), 0);\n        server.createContext(\"/operations/INTERNE