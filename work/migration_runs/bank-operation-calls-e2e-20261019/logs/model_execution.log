ategory();\n        wire.errorNumber = reply.errorNumber();\n        wire.errorDescription = reply.errorDescription();\n        \n        wire.requestId = new NullableRequestId();\n        if (reply.requestId() == null) {\n            wire.requestId.nil = \"true\";\n        } else {\n            wire.requestId.value = reply.requestId();\n        }\n        return xmlMapper.writeValueAsString(wire);\n    }\n\n    public ErrorReply unformat(String xml) throws Exception {\n        ErrorReplyWire wire = xmlMapper.readValue(xml, ErrorReplyWire.class);\n        Objects.requireNonNull(wire, \"Deserialized wire structure must not be null\");\n        \n        String reqId = null;\n        if (wire.requestId != null && !\"true\".equals(wire.requestId.nil)) {\n            reqId = wire.requestId.value;\n        }\n        return new ErrorReply(wire.errorCategory, wire.errorNumber, wire.errorDescription, reqId);\n    }\n}\n"}, {"path": "src/test/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtBusinessTest.java", "content": "package com.company.generated.units.u66bf2c108225;\n\nimport org.junit.jupiter.api.Test;\nimport static org.junit.jupiter.api.Assertions.*;\n\npublic class StandardErrorRSFmtBusinessTest {\n    private final StandardErrorRSFmtMapper mapper = new StandardErrorRSFmtMapper();\n\n    @Test\n    public void formatsFullyPopulatedErrorReply() throws Exception {\n        StandardErrorRSFmtMapper.ErrorReply reply = new StandardErrorRSFmtMapper.ErrorReply(\"CAT1\", \"500\", \"System Error\", \"REQ-123\");\n        String xml = mapper.format(reply);\n        assertTrue(xml.contains(\"<ErrorCategory>CAT1</ErrorCategory>\"));\n        assertTrue(xml.contains(\"<ErrorNumber>500</ErrorNumber>\"));\n        assertTrue(xml.contains(\"<ErrorDescription>System Error</ErrorDescription>\"));\n        assertTrue(xml.contains(\"<RequestId>REQ-123</RequestId>\"));\n\n        StandardErrorRSFmtMapper.ErrorReply unformatted = mapper.unformat(xml);\n        assertEquals(\"CAT1\", unformatted.errorCategory());\n        assertEquals(\"500\", unformatted.errorNumber());\n        assertEquals(\"System Error\", unformatted.errorDescription());\n        assertEquals(\"REQ-123\", unformatted.requestId());\n    }\n\n    @Test\n    public void handlesNullRequestIdWithNilDecorator() throws Exception {\n        StandardErrorRSFmtMapper.ErrorReply reply = new StandardErrorRSFmtMapper.ErrorReply(\"CAT2\", \"404\", \"Not Found\", null);\n        String xml = mapper.format(reply);\n        assertTrue(xml.contains(\"xsi:nil=\\\"true\\\"\"));\n\n        StandardErrorRSFmtMapper.ErrorReply unformatted = mapper.unformat(xml);\n        assertNull(unformatted.requestId());\n        assertEquals(\"CAT2\", unformatted.errorCategory());\n        assertEquals(\"404\", unformatted.errorNumber());\n        assertEquals(\"Not Found\", unformatted.errorDescription());\n    }\n}\n"}, {"path": "src/test/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtAdapterTest.java", "content": "package com.company.generated.units.u66bf2c108225;\n\nimport org.junit.jupiter.api.Test;\nimport static org.junit.jupiter.api.Assertions.*;\nimport javax.xml.parsers.DocumentBuilderFactory;\nimport java.io.ByteArrayInputStream;\nimport java.nio.charset.StandardCharsets;\nimport org.w3c.dom.Element;\n\npublic class StandardErrorRSFmtAdapterTest {\n    private final StandardErrorRSFmtMapper mapper = new StandardErrorRSFmtMapper();\n    private static final String XSI = \"http://www.w3.org/2001/XMLSchema-instance\";\n\n    private Element parseXml(String xml) throws Exception {\n        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\n        factory.setNamespaceAware(true);\n        return factory.newDocumentBuilder().parse(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))).getDocumentElement();\n    }\n\n    @Test\n    public void verifiesXmlStructureAndNamespaces() throws Exception {\n        StandardErrorRSFmtMapper.ErrorReply r