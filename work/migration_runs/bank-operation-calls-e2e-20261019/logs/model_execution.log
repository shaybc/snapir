{"parts":[{"text":"{\"unit\": {\"unit_id\": \"configured_step-42b95631a1866d97e7e0cbfa\", \"kind\": \"configured_step\", \"logical_id\": \"GetClientLinks\", \"configuration_xml\": \"<opStep id=\\\"GetClientLinks\\\" implClass=\\\"com.ibm.il.dse.operations.internet.db.GetClientLinksSP\\\" on0Do=\\\"end\\\" on4Do=\\\"NoLinksFound\\\" on8Do=\\\"DatabaseError\\\" onOtherDo=\\\"TechnicalError\\\" />\\n\\n    \", \"sources\": [{\"identity\": \"com.ibm.dse.base.CCOperationStep\", \"content\": \"package com.ibm.dse.base;\\n\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\n/** Demo step contract with a shared operation context and explicitly registered services. */\\npublic abstract class CCOperationStep {\\n    private Context context;\\n    private final Map<String, Object> services = new HashMap<>();\\n\\n    public abstract int execute() throws Exception;\\n\\n    public void setContext(Context context) {\\n        this.context = Objects.requireNonNull(context, \\\"Operation context\\\");\\n    }\\n\\n    public Context getContext() {\\n        if (context == null) {\\n            throw new IllegalStateException(\\\"Configure an operation context before executing a step\\\");\\n        }\\n        return context;\\n    }\\n\\n    public void setService(String name, Object service) {\\n        services.put(Objects.requireNonNull(name, \\\"Service name\\\"), Objects.requireNonNull(service, \\\"Service\\\"));\\n    }\\n\\n    public Object getService(String name) {\\n        Object service = services.get(Objects.requireNonNull(name, \\\"Service name\\\"));\\n        if (service == null) {\\n            throw new IllegalStateException(\\\"Configure the named service before executing a step: \\\" + name);\\n        }\\n        return service;\\n    }\\n}\\n\", \"content_hash\": \"bdba80eb19b1472b584f9e327d0e51c64249bc354b6f84f97ab3828e3e026bff\"}, {\"identity\": \"com.ibm.dse.base.Context\", \"content\": \"package com.ibm.dse.base;\\n\\nimport java.sql.Connection;\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\n/** Demo operation context containing named values and an externally supplied JDBC connection. */\\npublic class Context {\\n    private final Map<String, Object> values = new HashMap<>();\\n    private Connection connection;\\n\\n    public Object getValueAt(String name) {\\n        return values.get(Objects.requireNonNull(name, \\\"Context field name\\\"));\\n    }\\n\\n    public void setValueAt(String name, Object value) {\\n        values.put(Objects.requireNonNull(name, \\\"Context field name\\\"), value);\\n    }\\n\\n    /** The caller owns the connection and its transaction lifecycle. */\\n    public void setConnection(Connection connection) {\\n        this.connection = Objects.requireNonNull(connection, \\\"JDBC connection\\\");\\n    }\\n\\n    public Connection getConnection() {\\n        if (connection == null) {\\n            throw new IllegalStateException(\\\"Configure a JDBC connection before executing a database step\\\");\\n        }\\n        return connection;\\n    }\\n}\\n\", \"content_hash\": \"2ecbe34eb7f561dab6bdbe5d9949b56e652f33c8a8e792994fdba33114cacf71\"}, {\"identity\": \"com.ibm.il.dse.operations.internet.db.GetClientLinksSP\", \"content\": \"package com.ibm.il.dse.operations.internet.db;\\n\\nimport com.ibm.dse.base.CCOperationStep;\\nimport com.ibm.dse.base.Context;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport java.sql.ResultSet;\\nimport java.util.ArrayList;\\nimport java.util.LinkedHashMap;\\nimport java.util.List;\\nimport java.util.Map;\\n\\n/**\\n * Fetches personalised navigation links for a client.\\n * Simple reference operation — good as a pilot example.\\n *\\n * Context reads: ClientId, BankId\\n * Context writes: Links (List of Map)\\n *\\n * Returns:\\n *   0 - links found and loaded\\n *   4 - no links configured for this client\\n *   8 - database error\\n */\\npublic class GetClientLinksSP extends CCOperationStep {\\n\\n    private static final String SP_NAME = \\\"{call PKG_PORTAL.GET_CLIENT_LINKS(?,?,?,?)}\\\";\\n    private static final int RC_SUCCESS   = 0;\\n    private static final int RC_NOT_FOUND = 4;\\n    private static final int RC_DB_ERROR  = 8;\\n\\n    @Override\\n    public int execute() throws Exception {\\n        Context ctx      = getContext();\\n        String clientId  = (String) ctx.getValueAt(\\\"ClientId\\\");\\n        String bankId    = (String) ctx.getValueAt(\\\"BankId\\\");\\n\\n        Connection conn  = ctx.getConnection();\\n        try (CallableStatement cs = conn.prepareCall(SP_NAME)) {\\n            cs.setString(1, clientId);\\n            cs.setString(2, bankId);\\n            cs.registerOutParameter(3, java.sql.Types.VARCHAR);\\n            cs.registerOutParameter(4, java.sql.Types.REF_CURSOR);\\n            cs.execute();\\n\\n            String spRc = cs.getString(3);\\n            if (\\\"NOT_FOUND\\\".equals(spRc)) return RC_NOT_FOUND;\\n\\n            try (ResultSet rs = (ResultSet) cs.getObject(4)) {\\n                List<Map<String, Object>> links = new ArrayList<>();\\n                while (rs.next()) {\\n                    Map<String, Object> link = new LinkedHashMap<>();\\n                    link.put(\\\"LinkId\\\",   rs.getString(\\\"LINK_ID\\\"));\\n                    link.put(\\\"LinkUrl\\\",  rs.getString(\\\"LINK_URL\\\"));\\n                    link.put(\\\"IsExternal\\\", \\\"Y\\\".equals(rs.getString(\\\"IS_EXTERNAL\\\")));\\n                    link.put(\\\"IconCode\\\", rs.getString(\\\"ICON_CODE\\\"));\\n                    links.add(link);\\n                }\\n                if (links.isEmpty()) return RC_NOT_FOUND;\\n                ctx.setValueAt(\\\"Links\\\", links);\\n            }\\n\\n        } catch (Exception e) {\\n            ctx.setValueAt(\\\"DatabaseError\\\", e.getMessage());\\n            return RC_DB_ERROR;\\n        }\\n        return RC_SUCCESS;\\n    }\\n}\\n\", \"content_hash\": \"3236d23fe5afcbd68284a7bb29a470e440668d66fcea8e8e62b69c4035259fc2\"}], \"consumers\": [\"INTERNET/GetClientLinksOp\"], \"external_dependencies\": [], \"referenced_definitions\": [], \"fingerprint\": \"42b95631a1866d97e7e0cbfa519a8a98ab916115e1acd3954c310377bb3ab4ae\", \"schema_version\": \"v1\", \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-42b95631a1866d97e7e0cbfa\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.internet.db.GetClientLinksSP\"], \"converted_dependency_apis\": [{\"unit_id\": \"request_unformat-561a01497abb3d3133b663f0\", \"planned_apis\": [{\"type_name\": \"com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper\", \"method_signatures\": [\"public com.company.generated.units.u561a01497abb.GetClientLinksRequest toBusinessInput(com.company.generated.units.u561a01497abb.GetClientLinksRequestXml)\", \"public com.company.generated.units.u561a01497abb.GetClientLinksRequest unformat(java.lang.String)\"]}], \"verified_api_surface\": {\"src/main/java/com/company/generated/units/u561a01497abb/GetClientLinksRequest.java\": {\"imports\": [], \"public_declarations\": [\"public class GetClientLinksRequest\", \"public GetClientLinksRequest()\", \"public GetClientLinksRequest(String clientId, String bankId)\", \"public String getClientId()\", \"public void setClientId(String clientId)\", \"public String getBankId()\", \"public void setBankId(String bankId)\"]}, \"src/main/java/com/company/generated/units/u561a01497abb/GetClientLinksRequestXml.java\": {\"imports\": [\"import com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty;\", \"import com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement;\"], \"public_declarations\": [\"public class GetClientLinksRequestXml\", \"public String clientId\", \"public String bankId\"]}, \"src/main/java/com/company/g