eate(endpoint))\\n                .header(\\\"Content-Type\\\", \\\"application/xml\\\")\\n                .header(\\\"Accept\\\", \\\"application/xml\\\")\\n                .POST(HttpRequest.BodyPublishers.ofString(requestBody))\\n                .timeout(Duration.ofSeconds(30))\\n                .build();\\n\\n        HttpResponse<String> response = httpClient.send(httpRequest, HttpResponse.BodyHandlers.ofString());\\n        int statusCode = response.statusCode();\\n        String responseBody = response.body();\\n\\n        if (statusCode >= 200 && statusCode < 300) {\\n            var successResp = successMapper.unformat(responseBody);\\n            getContext().setValueAt(\\\"GetClientLinksResponse\\\", successResp);\\n            getContext().setValueAt(\\\"ERROR_CODE\\\", \\\"0\\\");\\n            return 0;\\n        } else {\\n            try {\\n                var errorResp = errorMapper.unformat(responseBody);\\n                getContext().setValueAt(\\\"ErrorReply\\\", errorResp);\\n                getContext().setValueAt(\\\"ERROR_CODE\\\", errorResp.errorNumber() != null ? errorResp.errorNumber() : String.valueOf(statusCode));\\n            } catch (Exception e) {\\n                getContext().setValueAt(\\\"ERROR_CODE\\\", String.valueOf(statusCode));\\n            }\\n            return -1;\\n        }\\n    }\\n}\"}, {\"path\": \"src/main/java/com/company/generated/units/ud34867d88b62/OperationContextBridge.java\", \"content\": \"package com.company.generated.units.ud34867d88b62;\\n\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\npublic class OperationContextBridge {\\n    private final Map<String, Object> values = new HashMap<>();\\n\\n    public Object getValueAt(String name) {\\n        return values.get(Objects.requireNonNull(name, \\\"Context field name\\\"));\\n    }\\n\\n    public void setValueAt(String name, Object value) {\\n        values.put(Objects.requireNonNull(name, \\\"Context field name\\\"),