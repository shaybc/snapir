String(wire);\\n    }\\n\\n    public ErrorReply unformat(String xml) throws Exception {\\n        ErrorReplyWire wire = xmlMapper.readValue(xml, ErrorReplyWire.class);\\n        Objects.requireNonNull(wire, \\\"Deserialized wire structure must not be null\\\");\\n        \\n        String reqId = null;\\n        if (wire.requestId != null && !\\\"true\\\".equals(wire.requestId.nil)) {\\n            reqId = wire.requestId.value;\\n        }\\n        return new ErrorReply(wire.errorCategory, wire.errorNumber, wire.errorDescription, reqId);\\n    }\\n}\\n\"}], \"original_test_output\": \"Candidate validation failed: Maven test: [INFO] Scanning for projects...\\n[INFO] \\n[INFO] -------------< com.company.migration:shared-26209c8451ff >--------------\\n[INFO] Building shared-26209c8451ff 1.0.0-4d092659baf5\\n[INFO]   from pom.xml\\n[INFO] --------------------------------[ jar ]---------------------------------\\n[INFO] \\n[INFO] --- enforcer:3.6.2:enforce (default) @ shared-26209c8451ff ---\\n[INFO] Rule 0: org.apache.maven.enforcer.rules.version.RequireJavaVersion passed\\n[INFO] \\n[INFO] --- resources:3.4.0:resources (default-resources) @ shared-26209c8451ff ---\\n[INFO] skip non existing resourceDirectory C:\\\\Users\\\\shayg\\\\AppData\\\\Local\\\\Temp\\\\snapir-native-bundle-xud4nmye\\\\shared-26209c8451ff\\\\src\\\\main\\\\resources\\n[INFO] \\n[INFO] --- compiler:3.14.1:compile (default-compile) @ shared-26209c8451ff ---\\n[INFO] Nothing to compile - all classes are up to date.\\n[INFO] \\n[INFO] --- resources:3.4.0:testResources (default-testResources) @ shared-26209c8451ff ---\\n[INFO] skip non existing resourceDirectory C:\\\\Users\\\\shayg\\\\AppData\\\\Local\\\\Temp\\\\snapir-native-bundle-xud4nmye\\\\shared-26209c8451ff\\\\src\\\\test\\\\resources\\n[INFO] \\n[INFO] --- compiler:3.14.1:testCompile (default-testCompile) @ shared-26209c8451ff ---\\n[INFO] Recompiling the module because of changed source code.\\n[INFO] Compiling 2 source files with javac [d