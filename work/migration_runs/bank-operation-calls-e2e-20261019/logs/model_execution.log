ockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"rules\": [\"Keep each test focused on one evidenced outcome or side effect.\", \"Cover meaningful behavior across the bundle, not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\npublic class AdapterContractTest {\\n    @Test void adapterPassesTheIdentifierToItsDependency() throws Exception {\\n        Connection connection = mock(Connection.class);\\n        CallableStatement statement = mock(CallableStatement.class);\\n        when(connection.prepareCall(\\\"{call sample(?)}\\\")).thenReturn(statement);\\n        when(statement.getString(1)).thenReturn(\\\"sample-result\\\");\\n        try (CallableStatement call = connection.prepareCall(\\\"{call sample(?)}\\\")) {\\n            call.setString(1, \\\"sample-id\\\");\\n            call.execute();\\n            assertEquals(\\\"sample-result\\\", call.getString(1));\\n        }\\n        verify(statement).setString(1, \\\"sample-id\\\");\\n        verify(statement).execute();\\n        verify(statement).close();\\n    }\\n}\\n\"}, {\"path\": \"BusinessBehaviorTest.java\", \"content\": \"package example;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Reference structure only: derive real expected values from migration evidence. */\\npublic class BusinessBehaviorTest {\\n    interface NotificationPort { void send(String reference); }\\n    static class CompletionService {\\n        private final NotificationPort notifications;\\n        CompletionService(NotificationPort notifications) { this.notifications = notifications; }\\n        String complete(String reference) { notifications.send(reference); return reference; }\\n    }\\n\\n    @Test void returnsTheCompletedReference() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        CompletionService service = new CompletionService(notifications);\\n        assertEquals(\\\"sample-reference\\\", service.complete(\\\"sample-reference\\\"));\\n    }\\n\\n    @Test void notifiesTheCollaboratorOnce() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        new CompletionService(notifications).complete(\\\"sample-reference\\\");\\n        verify(notifications).send(\\\"sample-reference\\\");\\n        verifyNoMoreInteractions(notifications);\\n    }\\n}\\n\"}]}, \"final_validation_feedback\": null, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\", \"kind\": \"service\", \"assembly_phase\": \"single_route_test\", \"scenario\": {\"scenario_id\": \"GetClientLinks_NoLinksFound\", \"description\": \"Executes GetClientLinksOp when no links are found (on4Do), routing through NoLinksFound step to end while preserving operation flow and dependency injection.\", \"inputs\": [\"Valid GetClientLinksRequestXml for a client without configured links\"], \"dependency_setup\": [\"GetClientLinksStep injected via constructor and returns return code 4\", \"DataSource returns a valid Connection\", \"NoLinksFoundStep injected via constructor executes and populates error category and number\"], \"expected_outcome\": \"Standard error reply XML string formatted via StandardErrorRSFmtMapper indicating no links found\", \"expected_side_effects\": [\"NoLinksFoundStep.execute is invoked on the context\", \"Error fields are retrieved from context for the error reply\"], \"covers\": [\"route-GetClientLinks\", \"route-NoLinksFound\", \"operation-flow\", \"operation-step-injection\"], \"routes\": [{\"source\": \"GetClientLinks\", \"outcome\": \"on4Do\", \"target\": \"NoLinksFound\"}, {\"source\": \"NoLinksFound\", \"outcome\": \"onOtherDo\", \"target\": \"end\"}]}, \"assembled_code\": [{\"path\": \"src/main/java/com/company/generated/operations/GetClientLinksOpService.java\", \"content\": \"package com.company.generated.operations;\\n\\nimport com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep;\\nimport com.company.generated.units.u3a42c4326e3d.OperationContext;\\nimport com.company.generated.units.u3643d2141e0a.NoLinksFoundStep;\\nimport com.company.generated.units.u42b95631a186.GetClientLinksStep;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\\nimport com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep;\\n\\nimport javax.sql.DataSource;\\nimport java.sql.Connection;\\nimport java.util.List;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\npublic class GetClientLinksOpService {\\n\\n    private final GetClientLinksStep getClientLinksStep;\\n    private final NoLinksFoundStep noLinksFoundStep;\\n    private final DatabaseErrorStep databaseErrorStep;\\n    private final TechnicalErrorStep technicalError;\\n    private final DataSource dataSource;\\n\\n    private final GetClientLinksRequestUnformatMapper requestUnformatMapper;\\n    private final GetClientLinksRSFmtMapper replyFormatMapper;\\n    private final StandardErrorRSFmtMapper errorReplyFormatMapper;\\n\\n    public GetClientLinksOpService(\\n            GetClientLinksStep getClientLinksStep,\\n            NoLinksFoundStep noLinksFoundStep,\\n            DatabaseErrorStep databaseErrorStep,\\n            TechnicalErrorStep technicalError,\\n            DataSource dataSource) {\\n        this.getClientLinksStep = Objects.requireNonNull(getClientLinksStep);\\n        this.noLinksFoundStep = Objects.requireNonNull(noLinksFoundStep);\\n        this.databaseErrorStep = Objects.requireNonNull(databaseErrorStep);\\n        this.technicalError = Objects.requireNonNull(technicalError);\\n        this.dataSource = Objects.requireNonNull(dataSource);\\n\\n        this.requestUnformatMapper = new GetClientLinksRequestUnformatMapper();\\n        this.replyFormatMapper = new GetClientLinksRSFmtMapper();\\n        this.errorReplyFormatMapper = new StandardErrorRSFmtMapper();\\n    }\\n\\n    public String execute(GetClientLinksRequestXml requestXml) throws Exception {\\n        GetClientLinksRequest request = requestUnformatMapper.toBusinessInput(requestXml);\\n        OperationContext context = new OperationContext();\\n        context.setValueAt(\\\"ClientId\\\", request.getClientId());\\n        context.setValueAt(\\\"BankId\\\", request.getBankId());\\n        context.setValueAt(\\\"HOST_HEADER.HOST_KEY\\\", \\\"GCLN\\\");\\n\\n        int rc;\\n        try (Connection connection = dataSource.getConnection()) {\\n            context.setConnection(connection);\\n            rc = getClientLinksStep.execute(context);\\n        }\\n\\n        if (rc == 0) {\\n            String clientId = (String) context.getValueAt(\\\"ClientId\\\");\\n            List<Object> rawLinks = (List<Object>) context.getValueAt(\\\"Links\\\");\\n            List<GetClientLinksRSFmtMapper.LinkDto> linkDtos = new java.util.ArrayList<>();\\n\\n            if (rawLinks != null) {\\n                for (Object rawLink : rawLinks) {\\n                    if (rawLink instanceof Map) {\\n                        Map<?, ?> map = (Map<?, ?>) rawLink;\\n                        String linkId = (String) map.get(\\\"LinkId\\\");\\n                        String linkDescription = (String) map.get(\\\"LinkDescription\\\");\\n                        String linkUrl = (String) map.get(\\\"LinkUrl\\\");\\n                        Boolean isExternal = (Boolean) map.get(\\\"IsExternal\\\");\\n                        String iconCode = (String) map.get(\\\"IconCode\\\");\\n                        linkDtos.add(new GetClientLinksRSFmtMapper.LinkDto(linkId, linkDescription, linkUrl, isExternal, iconCode));\\n                    }\\n                }\\n            }\\n\\n            GetClientLinksRSFmtMapper.GetClientLinksResponse response = \\n                new GetClientLinksRSFmtMapper.GetClientLinksResponse(clientId, linkDtos);\\n            return replyFormatMapper.format(response);\\n        } else {\\n            String errorCategory;\\n            String errorNumber;\\n            String errorDescription;\\n\\n            if (rc == 4) {\\n                noLinksFoundStep.execute(context);\\n                errorCategory = noLinksFoundStep.getErrorCategory();\\n                errorNumber = noLinksFoundStep.getErrorNumber();\\n            } else if (rc == 8) {\\n                databaseErrorStep.execute(context);\\n                errorCategory = databaseErrorStep.getErrorCategory();\\n                errorNumber = databaseErrorStep.getErrorNumber();\\n            } else {\\n                technicalError.execute(context);\\n                errorCategory = technicalError.getErrorCategory();\\n                errorNumber = technicalError.getErrorNumber();\\n            }\\n\\n            errorDescription = (String) context.getValueAt(\\\"ErrorDescription\\\");\\n            String requestId = (String) context.getValueAt(\\\"RequestId\\\");\\n\\n            StandardErrorRSFmtMapper.ErrorReply errorReply = \\n                new StandardErrorRSFmtMapper.ErrorReply(errorCategory, errorNumber, errorDescription, requestId);\\n            return errorReplyFormatMapper.format(errorReply);\\n        }\\n    }\\n}\\n\"}], \"operation_contract\": {\"sources\": [{\"identity\": \"com.ibm.il.dse.cc.cut.CCDSEServerOperation\", \"content_hash\": \"fcaf68594b17326659d327bcc975553a231d2d1e62f7b741959b9e142603d288\"}], \"units\": [{\"unit_id\": \"configured_step-3a42c4326e3d7f21467b61b2\", \"apis\": [{\"type_name\": \"com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\", \"public java.lang.String getErrorCategory()\", \"public java.lang.String getErrorNumber()\"]}, {\"type_name\": \"com.