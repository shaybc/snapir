d)\\n- [CCMandatory](formats/CCMandatory.md)\\n- [CCPadding](formats/CCPadding.md)\\n\\n## Mapped Java Classes\\n- [com.ibm.il.dse.cc.format.CCXML](classes/com/ibm/il/dse/cc/format/CCXML.md)\\n- [com.ibm.il.dse.cc.format.CCString](classes/com/ibm/il/dse/cc/format/CCString.md)\\n- com.ibm.il.dse.cc.decorator.CCMandatory\\n- [com.ibm.il.dse.cc.decorator.CCPadding](classes/com/ibm/il/dse/cc/decorator/CCPadding.md)\\n\\n## Inferred External Dependencies\\n- None\\n\", \"name\": \"GetClientLinksRQFmt\"}}, \"media_type\": \"application/xml\", \"method\": \"POST\", \"operation\": \"INTERNET/GetClientLinksOp\", \"path\": \"/operations/INTERNET/GetClientLinksOp\", \"source_hash\": \"5e8b0678d1d4e8c4d53ee6e1e39a933baff92bdd194e0ec8b9634c6d93faac88\", \"fingerprint\": \"3a7d77d282cb31c268b2d5826766ea647c874396187843503da3315d0e8f60b5\", \"status\": \"planned\"}}], \"required_step_dependencies\": [{\"binding_id\": \"ValidateClientLinksFetch\", \"unit_id\": \"configured_step-d34867d88b627187fc6625ed\", \"allowed_types\": [\"com.company.generated.units.ud34867d88b62.ValidateClientLinksFetchStep\"]}], \"required_runtime_resources\": [], \"constructor_example\": \"// Structural example only. Real types, configuration and outcomes come from accepted APIs.\\nfinal class ExampleOperation {\\n    private final ExampleStep check;\\n    private final ExampleStep perform;\\n\\n    public ExampleOperation(ExampleStep check, ExampleStep perform) {\\n        this.check = java.util.Objects.requireNonNull(check);\\n        this.perform = java.util.Objects.requireNonNull(perform);\\n    }\\n\\n    public int execute(int input) {\\n        int result = this.check.execute(input);\\n        return result == 0 ? this.perform.execute(input) : result;\\n    }\\n}\\n\\ninterface ExampleStep {\\n    int execute(int input);\\n}\\n\", \"known_dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-o