\shaybc\\\\snapir\\\\work\\\\migration_runs\\\\bank-operation-calls-e2e-20261019\\\\generated\\\\behavior-libraries\\\\shared-26209c8451ff\", \"apis\": [{\"type_name\": \"com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper\", \"method_signatures\": [\"public java.lang.String format(com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply)\", \"public com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply unformat(java.lang.String)\"]}], \"fingerprint\": \"a00ea8c54cd4dc004c37d2a813445edbf29255107cd05bbdb59719c35980ce8f\", \"files\": {\"src/main/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtMapper.java\": \"901b536bfe443c2c124a153fdb8138827c25ba727550bcfa851456f676c4c3fc\", \"src/test/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtAdapterTest.java\": \"c0ab4f1eced98f895532a11bd375f7d0bd6e9a3f4dd5610e8ad202cd72df65b8\", \"src/test/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtBusinessTest.java\": \"c6c957b96c09b3e638e409bed499833947c970110b76f5aec7bfafddb098127b\"}, \"public_api\": {\"src/main/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtMapper.java\": {\"imports\": [\"import com.fasterxml.jackson.dataformat.xml.XmlMapper;\", \"import com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty;\", \"import com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement;\", \"import com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlText;\", \"import com.fasterxml.jackson.dataformat.xml.ser.ToXmlGenerator;\", \"import java.util.Objects;\"], \"public_declarations\": [\"public final class StandardErrorRSFmtMapper\", \"public StandardErrorRSFmtMapper()\", \"public static class ErrorReplyWire\", \"public static class NullableRequestId\", \"public record ErrorReply(String errorCategory, String errorNumber, String errorDescription, String requestId)\", \"public String format(ErrorReply reply) throws Exception\", \"public ErrorReply unformat(String xml) throws Exception\"]}}, \"contract\": {\"unit_id\": \"response_format-66bf2c108225fb63eb2a0cbe\", \"apis\": [{\"type_name\": \"com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper\", \"method_signatures\": [\"public java.lang.String format(com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply)\", \"public com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply unformat(java.lang.String)\"]}], \"dependency_units\": [], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"response_format-66bf2c108225fb63eb2a0cbe\", \"com.ibm.dse.base.Context\", \"com.ibm.dse.base.Tag\", \"com.ibm.il.dse.cc.decorator.NilDecorator\", \"com.ibm.il.dse.cc.format.CCString\", \"com.ibm.il.dse.cc.format.CCXML\"]}, \"input_type\": null, \"output_type\": \"com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply\", \"wire_type\": \"com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReplyWire\", \"source_ids\": [\"com.ibm.dse.base.Context\", \"com.ibm.dse.base.Tag\", \"com.ibm.il.dse.cc.decorator.NilDecorator\", \"com.ibm.il.dse.cc.format.CCString\", \"com.ibm.il.dse.cc.format.CCXML\"]}}, \"operation_sources\": [{\"identity\": \"com.ibm.il.dse.cc.cut.CCDSEServerOperation\", \"content_hash\": \"fcaf68594b17326659d327bcc975553a231d2d1e62f7b741959b9e142603d288\", \"content\": \"package com.ibm.il.dse.cc.cut;\\n\\nimport com.ibm.dse.base.Context;\\nimport com.ibm.dse.base.DSEServerOperation;\\nimport com.ibm.dse.base.KeyedCollection;\\nimport com.ibm.dse.base.Tag;\\n\\nimport java.util.Hashtable;\\n\\n/**\\n * Base class for all WSBCC operations.\\n * Loaded from XML via initializeFrom(Tag). Channel handler calls:\\n *   1. unformat(requestXml)\\n *   2. execute()\\n *   3. format() -> returns response XML\\n *\\n * DO NOT instantiate directly. Defined as 'compound' in dse.ini operations section.\\n */\\npublic class CCDSEServerOperation extends DSEServerOperation {\\n\\n    private static final int RC_TIMEOUT = -99;\\n\\n    private String  operationName;\\n    private String  hostKey;\\n    private String  operationFields;\\n    private boolean writeToLog       = false;\\n    private boolean writeToOfecStat  = false;\\n    private boolean isSelectiveJournalising = false;\\n\\n    private boolean returnedErrorBodyChanged = false;\\n    private String  returnedErrorBodyChanger = null;\\n\\n    private Hashtable formats  = new Hashtable();\\n\\n    /**\\n     * Main execution loop. Called by channel handler after unformat().\\n     * Runs the opStep chain according to RC routing attributes.\\n     */\\n    @Override\\n    public void execute() throws Exception {\\n        // Pre-populate context with operationFields (key=value pairs)\\n        if (operationFields != null && !operationFields.isBlank()) {\\n            setFields(operationFields);\\n        }\\n\\n        // Remove opSteps that are not applicable to this channel (onlyFor filtering)\\n        removeOpStepsNotForThisChannel();\\n\\n        // Run the opStep chain\\n        int index = 0;\\n        do {\\n            KeyedCollection kc = getOperationStep(index);\\n            index = processOpStep(kc, operationName, index);\\n        } while (index != -1);\\n\\n        // Substitute error reply format if on{N}Return was triggered\\n        if (isReturnedErrorBodyChanged() && getReturnedErrorBodyChanger() != null) {\\n            // The channel handler reads csErrorReplyFormat instead of csReplyFormat\\n            substituteErrorReplyFormat();\\n        }\\n    }\\n\\n    /**\\n     * Routes from one opStep to the next based on the return code.\\n     * Priority order:\\n     *   1. on{N}Return  -- switch error reply format body before routing\\n     *   2. onTimeoutDo  -- if RC == RC_TIMEOUT\\n     *   3. on{N}Do      -- exact RC match\\n     *   4. onOtherDo    -- default when no on{N}Do matches\\n     *   5. onOtherDoDefault -- final fallback (logs warning)\\n     */\\n    private int processOpStep(KeyedCollection kc, String opName, int currentIndex) {\\n        // Implementation provided by WAS runtime\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n\\n    private void removeOpStepsNotForThisChannel() {\\n        // Reads onlyFor attribute on each opStep; removes non-matching steps\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n\\n    private void setFields(String operationFields) {\\n        // Parses \\\"KEY=VALUE,KEY2=VALUE2\\\" and sets each in context\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n\\n    private void substituteErrorReplyFormat() {\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n\\n    public boolean isReturnedErrorBodyChanged()  { return returnedErrorBodyChanged; }\\n    public String  getReturnedErrorBodyChanger() { return returnedErrorBodyChanger; }\\n    public Hashtable getFormats()                { return formats; }\\n    public String getHostKey()                   { return hostKey; }\\n    public void setHostKey(String v)             { this.hostKey = v; }\\n    public String getOperationFields()           { return operationFields; }\\n    public void setOperationFields(String v)     { this.operationFields = v; }\\n    public boolean isWriteToLog()                { return writeToLog; }\\n    public void setWriteToLog(boolean v)         { this.writeToLog = v; }\\n}\\n\"}], \"requirements\": {\"route-GetClientLinks\": \"{'on0Do': 'end', 'on4Do': 'NoLinksFound', 'on8Do': 'DatabaseError', 'onOtherDo': 'TechnicalError'}\", \"route-DatabaseError\": \"{'onOtherDo': 'end'}\", \"operation-flow\": \"Preserve the configured operation order, outcome/error branches and initialization\", \"operation-step-injection\": \"Receive all configured operation-step objects through the service constructor; never construct them inside the service. Preserve role bindings and configure required external resources.\"}, \"java_version\": 25, \"required_step_dependencies\": [{\"binding_id\": \"DatabaseError\", \"unit_id\": \"configured_step-3a42c4326e3d7f21467b61b2\", \"allowed_types\": [\"com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep\", \"com.company.generated.units.u3a42c4326e3d.OperationContext\"]}, {\"binding_id\": \"TechnicalError\", \"unit_id\": \"configured_step-9d214a54d7b141366dcd456c\", \"allowed_types\": [\"com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep\"]}, {\"binding_id\": \"GetClientLinks\", \"unit_id\": \"configured_step-42b95631a1866d97e7e0cbfa\", \"allowed_types\": [\"com.company.generated.units.u42b95631a186.GetClientLinksStep\"]}, {\"binding_id\": \"NoLinksFound\", \"unit_id\": \"configured_step-3643d2141e0adb1bddc660d7\", \"allowed_types\": [\"com.company.generated.units.u3643d2141e0a.NoLinksFoundStep\"]}], \"required_runtime_resources\": [], \"constructor_example\": \"// Structural example only. Real types, configuration and outcomes come from accepted APIs.\\nfinal class ExampleOperation {\\n    private final ExampleStep check;\\n    private final ExampleStep perform;\\n\\n    public ExampleOperation(ExampleStep check, ExampleStep perform) {\\n        this.check = java.util.Objects.requireNonNull(check);\\n        this.perform = java.util.Objects.requireNonNull(perform);\\n    }\\n\\n    public int execute(int input) {\\n        int result = this.check.execute(input);\\n        return result == 0 ? this.perform.execute(input) : result;\\n    }\\n}\\n\\ninterface ExampleStep {\\n    int execute(int input);\\n}\\n\", \"known_dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"com.fasterxml.jackson.dataformat\", \"artifact_id\": \"jackson-dataformat-xml\", \"version\": \"2.17.2\", \"scope\": \"compile\", \"reason\": \"Current target POM dependency\", \"required_classes\": []}, {\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-33e19da28f26\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for this run\", \"required_classes\": []}, {\"group_id\": \"com.company.migration\", \"artifact_id\": \"shared-26209c8451ff\", \"version\": \"1.0.0-4d092659baf5\", \"scope\": \"compile\", \"reason\": \"Accepted native behavior library for this run\", \"required_classes\": []}], \"testing_contract\": {\"requirement\": {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}, \"java_version\": 25, \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"rules\": [\"Keep each test focused on one evidenced outcome or side effect.\", \"Cover meaningful behavior across the bundle, not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\npublic class AdapterContractTest {\\n    @Test void adapterPassesTheIdentifierToItsDependency() throws Exception {\\n        Connection connection = mock(Connection.class);\\n        CallableStatement statement = mock(CallableStatement.class);\\n        when(connection.prepareCall(\\\"{call sample(?)}\\\")).thenReturn(statement);\\n        when(statement.getString(1)).thenReturn(\\\"sample-result\\\");\\n        try (CallableStatement call = connection.prepareCall(\\\"{call sample(?)}\\\")) {\\n            call.setString(1, \\\"sample-id\\\");\\n            call.execute();\\n            assertEquals(\\\"sample-result\\\", call.getString(1));\\n        }\\n        verify(statement).setString(1, \\\"sample-id\\\");\\n        verify(statement).execute();\\n        verify(statement).close();\\n    }\\n}\\n\"}, {\"path\": \"BusinessBehaviorTest.java\", \"content\": \"package example;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Reference structure only: derive real expected values from migration evidence. */\\npublic class BusinessBehaviorTest {\\n    interface NotificationPort { void send(String reference); }\\n    static class CompletionService {\\n        private final NotificationPort notifications;\\n        CompletionService(NotificationPort notifications) { this.notifications = notifications; }\\n        String complete(String reference) { notifications.send(reference); return reference; }\\n    }\\n\\n    @Test void returnsTheCompletedReference() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        CompletionService service = new CompletionService(notifications);\\n        assertEquals(\\\"sample-reference\\\", service.complete(\\\"sample-reference\\\"));\\n    }\\n\\n    @Test void notifiesTheCollaboratorOnce() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        new CompletionService(notifications).complete(\\\"sample-reference\\\");\\n        verify(notifications).send(\\\"sample-reference\\\");\\n        verifyNoMoreInteractions(notifications);\\n    }\\n}\\n\"}]}, \"final_validation_feedback\": null, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\", \"kind\": \"service\", \"assembly_phase\": \"single_route_test\", \"scenario\": {\"scenario_id\": \"GetClientLinks_DatabaseError\", \"description\": \"Executes GetClientLinksOp when a database error occurs (on8Do), routing through DatabaseError step to end while preserving operation flow and dependency injection.\", \"inputs\": [\"Valid GetClientLinksRequestXml triggering a database condition\"], \"dependency_setup\": [\"GetClientLinksStep injected via constructor and returns return code 8\", \"DataSource returns a valid Connection\", \"DatabaseErrorStep injected via constructor executes and sets error details in context\"], \"expected_outcome\": \"Standard error reply XML string formatted via StandardErrorRSFmtMapper for database error\", \"expected_side_effects\": [\"DatabaseErrorStep.execute is invoked on the context\", \"Error details are written to context and rendered into the error reply\"], \"covers\": [\"route-GetClientLinks\", \"route-DatabaseError\", \"operation-flow\", \"operation-step-injection\"], \"routes\": [{\"source\": \"GetClientLinks\", \"outcome\": \"on8Do\", \"target\": \"DatabaseError\"}, {\"source\": \"DatabaseError\", \"outcome\": \"onOtherDo\", \"target\": \"end\"}]}, \"assembled_code\": [{\"path\": \"src/main/java/com/company/generated/operations/GetClientLinksOpService.java\", \"content\": \"package com.company.generated.operations;\\n\\nimport com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep;\\nimport com.company.generated.units.u3a42c4326e3d.OperationContext;\\nimport com.company.generated.units.u3643d2141e0a.NoLinksFoundStep;\\nimport com.company.generated.units.u42b95631a186.GetClientLinksStep;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\\nimport com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep;\\n\\nimport javax.sql.DataSource;\\nimport java.sql.Connection;\\nimport java.util.List;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\npublic class GetClientLinksOpService {\\n\\n    private final GetClientLinksStep getClientLinksStep;\\n    private final NoLinksFoundStep noLinksFoundStep;\\n    private final DatabaseErrorStep databaseErrorStep;\\n    private final TechnicalErrorStep technicalError;\\n    private final DataSource dataSource;\\n\\n    private final GetClientLinksRequestUnformatMapper requestUnformatMapper;\\n    private final GetClientLinksRSFmtMapper replyFormatMapper;\\n    private final StandardErrorRSFmtMapper errorReplyFormatMapper;\\n\\n    public GetClientLinksOpService(\\n            GetClientLinksStep getClientLinksStep,\\n            NoLinksFoundStep noLinksFoundStep,\\n            DatabaseErrorStep databaseErrorStep,\\n            TechnicalErrorStep technicalError,\\n            DataSource dataSource) {\\n        this.getClientLinksStep = Objects.requireNonNull(getClientLinksStep);\\n        this.noLinksFoundStep = Objects.requireNonNull(noLinksFoundStep);\\n        this.databaseErrorStep = Objects.requireNonNull(databaseErrorStep);\\n        this.technicalError = Objects.requireNonNull(technicalError);\\n        this.dataSource = Objects.requireNonNull(dataSource);\\n\\n        this.requestUnformatMapper = new GetClientLinksRequestUnformatMapper();\\n        this.replyFormatMapper = new GetClientLinksRSFmtMapper();\\n        this.errorReplyFormatMapper = new StandardErrorRSFmtMapper();\\n    }\\n\\n    public String execute(GetClientLinksRequestXml requestXml) throws Exception {\\n        GetClientLinksRequest request = requestUnformatMapper.toBusinessInput(requestXml);\\n        OperationContext context = new OperationContext();\\n        context.setValueAt(\\\"ClientId\\\", request.getClientId());\\n        context.setValueAt(\\\"BankId\\\", request.getBankId());\\n        context.setValueAt(\\\"HOST_HEADER.HOST_KEY\\\", \\\"GCLN\\\");\\n\\n        int rc;\\n        try (Connection connection = dataSource.getConnection()) {\\n            context.setConnection(connection);\\n            rc = getClientLinksStep.execute(context);\\n        }\\n\\n        if (rc == 0) {\\n            String clientId = (String) context.getValueAt(\\\"ClientId\\\");\\n            List<Object> rawLinks = (List<Object>) context.getValueAt(\\\"Links\\\");\\n            List<GetClientLinksRSFmtMapper.LinkDto> linkDtos = new java.util.ArrayList<>();\\n\\n            if (rawLinks != null) {\\n                for (Object rawLink : rawLinks) {\\n                    if (rawLink instanceof Map) {\\n                        Map<?, ?> map = (Map<?, ?>) rawLink;\\n                        String linkId = (String) map.get(\\\"LinkId\\\");\\n                        String linkDescription = (String) map.get(\\\"LinkDescription\\\");\\n                        String linkUrl = (String) map.get(\\\"LinkUrl\\\");\\n                        Boolean isExternal = (Boolean) map.get(\\\"IsExternal\\\");\\n                        String iconCode = (String) map.get(\\\"IconCode\\\");\\n                        linkDtos.add(new GetClientLinksRSFmtMapper.LinkDto(linkId, linkDescription, linkUrl, isExternal, iconCode));\\n                    }\\n                }\\n            }\\n\\n            GetClientLinksRSFmtMapper.GetClientLinksResponse response = \\n                new GetClientLinksRSFmtMapper.GetClientLinksResponse(clientId, linkDtos);\\n            return replyFormatMapper.format(response);\\n        } else {\\n            String errorCategory;\\n            String errorNumber;\\n            String errorDescription;\\n\\n            if (rc == 4) {\\n                noLinksFoundStep.execute(context);\\n                errorCategory = noLinksFoundStep.getErrorCategory();\\n                errorNumber = noLinksFoundStep.getErrorNumber();\\n            } else if (rc == 8) {\\n                databaseErrorStep.execute(context);\\n                errorCategory = databaseErrorStep.getErrorCategory();\\n                errorNumber = databaseErrorStep.getErrorNumber();\\n            } else {\\n                technicalError.execute(context);\\n                errorCategory = technicalError.getErrorCategory();\\n                errorNumber = technicalError.getErrorNumber();\\n            }\\n\\n            errorDescription = (String) context.getValueAt(\\\"ErrorDescription\\\");\\n            String requestId = (String) context.getValueAt(\\\"RequestId\\\");\\n\\n            StandardErrorRSFmtMapper.ErrorReply errorReply = \\n                new StandardErrorRSFmtMapper.ErrorReply(errorCategory, errorNumber, errorDescription, requestId);\\n            return errorReplyFormatMapper.format(errorReply);\\n        }\\n    }\\n}\\n\"}], \"operation_contract\": {\"sources\": [{\"identity\": \"com.ibm.il.dse.cc.cut.CCDSEServerOperation\", \"content_hash\": \"fcaf68594b17326659d327bcc975553a231d2d1e62f7b741959b9e142603d288\"}], \"units\": [{\"unit_id\": \"configured_step-3a42c4326e3d7f21467b61b2\", \"apis\": [{\"type_name\": \"com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\", \"public java.lang.String getErrorCategory()\", \"public java.lang.String getErrorNumber()\"]}, {\"type_name\": \"com.company.generated.units.u3a42c4326e3d.OperationContext\", \"method_signatures\": [\"public java.lang.Object getValueAt(java.lang.String)\", \"public void setValueAt(java.lang.String, java.lang.Object)\", \"public void setConnection(java.sql.Connection)\", \"public java.sql.Connection getConnection()\"]}], \"dependency_units\": [], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-3a42c4326e3d7f21467b61b2\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.common.MapErrorByValueAlways\"]}, {\"unit_id\": \"configured_step-9d214a54d7b141366dcd456c\", \"apis\": [{\"type_name\": \"com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\", \"public java.lang.String getErrorCategory()\", \"public java.lang.String getErrorNumber()\"]}], \"dependency_units\": [\"configured_step-3a42c4326e3d7f21467b61b2\"], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-9d214a54d7b141366dcd456c\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.common.MapErrorByValueAlways\"]}, {\"unit_id\": \"configured_step-42b95631a1866d97e7e0cbfa\", \"apis\": [{\"type_name\": \"com.company.generated.units.u42b95631a186.GetClientLinksStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\"]}], \"dependency_units\": [\"configured_step-3a42c4326e3d7f21467b61b2\"], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-42b95631a1866d97e7e0cbfa\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.internet.db.GetClientLinksSP\"]}, {\"unit_id\": \"co