{"files": [{"path": "src/main/java/com/company/generated/units/u15edb87ae7f6/ValidateClientLinksFetchStep.java", "content": "package com.company.generated.units.u15edb87ae7f6;\n\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\nimport java.net.URI;\nimport java.net.http.HttpClient;\nimport java.net.http.HttpRequest;\nimport java.net.http.HttpResponse;\nimport java.time.Duration;\nimport java.util.Objects;\n\npublic class ValidateClientLinksFetchStep {\n\n    private final String baseUrl;\n    private final HttpClient httpClient;\n    private final GetClientLinksRequestUnformatMapper requestMapper;\n    private final GetClientLinksRSFmtMapper successMapper;\n    private final StandardErrorRSFmtMapper errorMapper;\n\n    public ValidateClientLinksFetchStep(String baseUrl,\n                                         HttpClient httpClient,\n                                         GetClientLinksRequestUnformatMapper requestMapper,\n                                         GetClientLinksRSFmtMapper successMapper,\n                                         StandardErrorRSFmtMapper errorMapper) {\n        this.baseUrl = Objects.requireNonNull(baseUrl, \"baseUrl\");\n        this.httpClient = Objects.requireNonNull(httpClient, \"httpClient\");\n        this.requestMapper = Objects.requireNonNull(requestMapper, \"requestMapper\");\n        this.successMapper = Objects.requireNonNull(successMapper, \"successMapper\");\n        this.errorMapper = Objects.requireNonNull(errorMapper, \"errorMapper\");\n    }\n\n    public int execute(String clientId, String bankId) throws Exception {\n        GetClientLinksRequestXml xmlReq = new GetClientLinksRequestXml();\n        xmlReq.clientId = clientId;\n        xmlReq.bankId = bankId;\n        GetClientLinksRequest request = requestMapper.toBusinessInput(xmlReq);\n\n        StringBuilder sb = new StringBuilder();\n        sb.append(\"<GetClientLinks>\");\n        sb.append(\"<ClientId>\").append(escapeXml(request.getClientId())).append(\"</ClientId>\");\n        sb.append(\"<BankId>\").append(escapeXml(request.getBankId())).append(\"</BankId>\");\n        sb.append(\"</GetClientLinks>\");\n\n        String urlStr = baseUrl + (baseUrl.endsWith(\"/\") ? \"\" : \"/\") + \"operations/INTERNET/GetClientLinksOp\";\n\n        HttpRequest httpRequest = HttpRequest.newBuilder()\n                .uri(URI.create(urlStr))\n                .timeout(Duration.ofSeconds(30))\n                .header(\"Content-Type\", \"application/xml\"))\n                .POST(HttpRequest.BodyPublishers.ofString(sb.toString()))\n                .build();\n\n        HttpResponse<String> response = httpClient.send(httpRequest, HttpResponse.BodyHandlers.ofString());\n        String body = response.body();\n\n        if (body != null && body.contains(\"ErrorReply\")) {\n            errorMapper.unformat(body);\n            return 1;\n        } else if (body != null && body.contains(\"GetClientLinksResponse\")) {\n            successMapper.unformat(body);\n            return 0;\n        }\n        return 0;\n    }\n\n    private String escapeXml(String val) {\n        if (val == null) return \"\";\n        return val.replace(\"&\", \"&amp;\")\n                  .replace(\"<\", \"&lt;\")\n                  .replace(\">\", \"&gt;\")\n                  .replace(\"\\\"\", \"&quot;\")\n                  .replace(\"'\", \"&apos;\");\n    }\n}"}, {"path": "src/test/java/com/company/generated/units/u15edb87ae7f6/ValidateClientLinksFetchStepBusinessTest.java", "content": "package com.company.generated.units.u15edb87ae7f6;\n\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\nimport org.junit.jupiter.api.BeforeEach;\nimport org.junit.jupiter.api.Test;\n\nimport java.net.http.HttpClient;\nimport java.net.http.HttpRequest;\nimport java.net.http.HttpResponse;\n\nimport static org.junit.jupiter.api.Assertions.assertEquals;\nimport static org.mockito.ArgumentMatchers.any;\nimport static org.mockito.Mockito.mock;\nimport static org.mockito.Mockito.when;\n\npublic class ValidateClientLinksFetchStepBusinessTest {\n\n    private HttpClient httpClient;\n    private GetClientLinksRequestUnformatMapper requestMapper;\n    private GetClientLinksRSFmtMapper successMapper;\n    private StandardErrorRSFmtMapper errorMapper;\n    private ValidateClientLinksFetchStep step;\n\n    @BeforeEach\n    public void setUp() {\n        httpClient = mock(HttpClient.class);\n        requestMapper = mock(GetClientLinksRequestUnformatMapper.class);\n        successMapper = mock(GetClientLinksRSFmtMapper.class);\n        errorMapper = mock(StandardErrorRSFmtMapper.class);\n        step = new ValidateClientLinksFetchStep(\"http://localhost:8080\", httpClient, requestMapper, successMapper, errorMapper);\n    }\n\n    @Test\n    public void testSuccessfulFetchReturnsZero() throws Exception {\n        GetClientLinksRequest req = new GetClientLinksRequest(\"123\", \"001\");\n        when(requestMapper.toBusinessInput(any())).thenReturn(req);\n\n        String successXml = \"<GetClientLinksResponse><ClientId>123</ClientId><Links/></GetClientLinksResponse>\";\n        @SuppressWarnings(\"unchecked\")\n        HttpResponse<String> resp = mock(HttpResponse.class);\n        when(resp.body()).thenReturn(successXml);\n        when(httpClient.send(any(HttpRequest.class), any(HttpResponse.BodyHandler.class))).thenReturn(resp);\n\n        GetClientLinksRSFmtMapper.GetClientLinksResponse parsed = new GetClientLinksRSFmtMapper.GetClientLinksResponse(\"123\", java.util.List.of());\n        when(successMapper.unformat(successXml)).thenReturn(parsed);\n\n        int result = step.execute(\"123\", \"001\");\n        assertEquals(0, result);\n    }\n\n    @Test\n    public void testBusinessErrorReturnsNonZero() throws Exception {\n        GetClientLinksRequest req = new GetClientLinksRequest(\"123\", \"001\");\n        when(requestMapper.toBusinessInput(any())).thenReturn(req);\n\n        String errorXml = \"<ErrorReply><ErrorCategory>CAT</ErrorCategory><ErrorNumber>001</ErrorNumber><ErrorDescription>ERR</ErrorDescription><RequestId>1</RequestId></ErrorReply>\";\n        @SuppressWarnings(\"unchecked\")\n        HttpResponse<String> resp = mock(HttpResponse.class);\n        when(resp.body()).thenReturn(errorXml);\n        when(httpClient.send(any(HttpRequest.class), any(HttpResponse.BodyHandler.class))).thenReturn(resp);\n\n        StandardErrorRSFmtMapper.ErrorReply errReply = new StandardErrorRSFmtMapper.ErrorReply(\"CAT\", \"001\", \"ERR\", \"1\");\n        when(errorMapper.unformat(errorXml)).thenReturn(errReply);\n\n        int result = step.execute(\"123\", \"001\");\n        assertEquals(1, result);\n    }\n}"}, {"path": "src/test/java/com/company/generated/units/u15edb87ae7f6/ValidateClientLinksFetchStepAdapterTest.java", "content": "package com.company.generated.units.u15edb87ae7f6;\n\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\nimport org.junit.jupiter.api.BeforeEach;\nimport org.junit.jupiter.api.Test;\n\nimport java.io.IOException;\nimport java.net.http.HttpClient;\nimport java.net.http.HttpRequest;\nimport java.net.http.HttpResponse;\n\nimport static org.junit.jupiter.api.Assertions.assertThrows;\nimport static org.mockito.ArgumentMatchers.any;\nimport static org.mockito.Mockito.mock;\nimport static org.mockito.Mockito.when;\n\npublic class ValidateClientLinksFetchStepAdapterTest {\n\n    private HttpClient httpClient;\n    private GetClientLinksRequestUnformatMapper requestMapper;\n    private GetClientLinksRSFmtMapper successMapper;\n    private StandardErrorRSFmtMapper errorMapper;\n    private ValidateClientLinksFetchStep step;\n\n    @BeforeEach\n    public void setUp() {\n        httpClient = mock(HttpClient.class);\n        requestMapper = mock(GetClientLinksRequestUnformatMapper.class);\n        successMapper = mock(GetClientLinksRSFmtMapper.class);\n        errorMapper = mock(StandardErrorRSFmtMapper.class);\n        step = new ValidateClientLinksFetchStep(\"http://localhost:8080\", httpClient, requestMapper, successMapper, errorMapper);\n    }\n\n    @Test\n    public void testTransportFailureThrowsException() throws Exception {\n        GetClientLinksRequest req = new GetClientLinksRequest(\"123\", \"001\");\n        when(requestMapper.toBusinessInput(any())).thenReturn(req);\n\n        when(httpClient.send(any(HttpRequest.class), any(HttpResponse.BodyHandler.class)))\n                .thenThrow(new IOException(\"Connection timeout\"));\n\n        assertThrows(Exception.class, () -> step.execute(\"123\", \"001\"));\n    }\n}"}, {"path": "src/test/java/com/company/generated/units/u15edb87ae7f6/ValidateClientLinksFetchOperationCallTest.java", "content": "package com.company.generated.units.u15edb87ae7f6;\n\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\nimport org.junit.jupiter.api.BeforeEach;\nimport org.junit.jupiter.api.Test;\n\nimport java.net