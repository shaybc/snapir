).append(\\\\\\\"</ClientId>\\\\\\\");\\\\n        sb.append(\\\\\\\"<BankId>\\\\\\\").append(escapeXml(request.getBankId())).append(\\\\\\\"</BankId>\\\\\\\");\\\\n        sb.append(\\\\\\\"</GetClientLinks>\\\\\\\");\\\\n\\\\n        HttpHeaders headers = new HttpHeaders();\\\\n        headers.setContentType(MediaType.APPLICATION_XML);\\\\n        HttpEntity<String> entity = new HttpEntity<>(sb.toString(), headers);\\\\n\\\\n        String url = baseUrl + (baseUrl.endsWith(\\\\\\\"/\\\\\\\") ? \\\\\\\"\\\\\\\" : \\\\\\\"/\\\\\\\") + \\\\\\\"operations/INTERNET/GetClientLinksOp\\\\\\\";\\\\n\\\\n        try {\\\\n            ResponseEntity<String> response = restTemplate.exchange(url, HttpMethod.POST, entity, String.class);\\\\n            String body = response.getBody();\\\\n            if (body != null && body.contains(\\\\\\\"ErrorReply\\\\\\\")) {\\\\n                errorMapper.unformat(body);\\\\n                return 1;\\\\n            } else if (body != null && body.contains(\\\\\\\"GetClientLinksResponse\\\\\\\")) {\\\\n                successMapper.unformat(body);\\\\n                return 0;\\\\n            }\\\\n            return 0;\\\\n        } catch (RestClientException e) {\\\\n            throw new RuntimeException(\\\\\\\"Transport failure or timeout while calling GetClientLinksOp\\\\\\\", e);\\\\n        }\\\\n    }\\\\n\\\\n    private String escapeXml(String val) {\\\\n        if (val == null) return \\\\\\\"\\\\\\\";\\\\n        return val.replace(\\\\\\\"&\\\\\\\", \\\\\\\"&amp;\\\\\\\")\\\\n                  .replace(\\\\\\\"<\\\\\\\", \\\\\\\"&lt;\\\\\\\")\\\\n                  .replace(\\\\\\\">\\\\\\\", \\\\\\\"&gt;\\\\\\\")\\\\n                  .replace(\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\", \\\\\\\"&quot;\\\\\\\")\\\\n                  .replace(\\\\\\\"'\\\\\\\", \\\\\\\"&apos;\\\\\\\");\\\\n    }\\\\n}\\\\n\\\"\\n    },\\n    {\\n      \\\"path\\\": \\\"src/test/java/com/company/generated/units/u15edb87ae7f6/ValidateClientLinksFetchSte