 contract tests; mock external interfaces rather than hand implement them.\"}, \"java_version\": 25, \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"rules\": [\"Keep each test focused on one evidenced outcome or side effect.\", \"Cover meaningful behavior across the bundle, not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\npublic class AdapterContractTest {\\n    @Test void adapterPassesTheIdentifierToItsDependency() throws Exception {\\n        Connection connection = mock(Connection.class);\\n        CallableStatement statement = mock(CallableStatement.class);\\n        when(connection.prepareCall(\\\"{call sample(?)}\\\")).thenReturn(statement);\\n        when(statement.getString(1)).thenReturn(\\\"sample-result\\\");\\n        try (CallableStatement call = connection.prepareCall(\\\"{call sample(?)}\\\")) {\\n            call.setString(1, \\\"sample-id\\\");\\n            call.execute();\\n            assertEquals(\\\"sample-result\\\", call.getString(1));\\n        }\\n        verify(statement).setString(1, \\\"sample-id\\\");\\n        verify(statement).execute();\\n        verify(statement).close();\\n    }\\n}\\n\"}, {\"path\": \"BusinessBehaviorTest.java\", \"content\": \"package example;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Reference structure only: derive real expected values from migration evidence. */\\npublic class BusinessBehaviorTest {\\n    interface NotificationPort { void send(String reference); }\\n    static class CompletionService {\\n        private final NotificationPort notifications;\\n        CompletionService(NotificationPort notifications) { this.notifications = notifications; }\\n        String complete(String reference) { notifications.send(reference); return reference; }\\n    }\\n\\n    @Test void returnsTheCompletedReference() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        CompletionService service = new CompletionService(notifications);\\n        assertEquals(\\\"sample-reference\\\", service.complete(\\\"sample-reference\\\"));\\n    }\\n\\n    @Test void notifiesTheCollaboratorOnce() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        new CompletionService(notifications).complete(\\\"sample-reference\\\");\\n        verify(notifications).send(\\\"sample-reference\\\");\\n        verifyNoMoreInteractions(notifications);\\n    }\\n}\\n\"}]}, \"final_validation_feedback\": null, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\"}, \"generated_bundle\": {\"files\": [{\"path\": \"src/main/java/com/company/generated/units/u561a01497abb/GetClientLinksRequest.java\", \"content\": \"package com.company.generated.units.u561a01497abb;\\n\\npublic class GetClientLinksRequest {\\n    private String clientId;\\n    private String bankId;\\n\\n    public GetClientLinksRequest() {\\n    }\\n\\n    public GetClientLinksRequest(String clientId, String bankId) {\\n        this.clientId = clientId;\\n        this.bankId = bankId;\\n    }\\n\\n    public String getClientId() {\\n        return clientId;\\n    }\\n\\n    public void setClientId(String clientId) {\\n        this.clientId = clientId;\\n    }\\n\\n    public String getBankId() {\\n        return bankId;\\n    }\\n\\n    public void setBankId(String bankId) {\\n        this.bankId = bankId;\\n    }\\n}\\n\"}, {\"path\": \"src/main/java/com/company/generated/units/u561a01497abb/GetClientLinksRequestXml.java\", \"content\": \"package com.company.generated.units.u561a01497abb;\\n\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement;\\n\\n@JacksonXmlRootElement(localName = \\\"GetClientLinks\\\")\\npublic class GetClientLinksRequestXml {\\n    @JacksonXmlProperty(localName = \\\"ClientId\\\")\\n    public String clientId;\\n\\n    @JacksonXmlProperty(localName = \\\"BankId\\\")\\n    public String bankId;\\n}\\n\"}, {\"path\": \"src/main/java/com/company/generated/units/u561a01497abb/GetClientLinksRequestUnformatMapper.java\", \"content\": \"package com.company.generated.units.u561a01497abb;\\n\\nimport com.fasterxml.jackson.dataformat.xml.XmlMapper;\\nimport com.fasterxml.jackson.dataformat.xml.ser.ToXmlGenerator;\\nimport java.util.Objects;\\n\\npublic class GetClientLinksRequestUnformatMapper {\\n    private final XmlMapper xmlMapper;\\n\\n    public GetClientLinksRequestUnformatMapper() {\\n        this.xmlMapper = new XmlMapper();\\n        this.xmlMapper.configure(ToXmlGenerator.Feature.WRITE_XML_DECLARATION, false);\\n    }\\n\\n    public GetClientLinksRequest toBusinessInput(GetClientLinksRequestXml wire) {\\n        Objects.requireNonNull(wire, \\\"Wire model cannot be null\\\");\\n\\n        // CCMandatory validation on ClientId\\n        if (wire.clientId == null || wire.clientId.trim().isEmpty()) {\\n            throw new IllegalArgumentException(\\\"ClientId is mandatory\\\");\\n        }\\n\\n        // CCPadding unformat on BankId: padChar='0', length=4 -> strip leading '0' characters (padLeft=true)\\n        String bankId = wire.bankId;\\n        if (bankId != null) {\\n            bankId = bankId.replaceFirst(\\\"^0+\\\", \\\"\\\");\\n        }\\n\\n        return new GetClientLinksRequest(wire.clientId, bankId);\\n    }\\n\\n    public GetClientLinksRequest unformat(String xml) throws Exception {\\n        GetClientLinksRequestXml wire = xmlMapper.readValue(xml, GetClientLinksRequestXml.class);\\n        return toBusinessInput(wire);\\n    }\\n}\\n\"}, {\"path\": \"src/test/java/com/company/generated/units/u561a01497abb/GetClientLinksRequestUnformatMapperTest.java\", \"content\": \"package com.company.generated.units.u561a01497abb;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.*;\\n\\npublic class GetClientLinksRequestUnformatMapperTest {\\n    private final GetClientLinksRequestUnformatMapper mapper = new GetClientLinksRequestUnformatMapper();\\n\\n    @Test\\n    public void unformatsValidRequestXml() throws Exception {\\n        String xml = \\\"<GetClientLinks><ClientId>12345</ClientId><BankId>0012</BankId></GetClientLinks>\\\";\\n        GetClientLinksRequest req = mapper.unformat(xml);\\n        assertNotNull(req);\\n        assertEquals(\\\"12345\\\", req.getClientId());\\n        assertEquals(\\\"12\\\", req.getBankId());\\n    }\\n\\n    @Test\\n    public void failsWhenClientIdIsMissingOrEmpty() {\\n        GetClientLinksRequestXml wire = new GetClientLinksRequestXml();\\n        wire.clientId = \\\"   \\\";\\n        wire.bankId = \\\"0012\\\";\\n        assertThrows(IllegalArgumentException.class, () -> mapper.toBusinessInput(wire));\\n    }\\n\\n    @Test\\n    public void stripsPaddingCorrectlyFromBankId() throws Exception {\\n        String xml = \\\"<GetClientLinks><ClientId>C001</ClientId><BankId>0005</BankId></GetClientLinks>\\\";\\n        GetClientLinksRequest req = mapper.unformat(xml);\\n        assertEquals(\\\"5\\\", req.getBankId());\\n    }\\n}\\n\"}], \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"JUnit Jupiter tests and execution engine\", \"required_classes\": [\"org.junit.jupiter.api.Test\", \"org.junit.jupiter.api.Assertions\"]}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Mockito for testing\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Byte