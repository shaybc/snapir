erve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"response_format-66bf2c108225fb63eb2a0cbe\", \"com.ibm.dse.base.Context\", \"com.ibm.dse.base.Tag\", \"com.ibm.il.dse.cc.decorator.NilDecorator\", \"com.ibm.il.dse.cc.format.CCString\", \"com.ibm.il.dse.cc.format.CCXML\"], \"converted_dependency_apis\": [], \"java_version\": 25, \"native_package\": \"com.company.generated.units.u66bf2c108225\", \"artifact_owner\": \"shared-26209c8451ff\", \"artifact_targets\": {\"INTERNET/GetClientLinksOp\": \"C:\\\\GitHub\\\\shaybc\\\\snapir\\\\work\\\\migration_runs\\\\bank-operation-calls-e2e-20261019\\\\generated\\\\behavior-libraries\\\\shared-26209c8451ff\"}, \"managed_dependencies\": [], \"known_dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"testing_contract\": {\"requirement\": {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}, \"java_version\": 25, \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"rules\": [\"Keep each test focused on one evidenced outcome or side effect.\", \"Cover meaningful behavior across the bundle, not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\npublic class AdapterContractTest {\\n    @Test void adapterPassesTheIdentifierToItsDependency() throws Exception {\\n        Connection connection = mock(Connection.class);\\n        CallableStatement statement = mock(CallableStatement.class);\\n        when(connection.prepareCall(\\\"{call sample(?)}\\\")).thenReturn(statement);\\n        when(statement.getString(1)).thenReturn(\\\"sample-result\\\");\\n        try (CallableStatement call = connection.prepareCall(\\\"{call sample(?)}\\\")) {\\n            call.setString(1, \\\"sample-id\\\");\\n            call.execute();\\n            assertEquals(\\\"sample-result\\\", call.getString(1));\\n        }\\n        verify(statement).setString(1, \\\"sample-id\\\");\\n        verify(statement).execute();\\n        verify(statement).close();\\n    }\\n}\\n\"}, {\"path\": \"BusinessBehaviorTest.java\", \"content\": \"package example;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Reference structure only: derive real expected values from migration evidence. */\\npublic class BusinessBehaviorTest {\\n    interface NotificationPort { void send(String reference); }\\n    static class CompletionService {\\n        private final NotificationPort notifications;\\n        CompletionService(NotificationPort notifications) { this.notifications = notifications; }\\n        String complete(String reference) { notifications.send(reference); return reference; }\\n    }\\n\\n    @Test void returnsTheCompletedReference() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        CompletionService service = new CompletionService(notifications);\\n        assertEquals(\\\"sample-reference\\\", service.complete(\\\"sample-reference\\\"));\\n    }\\n\\n    @Test void notifiesTheCollaboratorOnce() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        new CompletionService(notifications).complete(\\\"sample-reference\\\");\\n        verify(notifications).send(\\\"sample-reference\\\");\\n        verifyNoMoreInteractions(notifications);\\n    }\\n}\\n\"}]}, \"final_validation_feedback\": null, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\", \"versioned_requirements\": [{\"requirement_id\": \"business\", \"version\": 1, \"description\": \"Preserve this complete configured unit's evidenced behavior\"}, {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}], \"format_reference_example\": {\"example_version\": 1, \"verified_platform\": {\"java_version\": 25, \"jackson_xml_version\": \"2.15.2\", \"junit_version\": \"5.10.0\"}, \"files\": [{\"path\": \"src/main/java/example/format/FormatExample.java\", \"content\": \"package example.format;\\n\\nimport com.fasterxml.jackson.dataformat.xml.XmlMapper;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlText;\\nimport com.fasterxml.jackson.dataformat.xml.ser.ToXmlGenerator;\\nimport java.math.BigDecimal;\\nimport java.time.LocalDate;\\nimport java.time.format.DateTimeFormatter;\\nimport java.util.Objects;\\n\\n/** Illustrative rules only: width three, implied two decimals, basic [REDACTED] date and nullable child. */\\npublic final class FormatExample {\\n    private final XmlMapper mapper;\\n\\n    public FormatExample() {\\n        mapper = new XmlMapper();\\n        // XML-specific features belong to ToXmlGenerator, not SerializationFeature.\\n        mapper.configure(ToXmlGenerator.Feature.WRITE_XML_DECLARATION, false);\\n    }\\n\\n    public record Value(String code, BigDecimal amount, LocalDate date, Boolean enabled) {}\\n\\n    @JacksonXmlRootElement(localName = \\\"Envelope\\\")\\n    public static class Wire {\\n        @JacksonXmlProperty(localName = \\\"Code\\\") public String code;\\n        @JacksonXmlProperty(localName = \\\"Amount\\\") public String amount;\\n        @JacksonXmlProperty(localName = \\\"Date\\\") public String date;\\n        @JacksonXmlProperty(localName = \\\"Enabled\\\") public NullableText enabled;\\n    }\\n\\n    /** A nil attribute belongs to this child element, never to the populated envelope. */\\n    public static class NullableText {\\n        @JacksonXmlText public String value;\\n        @JacksonXmlProperty(localName = \\\"nil\\\", isAttribute = true,\\n            namespace = \\\"http://www.w3.org/2001/XMLSchema-instance\\\") public String nil;\\n    }\\n\\n    public String format(Value value) throws Exception {\\n        Objects.requireNonNull(value, \\\"Example requires a populated root\\\");\\n        Wire wire = new Wire();\\n        String code = Objects.requireNonNull(value.code());\\n        wire.code = code.length() < 3 ? \\\" \\\".repeat(3 - code.length()) + code : code;\\n        wire.amount = value.amount().movePointRight(2).toBigIntegerExact().toString();\\n        wire.date = value.date().format(DateTimeFormatter.BASIC_ISO_DATE);\\n        wire.enabled = new NullableText();\\n        if (value.enabled() == null) {\\n            wire.enabled.nil = \\\"true\\\";\\n        } else {\\n            wire.enabled.value = value.enabled().toString();\\n        }\\n        return mapper.writeValueAsString(wire);\\n    }\\n\\n    public Value unformat(String xml) throws Exception {\\n        Wire wire = mapper.readValue(xml, Wire.class);\\n        Objects.requireNonNull(wire, \\\"Example requires a populated root\\\");\\n        Boolean enabled = null;\\n        if (wire.enabled != null && !\\\"true\\\".equals(wire.enabled.nil)) {\\n            if (!\\\"true\\\".equals(wire.enabled.value) && !\\\"false\\\".equals(wire.enabled.value)) {\\n                throw new IllegalArgumentException(\\\"Expected true, false or a nil child\\\");\\n            }\\n            enabled = Boolean.valueOf(wire.enabled.value);\\n        }\\n        return new Value(wire.code.replaceFirst(\\\"^ +\\\", \\\"\\\"),\\n            new BigDecimal(wire.amount).movePointLeft(2),\\n            LocalDate.parse(wire.date, DateTimeFormatter.BASIC_ISO_DATE), enabled);\\n    }\\n}\\n\"}, {\"path\": \"src/test/java/example/format/FormatExampleTest.java\", \"content\": \"package example.format;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.*;\\nimport java.io.ByteArrayInputStream;\\nimport java.math.BigDecimal;\\nimport java.nio.charset.StandardCharsets;\\nimport java.time.LocalDate;\\nimport javax.xml.parsers.DocumentBuilderFactory;\\nimport org.w3c.dom.Element;\\n\\n/** Use real Jackson/mapper objects; derive real migration expectations from its evidence. */\\npublic class FormatExampleTest {\\n    private final FormatExample mapper = new FormatExample();\\n    private static final String XSI = \\\"http://www.w3.org/2001/XMLSchema-instance\\\";\\n\\n    private FormatExample.Value value(String code, Boolean enabled) {\\n        return new FormatExample.Value(code, new BigDecimal(\\\"12.50\\\"), LocalDate.of(2024, 1, 2), enabled);\\n    }\\n\\n    private Element root(String xml) throws Exception {\\n        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\\n        factory.setNamespaceAware(true);\\n        return factory.newDocumentBuilder().parse(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))).getDocumentElement();\\n    }\\n\\n    private String text(Element root, String name) {\\n        return root.getElementsByTagName(name).item(0).getTextContent();\\n    }\\n\\n    @Test public void serializationPreservesStructureAndAppliesConfirmedConversions() throws Exception {\\n        String xml = mapper.format(value(\\\"A\\\", false));\\n        Element root = root(xml);\\n        assertEquals(\\\"Envelope\\\", root.getTagName());\\n        assertFalse(xml.startsWith(\\\"<?xml\\\"));\\n        assertFalse(root.hasAttributeNS(XSI, \\\"nil\\\"));\\n        assertEquals(\\\"  A\\\", text(root, \\\"Code\\\"));\\n        assertEquals(\\\"1250\\\", text(root, \\\"Amount\\\"));\\n        assertEquals(\\\"20240102\\\", text(root, \\\"Date\\\"));\\n        assertEquals(\\\"false\\\", text(root, \\\"Enabled\\\"));\\n    }\\n\\n    @Test public void paddingUsesTargetLengthRatherThanAlwaysAddingCharacters() throws Exception {\\n        assertEquals(\\\"ABC\\\", text(root(mapper.format(value(\\\"ABC\\\", true))), \\\"Code\\\"));\\n        assertEquals(\\\"ABCD\\\", text(root(mapper.format(value(\\\"ABCD\\\", true))), \\\"Code\\\"));\\n    }\\n\\n    @Test public void parsingHasIndependentEvidenceBasedExpectations() throws Exception {\\n        String xml = \\\"<Envelope><Code>  A</Code><Amount>1250</Amount><Date>20240102</Date><Enabled>true</Enabled></Envelope>\\\";\\n        FormatExample.Value result = mapper.unformat(xml);\\n        assertEquals(\\\"A\\\", result.code());\\n        assertEquals(new BigDecimal(\\\"12.50\\\"), result.amount());\\n        assertEquals(LocalDate.of(2024, 1, 2), result.date());\\n        assertTrue(result.enabled());\\n    }\\n\\n    @Test public void nullableChildKeepsPopulatedParentAndSiblings() throws Exception {\\n        String xml = mapper.format(value(\\\"ABC\\\", null));\\n        Element root = root(xml);\\n        assertFalse(root.hasAttributeNS(XSI, \\\"nil\\\"));\\n        Element child = (Element) root.getElementsByTagName(\\\"Enabled\\\").item(0);\\n        assertEquals(\\\"true\\\", child.getAttributeNS(XSI, \\\"nil\\\"));\\n        assertEquals(\\\"ABC\\\", text(root, \\\"Code\\\"));\\n        FormatExample.Value result = mapper.unformat(xml);\\n        assertNotNull(result);\\n        assertEquals(\\\"ABC\\\", result.code());\\n        assertNull(result.enabled());\\n    }\\n\\n    @Test public void evidencedMissingEmptyAndInvalidValuesRemainDistinct() throws Exception {\\n        String prefix = \\\"<Envelope><Code>ABC</Code><Amount>1250</Amount><Date>20240102</Date>\\\";\\n        assertNull(mapper.unformat(prefix + \\\"</Envelope>\\\").enabled());\\n        assertThrows(IllegalArgumentException.class, () -> mapper.unformat(prefix + \\\"<Enabled></Enabled></Envelope>\\\"));\\n        assertThrows(IllegalArgumentException.class, () -> mapper.unformat(prefix + \\\"<Enabled>invalid</Enabled></Envelope>\\\"));\\n        assertThrows(NumberFormatException.class, () -> mapper.unformat(prefix.replace(\\\"1250\\\", \\\"invalid\\\") + \\\"</Envelope>\\\"));\\n    }\\n\\n    @Test public void roundTripIsAdditionalEvidenceRatherThanTheOnlyTest() throws Exception {\\n        FormatExample.Value original = value(\\\"ABC\\\", true);\\n        assertEquals(original, mapper.unformat(mapper.format(original)));\\n    }\\n}\\n\"}]}, \"schema\": {\"$defs\": {\"MavenDependency\": {\"additionalProperties\": false, \"description\": \"Identify a pinned Maven artifact and the APIs that justify its inclusion.\", \"properties\": {\"group_id\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Group Id\", \"type\": \"string\"}, \"artifact_id\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Artifact Id\", \"type\": \"string\"}, \"version\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Version\", \"type\": \"string\"}, \"scope\": {\"default\": \"compile\", \"enum\": [\"compile\", \"runtime\", \"provided\", \"test\"], \"title\": \"Scope\", \"type\": \"string\"}, \"reason\": {\"minLength\": 1, \"title\": \"Reason\", \"type\": \"string\"}, \"required_classes\": {\"items\": {\"type\": \"string\"}, \"title\": \"Required Classes\", \"type\": \"array\"}}, \"required\": [\"group_id\", \"artifact_id\", \"version\", \"reason\"], \"title\": \"MavenDependency\", \"type\": \"object\"}, \"NativeApiContract\": {\"additionalProperties\": false, \"description\": \"A planned native type and exact public methods it must expose.\", \"properties\": {\"type_name\": {\"title\": \"Type Name\", \"type\": \"string\"}, \"method_signatures\": {\"items\": {\"type\": \"string\"}, \"title\": \"Method Signatures\", \"type\": \"array\"}}, \"required\": [\"type_name\"], \"title\": \"NativeApiContract\", \"type\": \"object\"}, \"NativeSourceFile\": {\"additionalProperties\": false, \"description\": \"One text Java source under a safe Maven source directory.\", \"properties\": {\"path\": {\"title\": \"Path\", \"type\": \"string\"}, \"content\": {\"title\": \"Content\", \"type\": \"string\"}}, \"required\": [\"path\", \"content\"], \"title\": \"NativeSourceFile\", \"type\": \"object\"}, \"OperationDataContract\": {\"additionalProperties\": false, \"description\": \"Reconciled explicit Java data types and all configured-unit interfaces.\", \"properties\": {\"sources\": {\"items\": {\"additionalProperties\": true, \"type\": \"object\"}, \"minItems\": 1, \"title\": \"Sources\", \"type\": \"array\"}, \"units\": {\"items\": {\"$ref\": \"#/$defs/UnitContract\"}, \"minItems\": 1, \"title\": \"Units\", \"type\": \"array\"}, \"service_api\": {\"$ref\": \"#/$defs/NativeApiContract\"}, \"request_type\": {\"title\": \"Request Type\", \"type\": \"string\"}, \"success_type\": {\"title\": \"Success Type\", \"type\": \"string\"}, \"error_type\": {\"title\": \"Error Type\", \"type\": \"string\"}, \"request_wire_type\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Request Wire Type\"}, \"success_wire_type\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Success Wire Type\"}, \"error_wire_type\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Error Wire Type\"}, \"service_requirements\": {\"additionalProperties\": {\"type\": \"string\"}, \"title\": \"Service Requirements\", \"type\": \"object\"}, \"step_dependencies\": {\"items\": {\"$ref\": \"#/$defs/OperationDependency\"}, \"title\": \"Step Dependencies\", \"type\": \"array\"}, \"runtime_resources\": {\"items\": {\"$ref\": \"#/$defs/OperationResource\"}, \"title\": \"Runtime Resources\", \"type\": \"array\"}, \"unresolved_questions\": {\"items\": {\"type\": \"string\"}, \"title\": \"Unresolved Questions\", \"type\": \"array\"}, \"schema_version\": {\"default\": \"v1\", \"title\": \"Schema Version\", \"type\": \"string\"}}, \"required\": [\"sources\", \"units\", \"service_api\", \"request_type\", \"success_type\", \"error_type\"], \"title\": \"OperationDataContract\", \"type\": \"object\"}, \"OperationDependency\": {\"additionalProperties\": false, \"description\": \"Bind a configured step to a typed constructor argument and service field.\", \"properties\": {\"binding_id\": {\"minLength\": 1, \"title\": \"Binding Id\", \"type\": \"string\"}, \"unit_id\": {\"minLength\": 1, \"title\": \"Unit Id\", \"type\": \"string\"}, \"type_name\": {\"minLength\": 1, \"title\": \"Type Name\", \"type\": \"string\"}, \"parameter_name\": {\"pattern\": \"^[A-Za-z_$][\\\\w$]*$\", \"title\": \"Parameter Name\", \"type\": \"string\"}, \"field_name\": {\"pattern\": \"^[A-Za-z_$][\\\\w$]*$\", \"title\": \"Field Name\", \"type\": \"string\"}}, \"required\": [\"binding_id\", \"unit_id\", \"type_name\", \"parameter_name\", \"field_name\"], \"title\": \"OperationDependency\", \"type\": \"object\"}, \"OperationResource\": {\"additionalProperties\": false, \"description\": \"Describe a configured provider and the input value it creates per execution.\", \"properties\": {\"input_key\": {\"minLength\": 1, \"title\": \"Input Key\", \"type\": \"string\"}, \"resource_type\": {\"minLength\": 1, \"title\": \"Resource Type\", \"type\": \"string\"}, \"provider_type\": {\"minLength\": 1, \"title\": \"Provider Type\", \"type\": \"string\"}, \"parameter_name\": {\"pattern\": \"^[A-Za-z_$][\\\\w$]*$\", \"title\": \"Parameter Name\", \"type\": \"string\"}, \"field_name\": {\"pattern\": \"^[A-Za-z_$][\\\\w$]*$\", \"title\": \"Field Name\", \"type\": \"string\"}, \"connection_id\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Connection Id\"}, \"transaction_scope\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Transaction Scope\"}}, \"required\": [\"input_key\", \"resource_type\", \"provider_type\", \"parameter_name\", \"field_name\"], \"title\": \"OperationResource\", \"type\": \"object\"}, \"UnitContract\": {\"additionalProperties\": false, \"description\": \"Required APIs, dependencies and evidence-backed requirements for a unit.\", \"properties\": {\"unit_id\": {\"title\": \"Unit Id\", \"type\": \"string\"}, \"apis\": {\"items\": {\"$ref\": \"#/$defs/NativeApiContract\"}, \"minItems\": 1, \"title\": \"Apis\", \"type\": \"array\"}, \"dependency_units\": {\"items\": {\"type\": \"string\"}, \"title\": \"Dependency Units\", \"type\": \"array\"}, \"requirements\": {\"additionalProperties\": {\"type\": \"string\"}, \"minProperties\": 1, \"title\": \"Requirements\", \"type\": \"object\"}, \"evidence_ids\": {\"items\": {\"type\": \"string\"}, \"minItems\": 1, \"title\": \"Evidence Ids\", \"type\": \"array\"}}, \"required\": [\"unit_id\", \"apis\", \"requirements\", \"evidence_ids\"], \"title\": \"UnitContract\", \"type\": \"object\"}}, \"additionalProperties\": false, \"description\": \"Candidate native implementation with test and requirement evidence.\", \"properties\": {\"files\": {\"items\": {\"$ref\": \"#/$defs/NativeSourceFile\"}, \"minItems\": 1, \"title\": \"Files\", \"type\": \"array\"}, \"dependencies\": {\"items\": {\"$ref\": \"#/$defs/MavenDependency\"}, \"title\": \"Dependencies\", \"type\": \"array\"}, \"coverage\": {\"additionalProperties\": {\"items\": {\"type\": \"string\"}, \"type\": \"array\"}, \"title\": \"Coverage\", \"type\": \"object\"}, \"evidence_ids\": {\"items\": {\"type\": \"string\"}, \"title\": \"Evidence Ids\", \"type\": \"array\"}, \"unresolved_questions\": {\"items\": {\"type\": \"string\"}, \"title\": \"Unresolved Questions\", \"type\": \"array\"}, \"unit_contract\": {\"anyOf\": [{\"$ref\": \"#/$defs/UnitContract\"}, {\"type\": \"null\"}], \"default\": null}, \"input_type\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Input Type\"}, \"output_type\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Output Type\"}, \"wire_type\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Wire Type\"}, \"operation_contract\": {\"anyOf\": [{\"$ref\": \"#/$defs/OperationDataContract\"}, {\"type\": \"null\"}], \"default\": null}, \"schema_version\": {\"default\": \"v1\", \"title\": \"Schema Version\", \"type\": \"string\"}}, \"required\": [\"files\"], \"title\": \"NativeUnitBundle\", \"type\": \"object\"}, \"previous_model_response\": \"{\\\"files\\\": [{\\\"path\\\": \\\"src/main/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtMapper.java\\\", \\\"content\\\": \\\"package com.company.generated.units.u66bf2c108225;\\\\n\\\\nimport com.fasterxml.jackson.dataformat.xml.XmlMapper;\\\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty;\\\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement;\\\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlText;\\\\nimport com.fasterxml.jackson.dataformat.xml.ser.ToXmlGenerator;\\\\nimport java.util.Objects;\\\\n\\\\npublic final class StandardErrorRSFmtMapper {\\\\n    private final XmlMapper xmlMapper;\\\\n    private static final String XSI_NS = \\\\\\\"http://www.w3.org/2001/XMLSchema-instance\\\\\\\";\\\\n\\\\n    public StandardErrorRSFmtMapper() {\\\\n        this.xmlMapper = new XmlMapper();\\\\n        this.xmlMapper.configure(ToXmlGenerator.Feature.WRITE_XML_DECLARATION, false);\\\\n    }\\\\n\\\\n    @JacksonXmlRootElement(localName = \\\\\\\"ErrorReply\\\\\\\")\\\\n    public static class ErrorReplyWire {\\\\n        @JacksonXmlProperty(localName = \\\\\\\"ErrorCategory\\\\\\\")\\\\n        public String errorCategory;\\\\n\\\\n        @JacksonXmlProperty(localName = \\\\\\\"ErrorNumber\\\\\\\")\\\\n        public String errorNumber;\\\\n\\\\n        @JacksonXmlProperty(localName = \\\\\\\"ErrorDescription\\\\\\\")\\\\n        public String errorDescription;\\\\n\\\\n        @JacksonXmlProperty(localName = \\\\\\\"RequestId\\\\\\\")\\\\n        public NullableRequestId requestId;\\\\n    }\\\\n\\\\n    public static class NullableRequestId {\\\\n        @JacksonXmlText\\\\n        public String value;\\\\n\\\\n        @JacksonXmlProperty(localName = \\\\\\\"nil\\\\\\\", isAttribute = true, namespace = XSI_NS)\\\\n        public String nil;\\\\n    }\\\\n\\\\n    public record ErrorReply(String errorCategory, String errorNumber, String errorDescription, String requestId) {}\\\\n\\\\n    public String format(ErrorReply reply) throws Exception {\\\\n        Objects.requireNonNull(reply, \\\\\\\"ErrorReply must not be null\\\\\\\");\\\\n        ErrorReplyWire wire = new ErrorReplyWire();\\\\n        wire.errorCategory = reply.errorCategory();\\\\n        wire.errorNumber = reply.errorNumber();\\\\n        wire.errorDescription = reply.errorDescription();\\\\n        \\\\n        wire.requestId = new NullableRequestId();\\\\n        if (reply.requestId() == null) {\\\\n            wire.requestId.nil = \\\\\\\"true\\\\\\\";\\\\n        } else {\\\\n            wire.requestId.value = reply.requestId();\\\\n        }\\\\n        return xmlMapper.writeValueAsString(wire);\\\\n    }\\\\n\\\\n    public ErrorReply unformat(String xml) throws Exception {\\\\n        ErrorReplyWire wire = xmlMapper.readValue(xml, ErrorReplyWire.class);\\\\n        Objects.requireNonNull(wire, \\\\\\\"Deserialized wire structure must not be null\\\\\\\");\\\\n        \\\\n        String reqId = null;\\\\n        if (wire.requestId != null && !\\\\\\\"true\\\\\\\".equals(wire.requestId.nil)) {\\\\n            reqId = wire.requestId.value;\\\\n        }\\\\n        return new ErrorReply(wire.errorCategory, wire.errorNumber, wire.errorDescription, reqId);\\\\n    }\\\\n}\\\\n\\\"}, {\\\"path\\\": \\\"src/test/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtBusinessTest.java\\\", \\\"content\\\": \\\"package com.company.generated.units.u66bf2c108225;\\\\n\\\\nimport org.junit.jupiter.api.Test;\\\\nimport static org.junit.jupiter.api.Assertions.*;\\\\n\\\\npublic class StandardErrorRSFmtBusinessTest {\\\\n    private final StandardErrorRSFmtMapper mapper = new StandardErrorRSFmtMapper();\\\\n\\\\n    @Test\\\\n    public void formatsFullyPopulatedErrorReply() throws Exception {\\\\n        StandardErrorRSFmtMapper.ErrorReply reply = new StandardErrorRSFmtMapper.ErrorReply(\\\\\\\"CAT1\\\\\\\", \\\\\\\"500\\\\\\\", \\\\\\\"System Error\\\\\\\", \\\\\\\"REQ-123\\\\\\\");\\\\n        String xml = mapper.format(reply);\\\\n        assertTrue(xml.contains(\\\\\\\"<ErrorCategory>CAT1</ErrorCategory>\\\\\\\"));\\\\n        assertTrue(xml.contains(\\\\\\\"<ErrorNumber>500</ErrorNumber>\\\\\\\"));\\\\n        assertTrue(xml.contains(\\\\\\\"<ErrorDescription>System Error</ErrorDescription>\\\\\\\"));\\\\n        assertTrue(xml.contains(\\\\\\\"<RequestId>REQ-123</RequestId>\\\\\\\"));\\\\n\\\\n        StandardErrorRSFmtMapper.ErrorReply unformatted = mapper.unformat(xml);\\\\n        assertEquals(\\\\\\\"CAT1\\\\\\\", unformatted.errorCategory());\\\\n        assertEquals(\\\\\\\"500\\\\\\\", unformatted.errorNumber());\\\\n        assertEquals(\\\\\\\"System Error\\\\\\\", unformatted.errorDescription());\\\\n        assertEquals(\\\\\\\"REQ-123\\\\\\\", unformatted.requestId());\\\\n    }\\\\n\\\\n    @Test\\\\n    public void handlesNullRequestIdWithNilDecorator() throws Exception {\\\\n        StandardErrorRSFmtMapper.ErrorReply reply = new StandardErrorRSFmtMapper.ErrorReply(\\\\\\\"CAT2\\\\\\\", \\\\\\\"404\\\\\\\", \\\\\\\"Not Found\\\\\\\", null);\\\\n        String xml = mapper.format(reply);\\\\n        assertTrue(xml.contains(\\\\\\\"xsi:nil=\\\\\\\\\\\\\\\"true\\\\\\\\\\\\\\\"\\\\\\\"));\\\\n\\\\n        StandardErrorRSFmtMapper.ErrorReply unformatted = mapper.unformat(xml);\\\\n        assertNull(unformatted.requestId());\\\\n        assertEquals(\\\\\\\"CAT2\\\\\\\", unformatted.errorCategory());\\\\n        assertEquals(\\\\\\\"404\\\\\\\", unformatted.errorNumber());\\\\n        assertEquals(\\\\\\\"Not Found\\\\\\\", unformatted.errorDescription());\\\\n    }\\\\n}\\\\n\\\"}, {\\\"path\\\": \\\"src/test/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtAdapterTest.java\\\", \\\"content\\\": \\\"package com.company.generated.units.u66bf2c108225;\\\\n\\\\nimport org.junit.jupiter.api.Test;\\\\nimport static org.junit.jupiter.api.Assertions.*;\\\\nimport javax.xml.parsers.DocumentBuilderFactory;\\\\nimport java.io.ByteArrayInputStream;\\\\nimport java.nio.charset.StandardCharsets;\\\\nimport org.w3c.dom.Element;\\\\n\\\\npublic class StandardErrorRSFmtAdapterTest {\\\\n    private final StandardErrorRSFmtMapper mapper = new StandardErrorRSFmtMapper();\\\\n    private static final String XSI = \\\\\\\"http://www.w3.org/2001/XMLSchema-instance\\\\\\\";\\\\n\\\\n    private Element parseXml(String xml) throws Exception {\\\\n        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\\\\n        factory.setNamespaceAware(true);\\\\n        return factory.newDocumentBuilder().parse(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))).getDocumentElement();\\\\n    }\\\\n\\\\n    @Test\\\\n    public void verifiesXmlStructureAndNamespaces() throws Exception {\\\\n        StandardErrorRSFmtMapper.ErrorReply reply = new StandardErrorRSFmtMapper.ErrorReply(\\\\\\\"CAT\\\\\\\", \\\\\\\"999\\\\\\\", \\\\\\\"Desc\\\\\\\", null);\\\\n        String xml = mapper.format(reply);\\\\n        Element root = parseXml(xml);\\\\n\\\\n        assertEquals(\\\\\\\"ErrorReply\\\\\\\", root.getTagName());\\\\n        assertFalse(xml.startsWith(\\\\\\\"<?xml\\\\\\\"));\\\\n\\\\n        Element reqIdElem = (Element) root.getElementsByTagName(\\\\\\\"RequestId\\\\\\\").item(0);\\\\n        assertNotNull(reqIdElem);\\\\n        assertEquals(\\\\\\\"true\\\\\\\", reqIdElem.getAttributeNS(XSI, \\\\\\\"nil\\\\\\\"));\\\\n    }\\\\n}\\\\n\\\"}], \\\"dependencies\\\": [{\\\"group_id\\\": \\\"org.junit.jupiter\\\", \\\"artifact_id\\\": \\\"junit-jupiter\\\", \\\"version\\\": \\\"5.10.0\\\", \\\"scope\\\": \\\"test\\\", \\\"reason\\\": \\\"JUnit Jupiter tests and execution engine\\\", \\\"required_classes\\\": [\\\"org.junit.jupiter.api.Test\\\", \\\"org.junit.jupiter.api.Assertions\\\"]}, {\\\"group_id\\\": \\\"org.mockito\\\", \\\"artifact_id\\\": \\\"mockito-core\\\", \\\"version\\\": \\\"5.23.0\\\", \\\"scope\\\": \\\"test\\\", \\\"reason\\\": \\\"Mockito for mocking\\\", \\\"required_classes\\\": []}, {\\\"group_id\\\": \\\"com.fasterxml.jackson.dataformat\\\", \\\"artifact_id\\\": \\\"jackson-dataformat-xml\\\", \\\"version\\\": \\\"2.15.2\\\", \\\"scope\\\": \\\"compile\\\", \\\"reason\\\": \\\"Jackson XML serialization and deserialization\\\", \\\"required_classes\\\": [\\\"com.fasterxml.jackson.dataformat.xml.XmlMapper\\\", \\\"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty\\\", \\\"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement\\\", \\\"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlText\\\", \\\"com.fasterxml.jackson.dataformat.xml.ser.ToXmlGenerator\\\"]}], \\\"coverage\\\": {\\\"business\\\": [\\\"src/test/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtBusinessTest.java\\\", \\\"src/test/java/com/company/generated/units/u66bf2c108225/StandardErrorRSFmtAdapterTest.java\\\"]}, \\\"evidence_ids\\\": [\\\"response_format-66bf2c108225fb63eb2a0cbe\\\", \\\"com.ibm.dse.base.Context\\\", \\\"com.ibm.dse.base.Tag\\\", \\\"com.ibm.il.dse.cc.decorator.NilDecorator\\\", \\\"com.ibm.il.dse.cc.format.CCString\\\", \\\"com.ibm.il.dse.cc.format.CCXML\\\"], \\\"unresolved_questions\\\": [], \\\"input_type\\\": null, \\\"output_type\\\": \\\"com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply\\\", \\\"wire_type\\\": \\\"com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReplyWire\\\", \\\"operation_contract\\\": null, \\\"schema_version\\\": \\\"v1\\\", \\\"unit_contract\\\": {\\\"unit_id\\\": \\\"response_format-66bf2c108225fb63eb2a0cbe\\\", \\\"apis\\\": [{\\\"type_name\\\": \\\"com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper\\\", \\\"method_signatures\\\": [\\\"public java.lang.String format(com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply)\\\", \\\"public com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply unformat(java.lang.String)\\\"]}], \\\"dependency_units\\\": [], \\\"requirements\\\": {\\\"business\\\": \\\"Preserve this complete configured unit's evidenced behavior\\\"}, \\\"evidence_ids\\\": [\\\"response_format-66bf2c108225fb63eb2a0cbe\\\", \\\"com.ibm.dse.base.Context\\\", \\\"com.ibm.dse.base.Tag\\\", \\\"com.ibm.il.dse.cc.decorator.NilDecorator\\\", \\\"com.ibm.il.dse.cc.format.CCString\\\", \\\"com.ibm.il.dse.cc.format.CCXML\\\"]}}\", \"correction_feedback\": \"Native method contract is missing or changed: public java.lang.String format(com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper$ErrorReply)\\nXML null mapping and correction checks:\\nPreserve absent, empty and nil values according to the supplied format configuration and\\nsupporting behavior evidence. Apply xsi:nil to the specific element whose value is null,\\nnot its parent, siblings or document root. A nil root is valid only when the entire root\\nvalue is evidenced to be null; a nullable child must not make a populated response nil.\\nModel nullable child elements at their own XML scope, using an element wrapper or explicit\\nelement-level serialization when needed. Declare the XML Schema instance namespace correctly.\\nOn input, interpret an element's nil marker at that element only; preserve its siblings.\\nDo not use a root-level nil attribute as a global flag for a nullable child.\\nTest the actual serialized XML structure and attribute placement independently of round-trips:\\na null child leaves the populated root and siblings intact, and deserialization preserves\\ntheir values. Test evidenced non-null, missing, empty and nil cases without inventing rules.\\nWhen correcting a parsing/test failure, trace the serialized element and its annotations\\nback to the evidenced field. Fix incorrect nil placement or mapping rather than merely\\nadding a null guard, changing the exception, discarding data or weakening the test.\\n\", \"composer_behavior_evidence\": [{\"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"4. Runtime Execution Model\", \"content\": \"## 4. Runtime Execution Model\\n\\n### High-Level Flow\\n\\nWhen a channel handler receives an HTTP/service request for operation `GetClientLinksOp`:\\n\\n```\\n1. Channel Handler receives request XML\\n2. Looks up \\\"GetClientLinksOp\\\" in dse.ini selfDefOper → finds XML file path\\n3. Loads and initializes CCDSEServerOperation from that XML file\\n4. Channel Handler calls: operation.unformat(requestXml)\\n   → request format cascades through the fmtDef structure\\n   → each formatter tag reads its value from the XML and writes it to context\\n   → each decorator in the chain transforms the value before/after the formatter\\n5. Channel Handler calls: operation.execute()\\n   → opStep chain runs according to RC routing\\n   → opSteps read from / write to context\\n6. Channel Handler calls: operation.format()\\n   → response format cascades through the reply fmtDef\\n   → each formatter tag reads its value from context and builds XML output\\n   → each decorator transforms the value\\n7. Channel Handler returns the formatted XML response\\n```\\n\\n**Important:** Steps 4, 5, and 6 are managed by the channel handler infrastructure. The developer defines what happens inside each step, not the orchestration between them.\\n\\n### CCDSEServerOperation.execute() — The opStep Loop\\n\\nThe execute() method runs the opStep chain:\\n\\n```java\\n// Pseudocode of CCDSEServerOperation.execute()\\npublic void execute() throws Exception {\\n    // 1. Set channel context values\\n    setValueAt(\\\"HOST_HEADER.HOST_KEY\\\", getHostKey());\\n    setFields(getOperationfields());\\n\\n    // 2. Filter opSteps not applicable to this channel\\n    removeOpStepsNotForThisChannel();\\n\\n    // 3. Run the opStep chain\\n    int index = 0;\\n    KeyedCollection end_opstep = null;\\n    if (isFinallyOpStepExist()) {\\n        end_opstep = getFinallyOpStep();  // the \\\"End\\\" step if defined\\n    }\\n\\n    do {\\n        KeyedCollection kc = getOperationStep(index);\\n        index = processOpStep(kc, operationName, index);\\n    } while (index != -1);\\n\\n    // 4. Run the \\\"End\\\" step if it exists\\n    if (end_opstep != null) {\\n        processOpStep(end_opstep, operationName, index);\\n    }\\n\\n    // 5. Error body substitution (if an opStep switched the reply format)\\n    if (isReturnedErrorBodyChanged() && getReturnedErrorBodyChanger() != null) {\\n        // substitute csErrorReplyFormat for csReplyFormat\\n    }\\n}\\n```\\n\\n### processOpStep() — RC Routing\\n\\nThe RC routing priority for each opStep result:\\n\\n```\\n1. Check \\\"on{RC}Return\\\" → if set, switch the error reply format body\\n2. If RC == RC_TIMEOUT → check \\\"onTimeoutDo\\\" first\\n3. Check \\\"on{RC}Do\\\" → if found, go to that step name\\n4. Check \\\"onOtherDo\\\" → if found, go to that step name\\n5. Check \\\"onOtherDoDefault\\\" → if found, use it (with warning log)\\n6. If next == \\\"next\\\" → increment index, continue loop\\n7. If next == \\\"end\\\"  → return -1, break loop\\n8. Otherwise → look up step by name, jump to it\\n```\\n\\n### Channel Filtering — onlyFor\\n\\nBefore execute() runs, `removeOpStepsNotForThisChannel()` scans all opSteps and removes any that have an `onlyFor` attribute whose value does not match the current channel name.\\n\\n```xml\\n<!-- This step only runs on the INTERNET channel -->\\n<opStep id=\\\"InternetOnlyValidation\\\"\\n        implClass=\\\"operations.InternetValidation\\\"\\n        onlyFor=\\\"internet\\\"\\n        on0Do=\\\"end\\\"\\n        onOtherDo=\\\"OperationFailed\\\"/>\\n```\\n\\n**Conversion rule:** When converting an operation XML to native code for a specific channel, opSteps with `onlyFor` values that do not match the target channel are simply omitted from the generated code. The generated class reflects only the steps that actually run for that channel.\\n\\n---\", \"content_hash\": \"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\"}, {\"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"5. Context\", \"content\": \"## 5. Context\\n\\n### What Context Is\\n\\nThe context is a hierarchical runtime data store. It is the central communication mechanism between all components of an operation — formatters read from and write to it, opSteps read from and write to it, decorators do not directly access it (they transform string values, not context fields).\\n\\nAt runtime, the context is essentially a nested map:\\n```\\ncontext[\\\"ClientId\\\"]      = \\\"123456\\\"\\ncontext[\\\"ClientName\\\"]    = \\\"John Doe\\\"\\ncontext[\\\"links\\\"]         = [list of link objects]\\ncontext[\\\"ERROR_CODE\\\"]    = \\\"10\\\"\\ncontext[\\\"ERROR_NUMBER\\\"]  = \\\"0\\\"\\n```\\n\\nIn practice, any Java object can be stored in a context field — strings, numbers, collections, custom objects. The formatter tags define how those objects are serialized to/from XML.\\n\\n### Context Inheritance Chain\\n\\nContexts form an inheritance hierarchy via the `parent` attribute:\\n\\n```xml\\n<context id=\\\"BaseOpCtxt\\\"     parent=\\\"nil\\\"         type=\\\"op\\\"/>\\n<context id=\\\"InternetCtxt\\\"   parent=\\\"BaseOpCtxt\\\"  type=\\\"op\\\"/>\\n<context id=\\\"GetLinksCtxt\\\"   parent=\\\"InternetCtxt\\\" type=\\\"op\\\"/>\\n```\\n\\nWhen `GetLinksCtxt` is active:\\n- An opStep or formatter can read/write fields in `GetLinksCtxt`\\n- It can also read/write fields in `InternetCtxt` (parent)\\n- It can also read/write fields in `BaseOpCtxt` (grandparent)\\n- Each context has its **own isolated namespace** — there is no collision between field names in different levels\\n- Access traverses up the chain: if a field is not found in the current context, the runtime looks in the parent, then grandparent, up to `nil`\\n\\n### Context Access Rules\\n\\n- **Formatters** (CCString, CCDate, CCXML, etc.): read from and write to context fields identified by their `dataName` attribute\\n- **opStep implClasses**: have full access to the context chain — can read any field and write any field at any level they have access to\\n- **Decorators**: do NOT directly access context — they receive a string value from the formatter and return a transformed string\\n- **No component can access context fields from a sibling context** — only from its own context and its ancestors\\n\\n### Context in the Operation XML\\n\\n```xml\\n<context id=\\\"GetLinksCtxt\\\" parent=\\\"nil\\\" type=\\\"op\\\"/>\\n\\n<CCDSEServerOperation id=\\\"GetLinksOp\\\" operationContext=\\\"GetLinksCtxt\\\">\\n    ...\\n</CCDSEServerOperation>\\n```\\n\\nThe `operationContext` attribute binds the operation to its context. The context is instantiated once when the operation starts and lives until the operation completes.\\n\\n---\", \"content_hash\": \"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\"}, {\"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"6. Formats and the Format/Unformat Process\", \"content\": \"## 6. Formats and the Format/Unformat Process\\n\\n### What a Format Is\\n\\nA `fmtDef` is a declarative description of an XML data structure. It is not a DTO class — it is a recursive tree of formatter tags, each of which knows how to:\\n- **unformat**: read its value from incoming XML and write it to the context\\n- **format**: read its value from context and write it to the output XML\\n\\nThe format tree is walked recursively. Each node in the tree is a formatter tag instance.\\n\\n### Format and Unformat Direction\\n\\n**Unformat (parsing — XML → context):**\\n```\\nIncoming XML string\\n  → root formatter tag's unformat() is called\\n  → root tag parses its children recursively\\n  → each leaf formatter reads its XML element value\\n  → (if decorators present: removeDecoration() chain applied first)\\n  → final value written to context[dataName]\\n```\\n\\n**Format (serializing — context → XML):**\\n```\\ncontext[dataName] value\\n  → (if decorators present: addDecoration() chain applied first)\\n  → leaf formatter writes its value as an XML element\\n  → parent formatters build the XML structure up the tree\\n  → result is the complete XML output string\\n```\\n\\n### Decorator Chain Direction\\n\\n**During unformat (parsing incoming XML):**\\n```\\nXML string value\\n  → last decorator in chain: removeDecoration(value)\\n  → second-to-last decorator: removeDecoration(previous result)\\n  → ... (chain runs in reverse order)\\n  → first decorator: removeDecoration(...)\\n  → result passed to formatter for context write\\n```\\n\\n**During format (building outgoing XML):**\\n```\\ncontext value (string from formatter)\\n  → first decorator in chain: addDecoration(value)\\n  → second decorator: addDecoration(previous result)\\n  → ... (chain runs in forward order)\\n  → last decorator: addDecoration(...)\\n  → result written to XML output\\n```\\n\\nThe decorator chain is defined by the order of decorator tags after the formatter tag in the XML.\\n\\n### Format Execution Contexts\\n\\nThe format/unformat process is not limited to request/response. It occurs whenever data needs to be serialized or deserialized:\\n\\n- **Request reception**: channel handler calls unformat on `csRequestFormat`\\n- **Response building**: channel handler calls format on `csReplyFormat` (or `csErrorReplyFormat` if error body was switched)\\n- **Backend request**: an opStep builds a request to a backend system using a format\\n- **Backend response**: an opStep parses a response from a backend system using a format\\n- **Logging**: some opSteps serialize context data to log using a format\\n\\n### refFormat — Format Reuse\\n\\n```xml\\n<!-- In CCDSEServerOperation: -->\\n<refFormat name=\\\"csRequestFormat\\\"  refid=\\\"GetLinksRQFmt\\\"/>\\n<refFormat name=\\\"csReplyFormat\\\"    refid=\\\"GetLinksRSFmt\\\"/>\\n<refFormat name=\\\"csErrorReplyFormat\\\" refid=\\\"StandardErrorFmt\\\"/>\\n```\\n\\nThe `name` attribute is the role the format plays in this operation. The conventional names are:\\n- `csRequestFormat` — the incoming request XML structure\\n- `csReplyFormat` — the success response XML structure\\n- `csErrorReplyFormat` — the error response XML structure (substituted when an opStep signals an error body change via `on{RC}Return`)\\n\\nThe `refid` points to a `fmtDef` id, which may be defined in the same XML file, in `dseformat.xml`, or in any other file loaded via `defaultFile`.\\n\\n### CCTableFormat — Database Lookup During Format\\n\\n`CCTableFormat` is a special formatter that performs a database lookup during the format process. When the format tree reaches a `CCTableFormat` node during format (building outgoing XML):\\n1. It reads the key value from context (identified by `keyValue` attribute)\\n2. Queries `fromTable` column `fromColumn` where the key matches\\n3. Writes the result as the field's XML value\\n\\nThis means database calls can happen during response building, not just during opStep execution.\\n\\n---\", \"content_hash\": \"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\"}, {\"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"7. Decorators\", \"content\": \"## 7. Decorators\\n\\n### What a Decorator Is\\n\\nA decorator is a value transformer chained after a formatter tag. It operates on the string result of the formatter, not on the context directly.\\n\\n**XML syntax:**\\n```xml\\n<CCString dataName=\\\"AccountId\\\"/>\\n<CCPadding padChar=\\\"0\\\" length=\\\"9\\\"/>\\n```\\n\\n`CCPadding` is a decorator that follows `CCString`. The decorator tag appears as a sibling immediately after the formatter's self-closing tag.\\n\\n### Decorator Contracts\\n\\nThere are two decorator base classes with different contracts:\\n\\n**Type 1 — Value Decorator** (extends `FormatDecoratorHolder`):\\n```java\\npublic String addDecoration(String s);     // called during FORMAT\\npublic String removeDecoration(String s);  // called during UNFORMAT\\npublic Object initializeFrom(Tag tag);     // reads this tag's own attributes\\n```\\n\\nExample — `CCPadding`:\\n- `addDecoration(\\\"1234567\\\")` → `\\\"001234567\\\"` (pad to length 9 with '0')\\n- `removeDecoration(\\\"001234567\\\")` → `\\\"1234567\\\"` (strip leading zeros)\\n\\n**Type 2 — Attribute Decorator** (extends `AttributeXmlFormatDecoratorImpl`):\\n```java\\npublic Hashtable formatXmlAttributes(Context ctx, DataElement de, FormatElement fe);\\npublic Object initializeFrom(Tag tag);\\n```\\n\\nThis type operates at the XML attribute level rather than the string value level. It can add XML attributes (like `xsi:nil=\\\"true\\\"`) to the output element. Example: `NilDecorator`.\\n\\n### Decorator Chain Rules\\n\\n1. A decorator applies only to the immediately preceding formatter tag\\n2. Multiple decorators can be chained after one formatter — each receives the previous one's output\\n3. During **format**: chain runs in order (first decorator → last decorator)\\n4. During **unformat**: chain runs in reverse order (last decorator → first decorator)\\n5. `initializeFrom(Tag tag)` reads only this decorator's own XML attributes — never the formatter's attributes or sibling tags\\n6. A decorator can be placed after a complex formatter (like `CCXML`) — in that case it decorates the entire XML subtree produced by that formatter\\n\\n### Example — Multiple Decorators\\n\\n```xml\\n<CCString dataName=\\\"Amount\\\"/>\\n<RemoveLeadingZerosDecorator/>\\n<CCPadding padChar=\\\" \\\" length=\\\"12\\\"/>\\n```\\n\\n**During unformat** (input XML: `<Amount>   0001234</Amount>`):\\n1. `CCPadding.removeDecoration(\\\"   0001234\\\")` → strips right-padding → `\\\"0001234\\\"`\\n2. `RemoveLeadingZerosDecorator.removeDecoration(\\\"0001234\\\")` → `\\\"1234\\\"`\\n3. `CCString` writes `\\\"1234\\\"` to context[\\\"Amount\\\"]\\n\\n**During format** (context[\\\"Amount\\\"] = \\\"1234\\\"):\\n1. `CCString` reads `\\\"1234\\\"` from context\\n2. `RemoveLeadingZerosDecorator.addDecoration(\\\"1234\\\")` → (no-op in format) → `\\\"1234\\\"`\\n3. `CCPadding.addDecoration(\\\"1234\\\")` → `\\\"        1234\\\"` (12 chars, space-padded left)\\n4. XML output: `<Amount>        1234</Amount>`\\n\\n### All Decorator Tags (from XML channel dse.ini)\\n\\n| Tag | Class | Description |\\n|---|---|---|\\n| `nilDecorator` | `...decorator.NilDecorator` | Sets `xsi:nil=\\\"true\\\"` when value is null/empty |\\n| `RemoveLeadingZerosDecorator` | `...decorator.RemoveLeadingZerosDecorator` | Strips leading zeros |\\n| `CCPadding` | `...decorator.CCPadding` | Pads string to fixed length |\\n| `CCFixedLength` | `...decorator.CCFixedLength` | Enforces fixed string length |\\n| `CCMandatory` | `...decorator.CCMandatory` | Validates field is not empty |\\n| `CCNotNull` | `...decorator.CCNotNull` | Validates field is not null |\\n| `CCZeroToNull` | `...decorator.CCZeroToNull` | Converts zero value to null |\\n| `CCNullToZero` | `...decorator.CCNullToZero` | Converts null to zero |\\n| `fZeroToDecimalIDB` | `...decorator.ZeroToDecimalIDB` | Handles zero decimal display |\\n| `fFixedLengthTranIDB` | `...decorator.FixedLengthTranIDB` | Fixed-length transform |\\n| `fStringDateIDB` | `...decorator.StringDateIDB` | String-to-date conversion |\\n| `fZeroToNullIDB` | `...decorator.ZeroToNullIDB` | Zero-to-null for IDB |\\n| `fTrimIDB` | `...decorator.TrimIDB` | Trim whitespace for IDB |\\n| `SmartMirror` | `...decorator.SmartMirror` | Hebrew/Latin text mirroring |\\n| `HebrewWHF` | `...decorator.HebrewWHF` | Hebrew character handling |\\n| `MF2Hebrew` | `...decorator.MF2Hebrew` | Mainframe-to-Hebrew conversion |\\n| `Base64Decorator` | `...decorator.Base64Decorator` | Base64 encode/decode |\\n| `ArithmaticAction` | `...decorator.ArithmaticAction` | Arithmetic on value |\\n| `CCRegExp` | `...decorator.CCRegExp` | Regex validation |\\n| `CCRegExpReplace` | `...decorator.CCRegExpReplace` | Regex replace |\\n| `MaskLogDecorator` | `...decorator.MaskLogDecorator` | Masks value in logs |\\n| `TypeReceive` | `...decorator.TypeReceive` | Type conversion on receive |\\n| `SetCenturyFor2DigitsYear` | `...decorator.SetCenturyFor2DigitsYear` | Y2K year handling |\\n| `CCPhoneNumberDecorator` | `...decorator.CCPhoneNumberDecorator` | Phone number formatting |\\n| `AltamiraChannelDecorator` | `...decorator.AltamiraChannelDecorator` | Altamira channel transform |\\n| `HebrewLogicalToVisualDecorator` | `...decorator.HebrewLogicalToVisualDecorator` | Hebrew visual order |\\n| `unicodeDecorator` | `...decorator.UnicodeDecorator` | Unicode handling |\\n| `convertReservedTags` | `...decorator.ConvertReservedTags` | XML reserved char escaping |\\n| `delimS` | `...decorator.DelimiterStr` | Delimiter-based splitting |\\n\\n---\", \"content_hash\": \"0dae02d0709a670195856f35ecba11496c6e6987d38f2be86dd13838877833fd\"}]}"}],"role":"user"}
