not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\npublic class AdapterContractTest {\\n    @Test void adapterPassesTheIdentifierToItsDependency() throws Exception {\\n        Connection connection = mock(Connection.class);\\n        CallableStatement statement = mock(CallableStatement.class);\\n        when(connection.prepareCall(\\\"{call sample(?)}\\\")).thenReturn(statement);\\n        when(statement.getString(1)).thenReturn(\\\"sample-result\\\");\\n        try (CallableStatement call = connection.prepareCall(\\\"{call sample(?)}\\\")) {\\n            call.setString(1, \\\"sample-id\\\");\\n            call.execute();\\n            assertEquals(\\\"sample-result\\\", call.getString(1));\\n        }\\n        verify(statement).setString(1, \\\"sample-id\\\");\\n        verify(statement).execute();\\n        verify(statement).close();\\n    }\\n}\\n\"}, {\"path\": \"BusinessBehaviorTest.java\", \"content\": \"package example;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Reference structure only: derive real expected values from migration evidence. */\\npublic class BusinessBehaviorTest {\\n    interface NotificationPort { void send(String reference); }\\n    static class CompletionService {\\n        private final NotificationPort notifications;\\n        CompletionService(NotificationPort notifications) { this.notifications = notifications; }\\n        String complete(String reference) { notifications.send(reference); return reference; }\\n    }\\n\\n    @Test void returnsTheCompletedReference() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        CompletionService service = new CompletionService(notifications);\\n        assertEquals(\\\"sample-reference\\\", service.complete(\\\"sample-reference\\\"));\\n    }\\n\\n    @Test void notifiesTheCollaboratorOnce() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        new CompletionService(notifications).complete(\\\"sample-reference\\\");\\n        verify(notifications).send(\\\"sample-reference\\\");\\n        verifyNoMoreInteractions(notifications);\\n    }\\n}\\n\"}]}, \"final_validation_feedback\": null, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\"}, \"generated_bundle\": {\"files\": [{\"path\": \"src/main/java/com/company/generated/units/u5dfecf09ff9f/GetClientLinksRSFmtMapper.java\", \"content\": \"package com.company.generated.units.u5dfecf09ff9f;\\n\\nimport com.fasterxml.jackson.dataformat.xml.XmlMapper;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlElementWrapper;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlText;\\nimport com.fasterxml.jackson.dataformat.xml.ser.ToXmlGenerator;\\nimport java.util.ArrayList;\\nimport java.util.List;\\nimport java.util.Objects;\\n\\npublic final class GetClientLinksRSFmtMapper {\\n    private final XmlMapper xmlMapper;\\n\\n    public GetClientLinksRSFmtMapper() {\\n        this.xmlMapper = new XmlMapper();\\n        this.xmlMapper.configure(ToXmlGenerator.Feature.WRITE_XML_DECLARATION, false);\\n    }\\n\\n    public static class LinkDescriptionWire {\\n        @JacksonXmlText\\n        public String value;\\n\\n        @JacksonXmlProperty(localName = \\\"nil\\\", isAttribute = true, namespace = \\\"http://www.w3.org/2001/XMLSchema-instance\\\")\\n        public String nil;\\n    }\\n\\n    public static class LinkWire {\\n        @JacksonXmlProperty(localName = \\\"LinkId\\\")\\n        public String linkId;\\n\\n        @JacksonXmlProperty(localName = \\\"LinkDescription\\\")\\n        public LinkDescriptionWire linkDescription;\\n\\n        @JacksonXmlProperty(localName = \\\"LinkUrl\\\")\\n        public String linkUrl;\\n\\n        @JacksonXmlProperty(localName = \\\"IsExternal\\\")\\n        public String isExternal;\\n\\n        @JacksonXmlProperty(localName = \\\"IconCode\\\")\\n        public LinkDescriptionWire iconCode;\\n    }\\n\\n    @JacksonXmlRootElement(localName = \\\"GetClientLinksResponse\\\")\\n    public static class GetClientLinksResponseWire {\\n        @JacksonXmlProperty(localName = \\\"ClientId\\\")\\n        public String clientId;\\n\\n        @JacksonXmlProperty(localName = \\\"Links\\\")\\n        public LinksWrapper links;\\n    }\\n\\n    public static class LinksWrapper {\\n        @JacksonXmlElementWrapper(useWrapping = false)\\n        @JacksonXmlProperty(localName = \\\"Link\\\")\\n        public List<LinkWire> linkList = new ArrayList<>();\\n    }\\n\\n    public record LinkDto(String linkId, String linkDescription, String linkUrl, Boolean isExternal, String iconCode) {}\\n\\n    public record GetClientLinksResponse(String clientId, List<LinkDto> links) {}\\n\\n    public String format(GetClientLinksResponse response) throws Exception {\\n        Objects.requireNonNull(response, \\\"Response cannot be null\\\");\\n        GetClientLinksResponseWire wire = new GetClientLinksResponseWire();\\n        wire.clientId = response.clientId();\\n        if (response.links() != null) {\\n            wire.links = new LinksWrapper();\\n            for (LinkDto dto : response.links()) {\\n                LinkWire lw = new LinkWire();\\n                if (dto.linkId() == null || dto.linkId().isEmpty()) {\\n                    throw new IllegalArgumentException(\\\"LinkId is mandatory\\\");\\n                }\\n                lw.linkId = dto.linkId();\\n\\n                lw.linkDescription = new LinkDescriptionWire();\\n                if (dto.linkDescription() == null || dto.linkDescription().isBlank()) {\\n                    lw.linkDescription.nil = \\\"true\\\";\\n                } else {\\n                    lw.linkDescription.value = dto.linkDescription();\\n                }\\n\\n                lw.linkUrl = dto.linkUrl();\\n\\n                if (dto.isExternal() != null) {\\n                    lw.isExternal = dto.isExternal() ? \\\"true\\\" : \\\"false\\\";\\n                }\\n\\n                lw.iconCode = new LinkDescriptionWire();\\n                if (dto.iconCode() == null || dto.iconCode().isBlank()) {\\n                    lw.iconCode.nil = \\\"true\\\";\\n                } else {\\n                    lw.iconCode.value = dto.iconCode();\\n                }\\n\\n                wire.links.linkList.add(lw);\\n            }\\n        }\\n        return xmlMapper.writeValueAsString(wire);\\n    }\\n\\n    public GetClientLinksResponse unformat(String xml) throws Exception {\\n        Objects.requireNonNull(xml, \\\"XML cannot be null\\\");\\n        GetClientLinksResponseWire wire = xmlMapper.readValue(xml, GetClientLinksResponseWire.class);\\n        if (wire == null) {\\n            return null;\\n        }\\n        List<LinkDto> dtos = new ArrayList<>();\\n        if (wire.links != null && wire.links.linkList != null) {\\n            for (LinkWire lw : wire.links.linkList) {\\n                if (lw.linkId == null || lw.linkId.isEmpty()) {\\n                    throw new IllegalArgumentException(\\\"LinkId is mandatory\\\");\\n                }\\n                String desc = null;\\n                if (lw.linkDescription != null && !\\\"true\\\".equals(lw.linkDescription.nil)) {\\n                    desc = lw.linkDescription.value;\\n                }\\n                String url = lw.linkUrl;\\n                Boolean isExt = null;\\n                if (lw.isExternal != null) {\\n                    isExt = Boolean.valueOf(lw.isExternal);\\n                }\\n                String icon = null;\\n                if (lw.iconCode != null && !\\\"true\\\".equals(lw.iconCode.nil)) {\\n                    icon = lw.iconCode.value;\\n                }\\n                dtos.add(new LinkDto(lw.linkId, desc, url, isExt, icon));\\n            }\\n        }\\n        return new GetClientLinksResponse(wire.clientId, dtos);\\n    }\\n}\\n\"}, {\"path\": \"src/test/java/com/company/generated/units/u5dfecf09ff9f/GetClientLinksRSFmtTest.java\", \"content\": \"package com.company.generated.units.u5dfecf09ff9f;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.*;\\nimport java.io.ByteArrayInputStream;\\nimport java.nio.charset.StandardCharsets;\\nimport java.util.List;\\nimport javax.xml.parsers.DocumentBuilderFactory;\\nimport org.w3c.dom.Element;\\n\\npublic class GetClientLinksRSFmtTest {\\n    private final GetClientLinksRSFmtMapper mapper = new GetClientLinksRSFmtMapper();\\n    private static final String XSI = \\\"http://www.w3.org/2001/XMLSchema-instance\\\";\\n\\n    private Element parseRoot(String xml) throws Exception {\\n        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\\n        factory.setNamespaceAware(true);\\n        return factory.newDocumentBuilder().parse(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))).getDocumentElement();\\n    }\\n\\n    @Test\\n    public void testFormatAndUnformatSuccess() throws Exception {\\n        GetClientLinksRSFmtMapper.LinkDto link = new GetClientLinksRSFmtMapper.LinkDto(\\n            \\\"L1\\\", \\\"Description 1\\\", \\\"http://example.com\\\", true, \\\"ICON1\\\"\\n        );\\n        GetClientLinksRSFmtMapper.GetClientLinksResponse response =\\n            new GetClientLinksRSFmtMapper.GetClientLinksResponse(\\\"CLI123\\\", List.of(link));\\n\\n        String xml = mapper.format(response);\\n        assertNotNull(xml);\\n        Element root = parseRoot(xml);\\n        assertEquals(\\\"GetClientLinksResponse\\\", root.getTagName());\\n\\n        GetClientLinksRSFmtMapper.GetClientLinksResponse parsed = mapper.unformat(xml);\\n        assertEquals(\\\"CLI123\\\", parsed.clientId());\\n        assertEquals(1, parsed.links().size());\\n        assertEquals(\\\"L1\\\", parsed.links().get(0).linkId());\\n        assertEquals(\\\"Description 1\\\", parsed.links().get(0).linkDescription());\\n        assertEquals(\\\"http://example.com\\\", parsed.links().get(0).linkUrl());\\n        assertTrue(parsed.links().get(0).isExternal());\\n        assertEquals(\\\"ICON1\\\", parsed.links().get(0).iconCode());\\n    }\\n\\n    @Test\\n    public void testMandatoryLinkIdValidation() {\\n        GetClientLinksRSFmtMapper.LinkDto link = new GetClientLinksRSFmtMapper.LinkDto(\\n            null, \\\"Desc\\\", \\\"url\\\", false, \\\"icon\\\"\\n        );\\n        GetClientLinksRSFmtMapper.GetClientLinksResponse response =\\n            new GetClientLinksRSFmtMapper.GetClientLinksResponse(\\\"CLI\\\", List.of(link));\\n\\n        assertThrows(IllegalArgumentException.class, () -> mapper.format(response));\\n    }\\n\\n    @Test\\n    public void testNilDecorators() throws Exception {\\n        GetClientLinksRSFmtMapper.LinkDto link = new GetClientLinksRSFmtMapper.LinkDto(\\n            \\\"L2\\\", null, \\\"url\\\", false, null\\n        );\\n        GetClientLinksRSFmtMapper.GetClientLinksResponse response =\\n            new GetClientLinksRSFmtMapper.GetClientLinksResponse(\\\"CLI\\\", List.of(link));\\n\\n        String xml = mapper.format(response);\\n        Element root = parseRoot(xml);\\n        Element linkEl = (Element) root.getElementsByTagName(\\\"Link\\\").item(0);\\n        Element descEl = (Element) linkEl.getElementsByTagName(\\\"LinkDescription\\\").item(0);\\n        assertEquals(\\\"true\\\", descEl.getAttributeNS(XSI, \\\"nil\\\"));\\n\\n        GetClientLinksRSFmtMapper.GetClientLinksResponse parsed = mapper.unformat(xml);\\n        assertNull(parsed.links().get(0).linkDescription());\\n        assertNull(parsed.links().get(0).iconCode());\\n    }\\n}\\n\"}], \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"JUnit Jupiter tests and execution engine\", \"required_classes\": [\"org.junit.jupiter.api.Test\", \"org.junit.jupiter.api.Assertions\"]}, {\"group_id\": \"com.fasterxml.jackson.dataformat\", \"artifact_id\": \"jackson-dataformat-xml\", \"version\": \"2.17.2\", \"scope\": \"compile\", \"reason\": \"Jackson XML serialization and deserialization\", \"required_classes\": [\"com.fasterxml.jackson.dataformat.xml.XmlMapper\", \"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement\", \"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty\", \"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlElementWrapper\", \"com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlText\", \"co