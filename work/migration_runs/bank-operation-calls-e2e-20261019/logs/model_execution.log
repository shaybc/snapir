any.generated.units.u3a42c4326e3d.DatabaseErrorStep;\\nimport com.company.generated.units.u3a42c4326e3d.OperationContext;\\nimport com.company.generated.units.u3643d2141e0a.NoLinksFoundStep;\\nimport com.company.generated.units.u42b95631a186.GetClientLinksStep;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequest;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper;\\nimport com.company.generated.units.u561a01497abb.GetClientLinksRequestXml;\\nimport com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper;\\nimport com.company.generated.units.u66bf2c108225.StandardErrorRSFmtMapper;\\nimport com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep;\\n\\nimport javax.sql.DataSource;\\nimport java.sql.Connection;\\nimport java.util.List;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\npublic class GetClientLinksOpService {\\n\\n    private final GetClientLinksStep getClientLinksStep;\\n    private final NoLinksFoundStep noLinksFoundStep;\\n    private final DatabaseErrorStep databaseErrorStep;\\n    private final TechnicalErrorStep technicalError;\\n    private final DataSource dataSource;\\n\\n    private final GetClientLinksRequestUnformatMapper requestUnformatMapper;\\n    private final GetClientLinksRSFmtMapper replyFormatMapper;\\n    private final StandardErrorRSFmtMapper errorReplyFormatMapper;\\n\\n    public GetClientLinksOpService(\\n            GetClientLinksStep getClientLinksStep,\\n            NoLinksFoundStep noLinksFoundStep,\\n            DatabaseErrorStep databaseErrorStep,\\n            TechnicalErrorStep technicalError,\\n            DataSource dataSource) {\\n        this.getClientLinksStep = Objects.requireNonNull(getClientLinksStep);\\n        this.noLinksFoundStep = Objects.requireNonNull(noLinksFoundStep);\\n        this.databaseErrorStep = Objects.requireNonNull(databaseErrorStep);\\n        this.technicalError = Objects.requireNonNull(technicalError);\\n        this.dataSource = Objects.requireNonNull(dataSource);\\n\\n        this.requestUnformatMapper = new GetClientLinksRequestUnformatMapper();\\n        this.replyFormatMapper = new GetClientLinksRSFmtMapper();\\n        this.errorReplyFormatMapper = new StandardErrorRSFmtMapper();\\n    }\\n\\n    public String execute(GetClientLinksRequestXml requestXml) throws Exception {\\n        GetClientLinksRequest request = requestUnformatMapper.toBusinessInput(requestXml);\\n        OperationContext context = new OperationContext();\\n        context.setValueAt(\\\"ClientId\\\", request.getClientId());\\n        context.setValueAt(\\\"BankId\\\", request.getBankId());\\n        context.setValueAt(\\\"HOST_HEADER.HOST_KEY\\\", \\\"GCLN\\\");\\n\\n        int rc;\\n        try (Connection connection = dataSource.getConnection()) {\\n            context.setConnection(connection);\\n            rc = getClientLinksStep.execute(context);\\n        }\\n\\n        if (rc == 0) {\\n            String clientId = (String) context.getValueAt(\\\"ClientId\\\");\\n            List<Object> rawLinks = (List<Object>) context.getValueAt(\\\"Links\\\");\\n            List<GetClientLinksRSFmtMapper.LinkDto> linkDtos = new java.util.ArrayList<>();\\n\\n            if (rawLinks != null) {\\n                for (Object rawLink : rawLinks) {\\n                    if (rawLink instanceof Map) {\\n                        Map<?, ?> map = (Map<?, ?>) rawLink;\\n                        String linkId = (String) map.get(\\\"LinkId\\\");\\n                        String linkDescription = (String) map.get(\\\"LinkDescription\\\");\\n                        String linkUrl = (String) map.get(\\\"LinkUrl\\\");\\n                        Boolean isExternal = (Boolean) map.get(\\\"IsExternal\\\");\\n                        String iconCode = (String) map.get(\\\"IconCode\\\");\\n                        linkDtos.add(new GetClientLinksRSFmtMapper.LinkDto(linkId, linkDescription, linkUrl, isExternal, iconCode));\\n                    }\\n                }\\n            }\\n\\n            GetClientLinksRSFmtMapper.GetClientLinksResponse response = \\n                new GetClientLinksRSFmtMapper.GetClientLinksResponse(clientId, linkDtos);\\n            return replyFormatMapper.format(response);\\n        } else {\\n            String errorCategory;\\n            String errorNumber;\\n            String errorDescription;\\n\\n            if (rc == 4) {\\n                noLinksFoundStep.execute(context);\\n                errorCategory = noLinksFoundStep.getErrorCategory();\\n                errorNumber = noLinksFoundStep.getErrorNumber();\\n            } else if (rc == 8) {\\n                databaseErrorStep.execute(context);\\n                errorCategory = databaseErrorStep.getErrorCategory();\\n                errorNumber = databaseErrorStep.getErrorNumber();\\n            } else {\\n                technicalError.execute(context);\\n                errorCategory = technicalError.getErrorCategory();\\n                errorNumber = technicalError.getErrorNumber();\\n            }\\n\\n            errorDescription = (String) context.getValueAt(\\\"ErrorDescription\\\");\\n            String requestId = (String) context.getValueAt(\\\"RequestId\\\");\\n\\n            StandardErrorRSFmtMapper.ErrorReply errorReply = \\n                new StandardErrorRSFmtMapper.ErrorReply(errorCategory, errorNumber, errorDescription, requestId);\\n            return errorReplyFormatMapper.format(errorReply);\\n        }\\n    }\\n}\\n\"}], \"operation_contract\": {\"sources\": [{\"identity\": \"com.ibm.il.dse.cc.cut.CCDSEServerOperation\", \"content_hash\": \"fcaf68594b17326659d327bcc975553a231d2d1e62f7b741959b9e142603d288\"}], \"units\": [{\"unit_id\": \"configured_step-3a42c4326e3d7f21467b61b2\", \"apis\": [{\"type_name\": \"com.company.generated.units.u3a42c4326e3d.DatabaseErrorStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\", \"public java.lang.String getErrorCategory()\", \"public java.lang.String getErrorNumber()\"]}, {\"type_name\": \"com.company.generated.units.u3a42c4326e3d.OperationContext\", \"method_signatures\": [\"public java.lang.Object getValueAt(java.lang.String)\", \"public void setValueAt(java.lang.String, java.lang.Object)\", \"public void setConnection(java.sql.Connection)\", \"public java.sql.Connection getConnection()\"]}], \"dependency_units\": [], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-3a42c4326e3d7f21467b61b2\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.common.MapErrorByValueAlways\"]}, {\"unit_id\": \"configured_step-9d214a54d7b141366dcd456c\", \"apis\": [{\"type_name\": \"com.company.generated.units.u9d214a54d7b1.TechnicalErrorStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\", \"public java.lang.String getErrorCategory()\", \"public java.lang.String getErrorNumber()\"]}], \"dependency_units\": [\"configured_step-3a42c4326e3d7f21467b61b2\"], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-9d214a54d7b141366dcd456c\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.common.MapErrorByValueAlways\"]}, {\"unit_id\": \"configured_step-42b95631a1866d97e7e0cbfa\", \"apis\": [{\"type_name\": \"com.company.generated.units.u42b95631a186.GetClientLinksStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\"]}], \"dependency_units\": [\"configured_step-3a42c4326e3d7f21467b61b2\"], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-42b95631a1866d97e7e0cbfa\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.internet.db.GetClientLinksSP\"]}, {\"unit_id\": \"configured_step-3643d2141e0adb1bddc660d7\", \"apis\": [{\"type_name\": \"com.company.generated.units.u3643d2141e0a.NoLinksFoundStep\", \"method_signatures\": [\"public int execute(com.company.generated.units.u3a42c4326e3d.OperationContext)\", \"public java.lang.String getErrorCategory()\", \"public java.lang.String getErrorNumber()\"]}], \"dependency_units\": [\"configured_step-3a42c4326e3d7f21467b61b2\"], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"configured_step-3643d2141e0adb1bddc660d7\", \"com.ibm.dse.base.CCOperationStep\", \"com.ibm.dse.base.Context\", \"com.ibm.il.dse.operations.common.MapErrorByValueAlways\"]}, {\"unit_id\": \"request_unformat-561a01497abb3d3133b663f0\", \"apis\": [{\"type_name\": \"com.company.generated.units.u561a01497abb.GetClientLinksRequestUnformatMapper\", \"method_signatures\": [\"public com.company.generated.units.u561a01497abb.GetClientLinksRequest toBusinessInput(com.company.generated.units.u561a01497abb.GetClientLinksRequestXml)\", \"public com.company.generated.units.u561a01497abb.GetClientLinksRequest unformat(java.lang.String)\"]}], \"dependency_units\": [], \"requirements\": {\"business\": \"Preserve this complete configured unit's evidenced behavior\"}, \"evidence_ids\": [\"request_unformat-561a01497abb3d3133b663f0\", \"com.ibm.dse.base.Context\", \"com.ibm.dse.base.Tag\", \"com.ibm.il.dse.cc.decorator.CCPadding\", \"com.ibm.il.dse.cc.format.CCString\", \"com.ibm.il.dse.cc.format.CCXML\"]}, {\"unit_id\": \"response_format-5dfecf09ff9fd30503abf76e\", \"apis\": [{\"type_name\": \"com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper\", \"method_signatures\": [\"public java.lang.String format(com.company.generated.units.u5dfecf09ff9f.GetClientLinksRSFmtMapper$GetClientLinksResponse)\", \"public com.company.generated.units.u5dfecf09f