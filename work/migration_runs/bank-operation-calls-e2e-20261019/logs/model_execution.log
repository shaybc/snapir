 [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Request Wire Type\"}, \"success_wire_type\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Success Wire Type\"}, \"error_wire_type\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Error Wire Type\"}, \"service_requirements\": {\"additionalProperties\": {\"type\": \"string\"}, \"title\": \"Service Requirements\", \"type\": \"object\"}, \"step_dependencies\": {\"items\": {\"$ref\": \"#/$defs/OperationDependency\"}, \"title\": \"Step Dependencies\", \"type\": \"array\"}, \"runtime_resources\": {\"items\": {\"$ref\": \"#/$defs/OperationResource\"}, \"title\": \"Runtime Resources\", \"type\": \"array\"}, \"unresolved_questions\": {\"items\": {\"type\": \"string\"}, \"title\": \"Unresolved Questions\", \"type\": \"array\"}, \"schema_version\": {\"default\": \"v1\", \"title\": \"Schema Version\", \"type\": \"string\"}}, \"required\": [\"sources\", \"units\", \"service_api\", \"request_type\", \"success_type\", \"error_type\"], \"title\": \"OperationDataContract\", \"type\": \"object\"}, \"OperationDependency\": {\"additionalProperties\": false, \"description\": \"Bind a configured step to a typed constructor argument and service field.\", \"properties\": {\"binding_id\": {\"minLength\": 1, \"title\": \"Binding Id\", \"type\": \"string\"}, \"unit_id\": {\"minLength\": 1, \"title\": \"Unit Id\", \"type\": \"string\"}, \"type_name\": {\"minLength\": 1, \"title\": \"Type Name\", \"type\": \"string\"}, \"parameter_name\": {\"pattern\": \"^[A-Za-z_$][\\\\w$]*$\", \"title\": \"Parameter Name\", \"type\": \"string\"}, \"field_name\": {\"pattern\": \"^[A-Za-z_$][\\\\w$]*$\", \"title\": \"Field Name\", \"type\": \"string\"}}, \"required\": [\"binding_id\", \"unit_id\", \"type_name\", \"parameter_name\", \"field_name\"], \"title\": \"OperationDependency\", \"type\": \"object\"}, \"OperationResource\": {\"additiona