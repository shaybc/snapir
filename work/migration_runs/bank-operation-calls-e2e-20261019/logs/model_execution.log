.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"rules\": [\"Keep each test focused on one evidenced outcome or side effect.\", \"Cover meaningful behavior across the bundle, not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\