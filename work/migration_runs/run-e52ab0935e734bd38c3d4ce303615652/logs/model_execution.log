+ \\\"</TargetAccount>\\\"\\n            + \\\"<Amount>\\\" + amt + \\\"</Amount>\\\"\\n            + \\\"</FraudCheckRequest>\\\";\\n    }\\n\\n    private int parseFraudScore(String response) {\\n        // Simplified parser for demo\\n        int start = response.indexOf(\\\"<Score>\\\") + 7;\\n        int end   = response.indexOf(\\\"</Score>\\\");\\n        if (start > 6 && end > start) {\\n            return Integer.parseInt(response.substring(start, end));\\n        }\\n        return 0;\\n    }\\n\\n    private String parseFraudDecision(String response) {\\n        return response.contains(\\\"<Decision>BLOCK</Decision>\\\") ? \\\"BLOCK\\\" : \\\"ALLOW\\\";\\n    }\\n}\\n\",\n  \"dependencies\": []\n}","thought_signature":"EmAKXgFpFH0TWpCGTEhqBNMZ4ztuDysKyxUMkq8Ay0zQ-wNjS-x0KSgg6MULxRROqHyJtOvg-BmvhKUImvc3d0korXSCB1y032clZJ4ts4ebPXSHnU1MYHrE-T1gK94dl6c="}],"role":"model"},"finish_reason":"STOP","usage_metadata":{"candidates_token_count":1115,"prompt_token_count":52891,"prompt_tokens_details":[{"modality":"TEXT","token_count":52891}],"total_token_count":54006}}
