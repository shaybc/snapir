\", \"maven_coordinates\": null, \"origin\": \"formatter CCXML: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[1]/CCXML[1] -> com.ibm.il.dse.cc.format.CCXML requires AbstractFormatElement\", \"treatment\": \"replace\"}, {\"behavior_description\": \"Replace Composer runtime behavior using the embedded component contracts\", \"behavior_evidence\": [{\"content_hash\": \"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"4. Runtime Execution Model\"}, {\"content_hash\": \"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"5. Context\"}, {\"content_hash\": \"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"6. Formats and the Format/Unformat Process\"}, {\"content_hash\": \"0dae02d0709a670195856f35ecba11496c6e6987d38f2be86dd13838877833fd\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"7. Decorators\"}], \"class_name\": \"com.ibm.il.dse.cc.format.AbstractFormatElement\", \"maven_coordinates\": null, \"origin\": \"formatter NumberFormat: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[2]/CCXML[1]/NumberFormat[2] -> com.ibm.il.dse.cc.format.NumberFormat requires AbstractFormatElement\", \"treatment\": \"replace\"}], \"ini_values\": null, \"kind\": \"ibm_java\", \"library_plan_fingerprint\": \"27ff66f2d707a271a068430137a97de4ffc4a9378638d67d407d1cf0508c5153\", \"managed_library_id\": null, \"managed_project_operation\": \"TransferFundsOp\", \"operation_fields\": null, \"primary_source_content\": \"package com.ibm.il.dse.cc.format;\\n\\nimport com.ibm.dse.base.Context;\\nimport com.ibm.dse.base.Tag;\\nimport java.text.SimpleDateFormat;\\nimport java.util.Date;\\n\\n/**\\n * Date field formatter with configurable pattern.\\n *\\n * Attributes:\\n *   dataName      - XML element name and context field name\\n *   pattern       - Java date format pattern (e.g. \\\"yyyyMMdd\\\")\\n *   useSep        - \\\"yes\\\"|\\\"no\\\" \\u2014 whether to include separator characters\\n *   fourDigYear   - \\\"yes\\\"|\\\"no\\\" \\u2014 enforce 4-digit year\\n *   onFailed      - \\\"current\\\" = use current date if parse fails\\n */\\npublic class CCDate extends AbstractFormatElement {\\n\\n    private String dataName;\\n    private String pattern      = \\\"yyyyMMdd\\\";\\n    private boolean useSep      = false;\\n    private boolean fourDigYear = true;\\n    private String  onFailed    = null;\\n\\n    @Override\\n    public void initializeFrom(Tag tag) {\\n        this.dataName    = tag.getAttribute(\\\"dataName\\\");\\n        String p = tag.getAttribute(\\\"pattern\\\");\\n        if (p != null) this.pattern = p;\\n        this.useSep     = \\\"yes\\\".equalsIgnoreCase(tag.getAttribute(\\\"useSep\\\"));\\n        this.fourDigYear = !\\\"no\\\".equalsIgnoreCase(tag.getAttribute(\\\"fourDigYear\\\"));\\n        this.onFailed   = tag.getAttribute(\\\"onFailed\\\");\\n    }\\n\\n    @Override\\n    public String format(Context ctx) throws Exception {\\n        Object val = ctx.getValueAt(dataName);\\n        if (val == null) return \\\"<\\\" + dataName + \\\"/>\\\";\\n        SimpleDateFormat sdf = new SimpleDateFormat(pattern);\\n        String formatted = (val instanceof Date)\\n            ? sdf.format((Date) val)\\n            : String.valueOf(val);\\n        formatted = applyDecorators(formatted);\\n        return \\\"<\\\" + dataName + \\\">\\\" + formatted + \\\"</\\\" + dataName + \\\">\\\";\\n    }\\n\\n    @Override\\n    public void unformat(String xml, Context ctx) throws Exception {\\n        String value = extractElement(xml, dataName);\\n        if (value == null || value.isBlank()) {\\n            if (\\\"current\\\".equals(onFailed)) ctx.setValueAt(dataName, new Date());\\n            return;\\n        }\\n        value = removeDecorators(value);\\n        ctx.setValueAt(dataName, new SimpleDateFormat(pattern).parse(value));\\n    }\\n\\n    private String applyDecorators(String v) { throw new UnsupportedOperationException(); }\\n    private String removeDecorators(String v) { throw new UnsupportedOperationException(); }\\n    private String extractElement(String x, String n) { throw new UnsupportedOperationException(); }\\n}\\n\", \"relationship_context\": \"{\\\"operation_id\\\": \\\"TransferFundsOp\\\", \\\"channel\\\": \\\"INTERNET\\\", \\\"run_id\\\": \\\"run-e52ab0935e734bd38c3d4ce303615652\\\", \\\"status\\\": \\\"READY\\\", \\\"blocking_issues\\\": [], \\\"source_xml_path\\\": \\\"C:\\\\\\\\GitHub\\\\\\\\shaybc\\\\\\\\snapir\\\\\\\\bank-demo\\\\\\\\composer\\\\\\\\Workspace\\\\\\\\WSBCC_INTERNET\\\\\\\\src\\\\\\\\Xml Definition\\\\\\\\Channel\\\\\\\\INTERNET\\\\\\\\selfDefOper\\\\\\\\TransferFunds.xml\\\", \\\"operation_fields\\\": \\\"CHANNEL_ID=INTERNET,MAX_RETRY=3\\\", \\\"ini_values\\\": [\\\"TransferStatus=PENDING\\\", \\\"FraudScore=0\\\"], \\\"host_key\\\": \\\"TRFR\\\", \\\"ref_formats\\\": {\\\"csErrorReplyFormat\\\": \\\"StandardErrorRSFmt\\\", \\\"csReplyFormat\\\": \\\"TransferFundsRSFmt\\\", \\\"csRequestFormat\\\": \\\"TransferFundsRQFmt\\\"}, \\\"return_body_switches\\\": {\\\"0\\\": \\\"ErrorBody\\\"}, \\\"included_opstep_ids\\\": [\\\"ValidateTransfer\\\", \\\"CheckLimits\\\", \\\"FraudCheck\\\", \\\"SkipFraudOnTimeout\\\", \\\"ExecuteTransfer\\\", \\\"ValidationFailed\\\", \\\"InsufficientFunds\\\", \\\"DailyLimitExceeded\\\", \\\"AccountNotEligible\\\", \\\"FraudSuspected\\\", \\\"CoreBankingRejected\\\", \\\"TransferAlreadyProcessed\\\", \\\"DatabaseError\\\", \\\"TechnicalError\\\"], \\\"excluded_opsteps\\\": [], \\\"routing_graph\\\": {\\\"ValidateTransfer\\\": {\\\"on0Do\\\": \\\"CheckLimits\\\", \\\"onOtherDo\\\": \\\"ValidationFailed\\\"}, \\\"CheckLimits\\\": {\\\"on0Do\\