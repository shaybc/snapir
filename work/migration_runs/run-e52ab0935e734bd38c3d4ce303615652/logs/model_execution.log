: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[1]/CCXML[1] -> com.ibm.il.dse.cc.format.CCXML requires AbstractFormatElement\", \"treatment\": \"replace\"}, {\"behavior_description\": \"Replace Composer runtime behavior using the embedded component contracts\", \"behavior_evidence\": [{\"content_hash\": \"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"4. Runtime Execution Model\"}, {\"content_hash\": \"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"5. Context\"}, {\"content_hash\": \"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"6. Formats and the Format/Unformat Process\"}, {\"content_hash\": \"0dae02d0709a670195856f35ecba11496c6e6987d38f2be86dd13838877833fd\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"7. Decorators\"}], \"class_name\": \"com.ibm.il.dse.cc.format.AbstractFormatElement\", \"maven_coordinates\": null, \"origin\": \"formatter NumberFormat: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[2]/CCXML[1]/NumberFormat[2] -> com.ibm.il.dse.cc.format.NumberFormat requires AbstractFormatElement\", \"treatment\": \"replace\"}], \"ini_values\": null, \"kind\": \"ibm_java\", \"library_plan_fingerprint\": \"42fcd3624499650166b223806e5faac4792d01555e62af37a936256994f159bd\", \"managed_library_id\": \"shared-33e19da28f26\", \"managed_project_operation\": null, \"operation_fields\": null, \"primary_source_content\": \"package com.ibm.il.dse.cc.format;\\n\\nimport com.ibm.dse.base.Context;\\nimport com.ibm.dse.base.Tag;\\n\\n/**\\n * String field formatter. Maps a single XML element to/from a context field.\\n *\\n * Attributes:\\n *   dataName - the XML element name AND the context field name\\n *\\n * Any decorators that immediately follow this tag in the XML definition\\n * are applied to the string value (addDecoration on format, removeDecoration\\n * in reverse order on unformat).\\n */\\npublic class CCString extends AbstractFormatElement {\\n\\n    private String dataName;\\n\\n    @Override\\n    public void initializeFrom(Tag tag) {\\n        this.dataName = tag.getAttribute(\\\"dataName\\\");\\n    }\\n\\n    /** format: reads context[dataName] -> applies decorators -> emits XML element */\\n    @Override\\n    public String format(Context ctx) throws Exception {\\n        String value = (String) ctx.getValueAt(dataName);\\n        value = applyDecorators(value);          // addDecoration chain (forward order)\\n        return \\\"<\\\" + dataName + \\\">\\\" + value + \\\"</\\\" + dataName + \\\">\\\";\\n    }\\n\\n    /** unformat: reads XML element -> applies decorators in reverse -> writes context[dataName] */\\n    @Override\\n    public void unformat(String xml, Context ctx) throws Exception {\\n        String value = extractElement(xml, dataName);\\n        value = removeDecorators(value);         // removeDecoration chain (reverse order)\\n        ctx.setValueAt(dataName, value);\\n    }\\n\\n    private String applyDecorators(String v)  { throw new UnsupportedOperationException(); }\\n    private String removeDecorators(String v)  { throw new UnsupportedOperationException(); }\\n    private String extractElement(String xml, String name) { throw new UnsupportedOperationException(); }\\n}\\n\", \"relationship_context\": \"{\\\"component\\\": \\\"implementation:f12ae0fb7b6d2e14c58e16eb03691dddf49ce5442e02269c481bd101d1102ce9\\\", \\\"consumers\\\": [\\\"INTERNET/GetAccountDetailsOp\\\", \\\"INTERNET/GetClientAccountsOp\\\", \\\"INTERNET/GetClientLinksOp\\\", \\\"INTERNET/TransferFundsOp\\\", \\\"IVR/GetAccountBalanceOp\\\", \\\"IVR/GetClientAccountsOp\\\"]}\", \"return_body_switches\": null, \"schema_version\": \"v1\", \"service_layer_requirements\": null, \"source_component_hash\": \"ea468aff40ac74ec3555cd7464e729d0fd1f42f83a6652e388be733c4d153cc4\", \"source_component_key\": \"implementation:f12ae0fb7b6d2e14c58e16eb03691dddf49ce5442e02269c481bd101d1102ce9\", \"supporting_source_contents\": {}, \"target_kind\": \"native_java\", \"converted_dependency_apis\": [{\"source_component_key\": \"implementation:59bfbb8aa1e28ce2c6a012013034b4eb9095cf8f3864ea011cd78a6d16f64880\", \"logical_id\": \"com.ibm.dse.base.Tag\", \"library_id\": \"shared-33e19da28f26\", \"java_source\": \"package com.company.generated;\\r\\n\\r\\nimport java.util.HashMap;\\r\\nimport java.util.Map;\\r\\n\\r\\n/** Minimal demo configuration tag containing string attributes. */\\r\\npublic class Tag {\\r\\n    private final Map<String, String> attributes = new HashMap<>();\\r\\n\\r\\n    public Tag() {\\r\\n    }\\r\\n\\r\\n    public Tag(Map<String, String> attributes) {\\r\\n        this.attributes.putAll(attributes);\\r\\n    }\\r\\n\\r\\n    public String getAttribute(String name) {\\r\\n        return attributes.get(name);\\r\\n    }\\r\\n\\r\\n    public void setAttribute(String name, String value) {\\r\\n        attributes.put(name, value);\\r\\n    }\\r\\n}\", \"source_hash\": \"4602bd773bae21bc872469153e6dda7b66771eb0724b5e951ffd07b7fa5e610b\"}, {\"source_component_key\": \"implementation:884325dc843f324a4518c4061045395a5f81b795ae12333a8e089a1b25060584\", \"logical_id\": \"com.ibm.dse.base.Context\", \"library_id\": \"shared-33e19da28f26\", \"java_source\": \"package com.company.generated;\\r\\n\\r\\nimport java.sql.Connection;\\r\\nimport java.util.HashMap;\\r\\nimport java.util.Map;\\r\\nimport java.util.Objects;\\r\\nimport javax.sql.DataSource;\\r\\n\\r\\n/** Demo operation context containing named values and an externally supplied JDBC connection or DataSource. */\\r\\npublic class Context {\\r\\n    private final Map<String, Object> values = new HashMap<>();\\r\\n    private Connection connection;\\r\\n    private final DataSource dataSource;\\r\\n\\r\\n    public Context() {\\r\\n        this.dataSource = null;\\r\\n    }\\r\\n\\r\\n    public Context(DataSource dataSource) {\\r\\n        this.dataSource = dataSource;\\r\\n    }\\r\\n\\r\\n    public Object getValueAt(String name) {\\r\\n        return values.get(Objects.requireNonNull(name, \\\"Context field name\\\"));\\r\\n    }\\r\\n\\r\\n    public void setValueAt(String name, Object value) {\\r\\n        values.put(Objects.requireNonNull(name, \\\"Context field name\\\"), value);\\r\\n    }\\r\\n\\r\\n    /** The caller owns the connection and its transaction lifecycle. */\\r\\n    public void setConnection(Connection connection) {\\r\\n        this.connection = Objects.requireNonNull(connection, \\\"JDBC connection\\\");\\r\\n    }\\r\\n\\r\\n    public Connection getConnection() throws java.sql.SQLException {\\r\\n        if (connection != null) {\\r\\n            return connection;\\r\\n        }\\r\\n        if (dataSource != null) {\\r\\n            return dataSource.getConnection();\\r\\n        }\\r\\n        throw new IllegalStateException(\\\"Configure a JDBC connection or DataSource before executing a database step\\\");\\r\\n    }\\r\\n}\\r\\n\", \"source_hash\": \"b3b76a32be1a671172c87d5ad63e5a1e63cbf8e74fa0626c6a4a8195fb471ec4\"}]}"}],"role":"user"}
