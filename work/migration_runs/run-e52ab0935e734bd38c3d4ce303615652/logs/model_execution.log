ll, \"origin\": \"formatter CCXML: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[1]/CCXML[1] -> com.ibm.il.dse.cc.format.CCXML requires AbstractFormatElement\", \"treatment\": \"replace\"}, {\"behavior_description\": \"Replace Composer runtime behavior using the embedded component contracts\", \"behavior_evidence\": [{\"content_hash\": \"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"4. Runtime Execution Model\"}, {\"content_hash\": \"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"5. Context\"}, {\"content_hash\": \"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"6. Formats and the Format/Unformat Process\"}, {\"content_hash\": \"0dae02d0709a670195856f35ecba11496c6e6987d38f2be86dd13838877833fd\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"7. Decorators\"}], \"class_name\": \"com.ibm.il.dse.cc.format.AbstractFormatElement\", \"maven_coordinates\": null, \"origin\": \"formatter NumberFormat: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[2]/CCXML[1]/NumberFormat[2] -> com.ibm.il.dse.cc.format.NumberFormat requires AbstractFormatElement\", \"treatment\": \"replace\"}], \"ini_values\": null, \"kind\": \"ibm_java\", \"library_plan_fingerprint\": \"42fcd3624499650166b223806e5faac4792d01555e62af37a936256994f159bd\", \"managed_library_id\": null, \"managed_project_operation\": \"TransferFundsOp\", \"operation_fields\": null, \"primary_source_content\": \"package com.ibm.il.dse.cc.format;\\n\\nimport com.ibm.dse.base.Context;\\nimport com.ibm.dse.base.Tag;\\n\\n/**\\n * Boolean field formatter. Maps \\\"true\\\"/\\\"false\\\" XML values to/from context.\\n *\\n * Attributes:\\n *   dataName - the XML element name and context field name\\n *   trueValue  - XML string representing true  (default: \\\"true\\\")\\n *   falseValue - XML string representing false (default: \\\"false\\\")\\n */\\npublic class CCBoolean extends AbstractFormatElement {\\n\\n    private String dataName;\\n    private String trueValue  = \\\"true\\\";\\n    private String falseValue = \\\"false\\\";\\n\\n    @Override\\n    public void initializeFrom(Tag tag) {\\n        this.dataName   = tag.getAttribute(\\\"dataName\\\");\\n        String tv = tag.getAttribute(\\\"trueValue\\\");\\n        if (tv != null) this.trueValue = tv;\\n        String fv = tag.getAttribute(\\\"falseValue\\\");\\n        if (fv != null) this.falseValue = fv;\\n    }\\n\\n    @Override\\n    public String format(Context ctx) throws Exception {\\n        Object val = ctx.getValueAt(dataName);\\n        boolean b = Boolean.TRUE.equals(val) || \\\"true\\\".equalsIgnoreCase(String.valueOf(val));\\n        return \\\"<\\\" + dataName + \\\">\\\" + (b ? trueValue : falseValue) + \\\"</\\\" + dataName + \\\">\\\";\\n    }\\n\\n    @Override\\n    public void unformat(String xml, Context ctx) throws Exception {\\n        String value = extractElement(xml, dataName);\\n        ctx.setValueAt(dataName, trueValue.equalsIgnoreCase(value));\\n    }\\n\\n    private String extractElement(String xml, String name) { throw new UnsupportedOperationException(); }\\n}\\n\", \"relationship_context\": \"{\\\"operation_id\\\": \\\"TransferFundsOp\\\", \\\"channel\\\": \\\"INTERNET\\\", \\\"run_id\\\": \\\"run-e52ab0935e734bd38c3d4ce303615652\\\", \\\"status\\\": \\\"READY\\\", \\\"blocking_issues\\\": [], \\\"source_xml_path\\\": \\\"C:\\\\\\\\GitHub\\\\\\\\shaybc\\\\\\\\snapir\\\\\\\\bank-demo\\\\\\\\composer\\\\\\\\Workspace\\\\\\\\WSBCC_INTERNET\\\\\\\\src\\\\\\\\Xml Definition\\\\\\\\Channel\\\\\\\\INTERNET\\\\\\\\selfDefOper\\\\\\\\TransferFunds.xml\\\", \\\"operation_fields\\\": \\\"CHANNEL_ID=INTERNET,