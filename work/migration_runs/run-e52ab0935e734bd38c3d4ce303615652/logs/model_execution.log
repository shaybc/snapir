   @Override\\n    public void unformat(String xml, Context ctx) throws Exception {\\n        // If transparent=true, parse children directly from the parent level\\n        if (transparent) {\\n            unformatChildren(xml, ctx);\\n        } else {\\n            String inner = extractElement(xml, dataName);\\n            unformatChildren(inner, ctx);\\n        }\\n    }\\n\\n    private String formatChildren(Context ctx) throws Exception {\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n    private void unformatChildren(String xml, Context ctx) throws Exception {\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n    private String extractElement(String xml, String name) {\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n}\",\n  \"dependencies\": []\n}","thought_signature":"EmAKXgFpFH0T3xitfbXNV0Z1DkuvitHjpt8caIyYDRx-2QVwsqbW3oicJNarSXI2gcIFPJxwf_FBVmQOwWv6xvE8-hAM5dP_fWWNgoTdKvg9EsIG1Vu8w7l9o3qH01Gpmvo="}],"role":"model"},"finish_reason":"STOP","index":0}],"model_version":"gemini-3.5-flash-lite","response_id":"2ZLHauLZJJL8vdIPz7LOuAk","usage_metadata":{"candidates_token_count":550,"prompt_token_count":17892,"prompt_tokens_details":[{"modality":"TEXT","token_count":17892}],"total_token_count":18442},"automatic_function_calling_history":[]}
