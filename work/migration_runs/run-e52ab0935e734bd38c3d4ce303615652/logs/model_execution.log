hen it sees this decorator\\n        // The XML value is returned unchanged\\n        return value;\\n    }\\n\\n    @Override\\n    public String removeDecoration(String value) {\\n        return value;\\n    }\\n}\\n\", \"relationship_context\": \"{\\\"operation_id\\\": \\\"TransferFundsOp\\\", \\\"channel\\\": \\\"INTERNET\\\", \\\"run_id\\\": \\\"run-e52ab0935e734bd38c3d4ce303615652\\\", \\\"status\\\": \\\"READY\\\", \\\"blocking_issues\\\": [], \\\"source_xml_path\\\": \\\"C:\\\\\\\\GitHub\\\\\\\\shaybc\\\\\\\\snapir\\\\\\\\bank-demo\\\\\\\\composer\\\\\\\\Workspace\\\\\\\\WSBCC_INTERNET\\\\\\\\src\\\\\\\\Xml Definition\\\\\\\\Channel\\\\\\\\INTERNET\\\\\\\\selfDefOper\\\\\\\\TransferFunds.xml\\\", \\\"operation_fields\\\": \\\"CHANNEL_ID=INTERNET,MAX_RETRY=3\\\", \\\"ini_values\\\": [\\\"TransferStatus=PENDING\\\", \\\"FraudScore=0\\\"], \\\"host_key\\\": \\\"TRFR\\\", \\\"ref_formats\\\": {\\\"csErrorReplyFormat\\\": \\\"StandardErrorRSFmt\\\", \\\"csReplyFormat\\\": \\\"TransferFundsRSFmt\\\", \\\"csRequestFormat\\\": \\\"TransferFundsRQFmt\\\"}, \\\"return_body_switches\\\": {\\\"0\\\": \\\"ErrorBody\\\"}, \\\"included_opstep_ids\\\": [\\\"ValidateTransfer\\\", \\\"CheckLimits\\\", \\\"FraudCheck\\\", \\\"SkipFraudOnTimeout\\\", \\\"ExecuteTransfer\\\", \\\"ValidationFailed\\\", \\\"InsufficientFunds\\\", \\\"DailyLimitExceeded\\\", \\\"AccountNotEligible\\\", \\\"FraudSuspected\\\", \\\"CoreBankingRejected\\\", \\\"TransferAlreadyProcessed\\\", \\\"DatabaseError\\\", \\\"TechnicalError\\\"], \\\"excluded_opsteps\\\": [], \\\"routing_graph\\\": {\\\"ValidateTransfer\\\": {\\\"on0Do\\\": \\\"CheckLimits\\\", \\\"onOtherDo\\\": \\\"ValidationFailed\\\"}, \\\"CheckLimits\\\": {\\\"on0Do\\\": \\\"FraudCheck\\\", \\\"on3Do\\\": \\\"DailyLimitExceeded\\\", \\\"on4Do\\\": \\\"InsufficientFunds\\\", \\\"on5Do\\\": \\\"AccountNotEligible\\\", \\\"on8Do\\\": \\\"DatabaseError\\\", \\\"onOtherDo\\\": \\\"TechnicalError\\\"}, \\\"FraudCheck\\\": {\\\"on0Do\\\": \\\"Ex