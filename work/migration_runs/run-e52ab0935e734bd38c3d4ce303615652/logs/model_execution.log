ERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[1]/CCXML[1] -> com.ibm.il.dse.cc.format.CCXML requires AbstractFormatElement\", \"treatment\": \"replace\"}, {\"behavior_description\": \"Replace Composer runtime behavior using the embedded component contracts\", \"behavior_evidence\": [{\"content_hash\": \"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"4. Runtime Execution Model\"}, {\"content_hash\": \"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"5. Context\"}, {\"content_hash\": \"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"6. Formats and the Format/Unformat Process\"}, {\"content_hash\": \"0dae02d0709a670195856f35ecba11496c6e6987d38f2be86dd13838877833fd\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"7. Decorators\"}], \"class_name\": \"com.ibm.il.dse.cc.format.AbstractFormatElement\", \"maven_coordinates\": null, \"origin\": \"formatter NumberFormat: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[2]/CCXML[1]/NumberFormat[2] -> com.ibm.il.dse.cc.format.NumberFormat requires AbstractFormatElement\", \"treatment\": \"replace\"}], \"ini_values\": null, \"kind\": \"ibm_java\", \"library_plan_fingerprint\": \"42fcd3624499650166b223806e5faac4792d01555e62af37a936256994f159bd\", \"managed_library_id\": null, \"managed_project_operation\": \"TransferFundsOp\", \"operation_fields\": null, \"primary_source_content\": \"package com.ibm.il.dse.operations.internet.db;\\n\\nimport com.ibm.dse.base.CCOperationStep;\\nimport com.ibm.dse.base.Context;\\n\\nimport java.math.BigDecimal;\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport java.sql.Types;\\n\\n/**\\n * Executes a funds transfer between two accounts in the core banking database.\\n *\\n * Context reads: SourceAccount, TargetAccount, Amount, Currency, TransferReference,\\n *                SessionToken, FraudScore\\n * Context writes: TransferId, TransferStatus, ExecutionDate, ExecutionTime,\\n *                 NewSourceBalance\\n *\\n * Returns:\\n *   0 - transfer executed successfully\\n *   6 - rejected by core banking (account rules, SWIFT, etc.)\\n *   7 - duplicate transfer reference (already processed)\\n *   8 - database error\\n */\\npublic class ExecuteTransferSP extends CCOperationStep {\\n\\n    private static final String SP_NAME =\\n        \\\"{call PKG_TRANSFERS.EXECUTE_TRANSFER(?,?,?,?,?,?,?,?,?,?)}\\\";\\n\\n    private static final int RC_SUCCESS   = 0;\\n    private static final int RC_REJECTED  = 6;\\n    private static final int RC_DUPLICATE = 7;\\n    private static final int RC_DB_ERROR  = 8;\\n\\n    @Override\\n    public int execute() throws Exception {\\n        Context ctx = getContext();\\n\\n        String     sourceAccount = (String)     ctx.getValueAt(\\\"SourceAccount\\\");\\n        String     targetAccount = (String)     ctx.getValueAt(\\\"TargetAccount\\\");\\n        BigDecimal amount        = (BigDecimal) ctx.getValueAt(\\\"Amount\\\");\\n        String     currency      = (String)     ctx.getValueAt(\\\"Currency\\\");\\n        String     reference     = (String)     ctx.getValueAt(\\\"TransferReference\\\");\\n\\n        Connection conn = ctx.getConnection();\\n        try (CallableStatement cs = conn.prepareCall(SP_NAME)) {\\n            // IN params\\n            cs.setString(    1, sourceAccount);\\n            cs.setString(    2, targetAccount);\\n            cs.setBigDecimal(3, amount);\\n            cs.setString(    4, currency != null ? currency.trim() : \\\"ILS\\\");\\n            cs.setString(    5, reference);\\n\\n            // OUT params\\n            cs.registerOutParameter(6,  Types.VARCHAR);   // return code\\n            cs.registerOutParameter(7,  Types.VARCHAR);   // transfer id\\n            cs.registerOutParameter(8,  Types.VARCHAR);   // transfer status\\n            cs.registerOutParameter(9,  Types.DATE);      // execution date\\n            cs.registerOutParameter(10, Types.NUMERIC);   // new source balance\\n\\n            cs.execute();\\n\\n            String spRc = cs.getString(6);\\n            if (\\\"REJECTED\\\".equals(spRc))  return RC_REJECTED;\\n            if (\\\"DUPLICATE\\\".equals(spRc)) return RC_DUPLICATE;\\n\\n            ctx.setValueAt(\\\"TransferId\\\",       cs.getString(7));\\n            ctx.setValueAt(\\\"TransferStatus\\\",   cs.getString(8));\\n            ctx.setValueAt(\\\"ExecutionDate\\\",    cs.getDate(9));\\n            ctx.setValueAt(\\\"ExecutionTime\\\",    new java.util.Date());\\n            ctx.setValueAt(\\\"NewSourceBalance\\\", cs.getBigDecimal(10));\\n\\n        } catch (Exception e) {\\n            ctx.setValueAt(\\\"DatabaseError\\\", e.getMessage());\\n            return RC_DB_ERROR;\\n        }\\n        return RC_SUCCESS;\\n    }\\n}\\n\", \"relationship_context\": \"{\\\"operation_id\\\": \\\"TransferFundsOp\\\", \\\"channel\\\": \\\"INTERNET\\\", \\\"run_id\\\": \\\"run-e52ab0935e734bd38c3d4ce303615652\\\", \\\"status\\\": \\\"READY\\\", \\\"blocking_issues\\\": [], \\\"source_xml_path\\\": \\\"C:\\\\\\\\GitHub\\\\\\\\shaybc\\\\\\\\snapir\\\\\\\\bank-demo\\\\\\\\composer\\\\\\\\Workspace\\\\\\\\WSBCC_INTERNET\\\\\\\\src\\\\\\\\Xml Definition\\\\\\\\Channel\\\\\\\\INTERNET\\\\\\\\selfDefOper\\\\\\\\TransferFunds.xml\\\", \\\"operation_fields\\\": \\\"CHANNEL_ID=INTERNET,MAX_RETRY=3\\\", \\\"ini_values\\\": [\\\"TransferStatus=PENDING\\\", \\\"FraudScore=0\\\"], \\\"host_key\\\": \\\"TRFR\\\", \\\"ref_formats\\\": {\\\"csErrorReplyFormat\\\": \\\"StandardErrorRSFmt\\\", \\\"csReplyFormat\\\": \\\"TransferFundsRSFmt\\\", \\\"csRequestFormat\\\": \\\"TransferFundsRQFmt\\\"}, \\\"return_body_switches\\\": {\\\"0\\\": \\\"ErrorBody\\\"}, \\\"included_opstep_ids\\\": [\\\"ValidateTransfer\\\", \\\"CheckLimits\\\", \\\"FraudCheck\\\", \\\"SkipFraudOnTimeout\\\", \\\"ExecuteTransfer\\\", \\\"ValidationFailed\\\", \\\"InsufficientFunds\\\", \\\"DailyLimitExceeded\\\", \\\"AccountNotEligible\\\", \\\"FraudSuspected\\\", \\\"CoreBankingRejected\\\", \\\"TransferAlreadyProcessed\\\", \\\"DatabaseError\\\", \\\"TechnicalError\\\"], \\\"excluded_opsteps\\\": [], \\\"routing_graph\\\": {\\\"ValidateTransfer\\\": {\\\"on0Do\\\": \\\"CheckLimits\\\", \\\"onOtherDo\\\": \\\"ValidationFailed\\\"}, \\\"CheckLimits\\\": {\\\"on0Do\\\": \\\"FraudCheck\\\", \\\"on3Do\\\": \\\"DailyLimitExceeded\\\", \\\"on4Do\\\": \\\"InsufficientFunds\\\", \\\"on5Do\\\": \\\"AccountNotEligible\\\", \\\"on8Do\\\": \\\"DatabaseError\\\", \\\"onOtherDo\\\": \\\"TechnicalError\\\"}, \\\"FraudCheck\\\": {\\\"on0Do\\\": \\\"ExecuteTransfer\\\", \\\"on2Do\\\": \\\"FraudSuspected\\\", \\\"onOtherDo\\\": \\\"TechnicalError\\\", \\\"onTimeoutDo\\\": \\\"SkipFraudOnTimeout\\\"}, \\\"SkipFraudOnTimeout\\\": {\\\"on0Do\\\": \\\"ExecuteTransfer\\\", \\\"onOtherDo\\\": \\\"TechnicalError\\\"}, \\\"ExecuteTransfer\\\": {\\\"on0Do\\\": \\\"end\\\", \\\"on6Do\\\": \\\"CoreBankingRejected\\\", \\\"on7Do\\\": \\\"TransferAlreadyProcessed\\\", \\\"on8Do\\\": \\\"DatabaseError\\\", \\\"onOtherDo\\\": \\\"TechnicalError\\\"}, \\\"ValidationFailed\\\": {\\\"onOtherDo\\\": \\\"end\\\"}, \\\"InsufficientFunds\\\": {\\\"onOtherDo\\\": \\\"end\\\"}, \\\"DailyLimitExceeded\\\": {\\\"onOtherDo\\\": \\\"end\\\"}, \\\"AccountNotEligible\\\": {\\\"onOtherDo\\\": \\\"end\\\"}, \\\"FraudSuspected\\\": {\\\"onOtherDo\\\": \\\"end\\\"}, \\\"CoreBankingRejected\\\": {\\\"onOtherDo\\\": \\\"end\\\"}, \\\"TransferAlreadyProcessed\\\": {\\\"onOtherDo\\\": \\\"end\\\"}, \\\"DatabaseError\\\": {\\\"onOtherDo\\\": \\\"end\\\"}, \\\"TechnicalError\\\": {\\\"onOtherDo\\\": \\\"end\\\"}}, \\\"java_classes\\\": [{\\\"fqcn\\\": \\\"com.ibm.il.dse.operations.common.ValidateInputFields\\\", \\\"source_file\\\": \\\"C:\\\\\\\\GitHub\\\\\\\\shaybc\\\\\\\\snapir\\\\\\\\bank-demo\\\\\\\\composer\\\\\\\\Workspace\\\\\\\\WSBCC_INTERNET\\\\\\\\src\\\\\\\\com\\\\\\\\ibm\\\\\\\\il\\\\\\\\dse\\\\\\\\operations\\\\\\\\common\\\\\\\\ValidateInputFields.java\\\", \\\"parent_class\\\": \\\"com.ibm.dse.base.CCOperationStep\\\", \\\"interfaces\\\": [], \\\"has_ibm_dependency\\\": true, \\\"ibm_imports\\\": [\\\"com.ibm.dse.base.CCOperationStep\\\", \\\"com.ibm.dse.base.Context\\\"], \\\"return_codes\\\": {\\\"0\\\": [\\\"all required fields are present and non-blank\\\"], \\\"1\\\": [\\\"one or more required fields are missing or blank\\\"]}, \\\"shared\\\": true}, {\\\"fqcn\\\": \\\"com.ibm.il.dse.operations.internet.db.ValidateTransferLimitsSP\\\", \\\"source_file\\\": \\\"C:\\\\\\\\GitHub\\\\\\\\shaybc\\\\\\\\snapir\\\\\\\\bank-demo\\\\\\\\composer\\\\\\\\Workspace\\\\\\\\WSBCC_INTERNET\\\\\\\\src\\\\\\\\com\\\\\\\\ibm\\\\\\\\il\\\\\\\\dse\\\\\\\\operations\\\\\\\\internet\\\\\\\\db\\\\\\\\ValidateTransferLimitsSP.java\\\", \\\"parent_class\\\": \\\"com.ibm.dse.base.CCOperationStep\\\", \\\"interfaces\\\": [], \\\"has_ibm_dependency\\\": true, \\\"ibm_imports\\\": [\\\"com.ibm.dse.base.CCOperationStep\\\", \\\"com.ibm.dse.base.Context\\\"], \\\"return_codes\\\": {\\\"0\\\": [\\\"transfer is within limits and account is eligible\\\", \\\"rc success\\\"], \\\"3\\\": [\\\"daily transfer limit would be exceeded\\\", \\\"rc limit exceeded\\\"], \\\"4\\\": [\\\"insufficient available funds\\\", \\\"rc insufficient\\\"], \\\"5\\\": [\\\"source account not eligible for outgoing transfers\\\", \\\"rc not eligible\\\"], \\\"8\\\": [\\\"database error\\\", \\\"rc db error\\\"]}, \\\"shared\\\": false}, {\\\"fqcn\\\": \\\"com.ibm.il.dse.operations.internet.service.CallFraudDetection\\\", \\\"source_file\\\": \\\"C:\\\\\\\\GitHub\\\\\\\\shaybc\\\\\\\\snapir\\\\\\\\bank-demo\\\\\\\\composer\\\\\\\\Workspace\\\\\\\\WSBCC_INTERNET\\\\\\\\src\\\\\\