ss_name\": \"com.ibm.il.dse.cc.format.AbstractFormatElement\", \"maven_coordinates\": null, \"origin\": \"formatter CCXML: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[1]/CCXML[1] -> com.ibm.il.dse.cc.format.CCXML requires AbstractFormatElement\", \"treatment\": \"replace\"}, {\"behavior_description\": \"Replace Composer runtime behavior using the embedded component contracts\", \"behavior_evidence\": [{\"content_hash\": \"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"4. Runtime Execution Model\"}, {\"content_hash\": \"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"5. Context\"}, {\"content_hash\": \"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"6. Formats and the Format/Unformat Process\"}, {\"content_hash\": \"0dae02d0709a670195856f35ecba11496c6e6987d38f2be86dd13838877833fd\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"7. Decorators\"}], \"class_name\": \"com.ibm.il.dse.cc.format.AbstractFormatElement\", \"maven_coordinates\": null, \"origin\": \"formatter NumberFormat: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[2]/CCXML[1]/NumberFormat[2] -> com.ibm.il.dse.cc.format.NumberFormat requires AbstractFormatElement\", \"treatment\": \"replace\"}], \"ini_values\": null, \"kind\": \"ibm_java\", \"library_plan_fingerprint\": \"42fcd3624499650166b223806e5faac4792d01555e62af37a936256994f159bd\", \"managed_library_id\": \"shared-33e19da28f26\", \"managed_project_operation\": null, \"operation_fields\": null, \"primary_source_content\": \"package com.ibm.il.dse.cc.format;\\n\\nimport com.ibm.dse.base.Context;\\nimport com.ibm.dse.base.Tag;\\n\\n/**\\n * XML container formatter. Groups child formatter tags into an XML element.\\n *\\n * Key attributes:\\n *   dataName       - the XML element name\\n *   transparent    - when \\\"true\\\", the wrapper element is NOT emitted on the wire;\\n *                    child fields appear at the parent level\\n *   unnamed        - controls whether dataName appears as the element name\\n *\\n * Any formatter type (including CCXML itself) can have decorators following it.\\n */\\npublic class CCXML extends AbstractFormatElement {\\n\\n    private String  dataName;\\n    private boolean transparent = false;\\n    private boolean unnamed     = false;\\n\\n    @Override\\n    public void initializeFrom(Tag tag) {\\n        this.dataName    = tag.getAttribute(\\\"dataName\\\");\\n        String t = tag.getAttribute(\\\"transparent\\\");\\n        if (\\\"true\\\".equalsIgnoreCase(t)) this.transparent = true;\\n        String u = tag.getAttribute(\\\"unnamed\\\");\\n        if (\\\"true\\\".equalsIgnoreCase(u)) this.unnamed = true;\\n        super.initializeFrom(tag);\\n    }\\n\\n    @Override\\n    public String format(Context ctx) throws Exception {\\n        // If transparent=true, do not emit the wrapper element\\n        if (transparent) {\\n            return formatChildren(ctx);\\n        }\\n        return \\\"<\\\" + dataName + \\\">\\\" + formatChildren(ctx) + \\\"</\\\" + dataName + \\\">\\\";\\n    }\\n\\n    @Override\\n    public void unformat(String xml, Context ctx) throws Exception {\\n        // If transparent=true, parse children directly from the parent level\\n        if (transparent) {\\n            unformatChildren(xml, ctx);\\n        } else {\\n            String inner = extractElement(xml, dataName);\\n            unformatChildren(inner, ctx);\\n        }\\n    }\\n\\n    private String formatChildren(Context ctx) throws Exception {\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n    private void unformatChildren(String xml, Context ctx) throws Exception {\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n    private String extractElement(String xml, String name) {\\n        throw new UnsupportedOperationException(\\\"Runtime method\\\");\\n    }\\n}\\n\", \"relationship_context\": \"{\\\"component\\\": \\\"implementation:59d971bae6a1d523f0ded2c813a6cca9c1aef0dc9e8edcc20838799402734da4\\\", \\\"consumers\\\": [\\\"INTERNET/GetAccountDetailsOp\\\", \\\"INTERNET/GetClientAccountsOp\\\", \\\"INTERNET/GetClientLinksOp\\\", \\\"INTERNET/TransferFundsOp\\\", \\\"IVR/GetAccountBalanceOp\\\", \\\"IVR/GetClientAccountsOp\\\"]}\", \"return_body_switches\": null, \"schema_version\": \"v1\", \"service_layer_requirements\": null, \"source_component_hash\": \"e732cb3877944fcb8f24a7c2a74b182372df732f988bc1d7fd48f20283fbc0d2\", \"source_component_key\": \"implementation:59d971bae6a1d523f0ded2c813a6cca9c1aef0dc9e8edcc20838799402734da4\", \"supporting_source_contents\": {}, \"target_kind\": \"native_java\", \"converted_dependency_apis\": [{\"source_component_key\": \"implementation:59bfbb8aa1e28ce2c6a012013034b4eb9095cf8f3864ea011cd78a6d16f64880\", \"logical_id\": \"com.ibm.dse.base.Tag\", \"library_id\": \"shared-33e19da28f26\", \"java_source\": \"package com.company.generated;\\r\\n\\r\\nimport java.util.HashMap;\\r\\nimport java.util.Map;\\r\\n\\r\\n/** Minimal demo configuration tag containing string attributes. */\\r\\npublic class Tag {\\r\\n    private final Map<String, String> attributes = new HashMap<>();\\r\\n\\r\\n    public Tag() {\\r\\n    }\\r\\n\\r\\n    public Tag(Map<String, String> attributes) {\\r\\n        this.attributes.putAll(attributes);\\r\\n    }\\r\\n\\r\\n    public String getAttribute(String name) {\\r\\n        return attributes.get(name);\\r\\n    }\\r\\n\\r\\n    public void setAttribute(String name, String value) {\\r\\n        attributes.put(name, value);\\r\\n    }\\r\\n}\", \"source_hash\": \"4602bd773bae21bc872469153e6dda7b66771eb0724b5e951ffd07b7fa5e610b\"}, {\"source_component_key\": \"implementation:884325dc843f324a4518c4061045395a5f81b795ae12333a8e089a1b25060584\", \"logical_id\": \"com.ibm.dse.base.Context\", \"library_id\": \"shared-33e19da28f26\", \"java_source\": \"package com.company.generated;\\r\\n\\r\\nimport java.sql.Connection;\\r\\nimport java.util.HashMap;\\r\\nimport java.util.Map;\\r\\nimport java.util.Objects;\\r\\nimport javax.sql.DataSource;\\r\\n\\r\\n/** Demo operation context containing named values and an externally supplied JDBC connection or DataSource. */\\r\\npublic class Context {\\r\\n    private final Map<String, Object> values = new HashMap<>();\\r\\n    private Connection connection;\\r\\n    private final DataSource dataSource;\\r\\n\\r\\n    public Context() {\\r\\n        this.dataSource = null;\\r\\n    }\\r\\n\\r\\n    public Context(DataSource dataSource) {\\r\\n        this.dataSource = dataSource;\\r\\n    }\\r\\n\\r\\n    public Object getValueAt(String name) {\\r\\n        return values.get(Objects.requireNonNull(name, \\\"Context field name\\\"));\\r\\n    }\\r\\n\\r\\n    public void setValueAt(String name, Object value) {\\r\\n        values.put(Objects.requireNonNull(name, \\\"Context field name\\\"), value);\\r\\n    }\\r\\n\\r\\n    /** The caller owns the connection and its transaction lifecycle. */\\r\\n    public void setConnection(Connection connection) {\\r\\n        this.connection = Objects.requireNonNull(connection, \\\"JDBC connection\\\");\\r\\n    }\\r\\n\\r\\n    public Connection getConnection() throws java.sql.SQLException {\\r\\n        if (connection != null) {\\r\\n            return connection;\\r\\n        }\\r\\n        if (dataSource != null) {\\r\\n            return dataSource.getConnection();\\r\\n        }\\r\\n        throw new IllegalStateException(\\\"Configure a JDBC connection or DataSource before executing a database step\\\");\\r\\n    }\\r\\n}\\r\\n\", \"source_hash\": \"b3b76a32be1a671172c87d5ad63e5a1e63cbf8e74fa0626c6a4a8195fb471ec4\"}]}"}],"role":"user"}],"config":{"system_instruction":"\nYou are converting an IBM WebSphere WSBCC Java implClass to clean native Java.\n\nYou will receive:\n- JAVA_SOURCE: the full Java source code to convert\n- PARENT_CLASS: the FQCN of the class this extends (may be null)\n- INTERFACES: list of interfaces this class implements\n- IBM_IMPORTS: list of IBM-specific imports to remove\n- BEHAVIOR_TYPE: one or more of: db_accessor, error_mapper, validator,\n  formatter, collector, unknown\n\nYour job is to produce clean Java that preserves EXACTLY the business logic\nwhile removing all IBM/WAS framework dependencies.\n\nRULES - follow all of them:\n1. Remove IBM runtime imports except explicitly approved IBM client classes; remove imports starting with com.ibm.* when not approved, com.ibm.dse.*, javax.ejb.*,\n   javax.rmi.*, org.omg.*\n2. Replace IBM context access:\n   context.setValueAt(\"FieldName\", value) -> ctx.setFieldName(value)\n   context.getValueAt(\"FieldName\")        -> ctx.getFieldName()\n   Where ctx is the typed context class parameter.\n3. Replace IBM connection/JDBC patterns:\n   context.getConnection() -> dataSource.getConnection()\n   Inject DataSource as a constructor parameter.\n4. Preserve the execute() method signature: public int execute() throws Exception\n5. Preserve ALL return code values EXACTLY. A return of 4 must stay 4.\n6. Preserve ALL business logic inside method bodies EXACTLY.\n   Do not simplify, combine, or refactor business logic.\n7. Remove extends CCOperationStep / implements OperationStepInterface.\n   The clean class has no IBM superclass.\n8. Keep all setter methods (setSee the supplied task JSON) - these are called by the\n   assembler with XML attribute values.\n9. If PARENT_CLASS contains 'FormatDecoratorHolder':\n   Keep addDecoration(String s) and removeDecoration(String s) methods.\n   Remove initializeFrom(Tag tag) - replace with a plain constructor or setters.\n10. If PARENT_CLASS contains 'Attrib