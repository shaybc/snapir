ring configuredName = tag.getAttribute(\\\\\\\"dataName\\\\\\\");\\\\n        if (configuredName != null && !configuredName.isBlank()) {\\\\n            dataName = configuredName;\\\\n        }\\\\n    }\\\\n\\\\n    /** Return a sample time element; the demo deliberately ignores the actual time value. */\\\\n    public String format(Context context) throws Exception {\\\\n        return \\\\\\\"<\\\\\\\" + dataName + \\\\\\\">00:00:00</\\\\\\\" + dataName + \\\\\\\">\\\\\\\";\\\\n    }\\\\n\\\\n    /** Populate the named field with a dummy Date; input parsing is outside this fixture. */\\\\n    public void unformat(String xml, Context context) throws Exception {\\\\n        context.setValueAt(dataName, new Date(0L));\\\\n    }\\\\n}\\\\n\\\", \\\"shared\\\": false, \\\"origin\\\": \\\"formatter CCTime: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[2]/CCXML[1]/CCTime[1]\\\"}], \\\"conversion_components_checked\\\": true, \\\"external_dependencies\\\": [{\\\"class_name\\\": \\\"com.ibm.il.dse.cc.decorator.CCMandatory\\\", \\\"treatment\\\": \\\"replace\\\", \\\"maven_coordinates\\\": null, \\\"behavior_description\\\": \\\"Replace Composer runtime behavior using the embedded component contracts\\\", \\\"behavior_evidence\\\": [{\\\"document\\\": \\\"embedded:composer_conversion_knowledge\\\", \\\"heading\\\": \\\"4. Runtime Execution Model\\\", \\\"content_hash\\\": \\\"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\\\"}, {\\\"document\\\": \\\"embedded:composer_conversion_knowledge\\\", \\\"heading\\\": \\\"5. Context\\\", \\\"content_hash\\\": \\\"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\\\"}, {\\\"document\\\": \\\"embedded:composer_conversion_knowledge\\\", \\\"heading\\\": \\\"6. Formats and the Format/Unformat Process\\\", \\\"content_hash\\\": \\\"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\\\"}, {\\\"document\\\": \\\"embedded:composer_conversion_k