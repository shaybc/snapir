se.cc.format.CCXML requires AbstractFormatElement\", \"treatment\": \"replace\"}, {\"behavior_description\": \"Replace Composer runtime behavior using the embedded component contracts\", \"behavior_evidence\": [{\"content_hash\": \"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"4. Runtime Execution Model\"}, {\"content_hash\": \"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"5. Context\"}, {\"content_hash\": \"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"6. Formats and the Format/Unformat Process\"}, {\"content_hash\": \"0dae02d0709a670195856f35ecba11496c6e6987d38f2be86dd13838877833fd\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"7. Decorators\"}], \"class_name\": \"com.ibm.il.dse.cc.format.AbstractFormatElement\", \"maven_coordinates\": null, \"origin\": \"formatter NumberFormat: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[2]/CCXML[1]/NumberFormat[2] -> com.ibm.il.dse.cc.format.NumberFormat requires AbstractFormatElement\", \"treatment\": \"replace\"}], \"ini_values\": null, \"kind\": \"ibm_java\", \"library_plan_fingerprint\": \"27ff66f2d707a271a068430137a97de4ffc4a9378638d67d407d1cf0508c5153\", \"managed_library_id\": null, \"managed_project_operation\": \"TransferFundsOp\", \"operation_fields\": null, \"primary_source_content\": \"package com.ibm.il.dse.cc.format;\\n\\nimport com.ibm.dse.base.Context;\\nimport com.ibm.dse.base.Tag;\\nimport java.util.Date;\\n\\n/** Thin demo time formatter with deterministic dummy values for conversion fixtures. */\\npublic class CCTime {\\n    private String dataName = \\\"ExecutionTime\\\";\\n\\n    /** Keep the configured XML/context field name used by the demo forma