returnedErrorBodyChanger; }\\n    public Hashtable getFormats()                { return formats; }\\n    public String getHostKey()                   { return hostKey; }\\n    public void setHostKey(String v)             { this.hostKey = v; }\\n    public String getOperationFields()           { return operationFields; }\\n    public void setOperationFields(String v)     { this.operationFields = v; }\\n    public boolean isWriteToLog()                { return writeToLog; }\\n    public void setWriteToLog(boolean v)         { this.writeToLog = v; }\\n}\",\n  \"dependencies\": []\n}","thought_signature":"EmAKXgFpFH0TAJ5ZTloa3DrRX6565bwMNF-uRAhaacQ5zd61AJgIGXdeIFZLBDmTcShvWGADvgxZi2Mr4f8P19BDD07txLyjS1mhMz4WKGeuMHvNV35azqTkdj3IEcNAJto="}],"role":"model"},"finish_reason":"STOP","index":0}],"model_version":"gemini-3.5-flash-lite","response_id":"FZPHatSgBZ2yvdIPtde-qQ4","usage_metadata":{"candidates_token_count":989,"prompt_token_count":17592,"prompt_tokens_details":[{"modality":"TEXT","token_count":17592}],"total_token_count":18581},"automatic_function_calling_history":[]}
