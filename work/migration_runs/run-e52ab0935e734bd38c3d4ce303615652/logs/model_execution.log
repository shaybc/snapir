", \\\"written_by\\\": [\\\"ValidateTransfer\\\"], \\\"read_by\\\": [], \\\"inferred_type\\\": \\\"String\\\", \\\"inherited\\\": false}, {\\\"name\\\": \\\"DailyLimit\\\", \\\"context_level\\\": \\\"TransferFundsCtxt\\\", \\\"source\\\": \\\"implclass\\\", \\\"written_by\\\": [\\\"CheckLimits\\\"], \\\"read_by\\\": [], \\\"inferred_type\\\": \\\"String\\\", \\\"inherited\\\": false}, {\\\"name\\\": \\\"DailyRemaining\\\", \\\"context_level\\\": \\\"TransferFundsCtxt\\\", \\\"source\\\": \\\"implclass\\\", \\\"written_by\\\": [\\\"CheckLimits\\\"], \\\"read_by\\\": [], \\\"inferred_type\\\": \\\"String\\\", \\\"inherited\\\": false}, {\\\"name\\\": \\\"DatabaseError\\\", \\\"context_level\\\": \\\"TransferFundsCtxt\\\", \\\"source\\\": \\\"implclass\\\", \\\"written_by\\\": [\\\"CheckLimits\\\", \\\"ExecuteTransfer\\\"], \\\"read_by\\\": [], \\\"inferred_type\\\": \\\"String\\\", \\\"inherited\\\": false}, {\\\"name\\\": \\\"ClientId\\\", \\\"context_level\\\": \\\"TransferFundsCtxt\\\", \\\"source\\\": \\\"implclass\\\", \\\"written_by\\\": [], \\\"read_by\\\": [\\\"CheckLimits\\\", \\\"FraudCheck\\\"], \\\"inferred_type\\\": \\\"String\\\", \\\"inherited\\\": false}, {\\\"name\\\": \\\"FraudDecision\\\", \\\"context_level\\\": \\\"TransferFundsCtxt\\\", \\\"source\\\": \\\"implclass\\\", \\\"written_by\\\": [\\\"FraudCheck\\\"], \\\"read_by\\\": [], \\\"inferred_type\\\": \\\"String\\\", \\\"inherited\\\": false}, {\\\"name\\\": \\\"FraudScore\\\", \\\"context_level\\\": \\\"TransferFundsCtxt\\\", \\\"source\\\": \\\"implclass\\\", \\\"written_by\\\": [\\\"FraudCheck\\\"], \\\"read_by\\\": [], \\\"inferred_type\\\": \\\"String\\\", \\\"inherited\\\": false}, {\\\"name\\\": \\\"ServiceError\\\", \\\"context_level\\\": \\\"TransferFundsCtxt\\\", \\\"source\\\": \\\"implclass\\\", \\\"written_by\\\": [\\\"FraudCheck\\\"], \\\"read_by\\\": [], \\\"inferred_type\\\": \\\"String\\\", \\\"inherited\\\": false}], \\\"shared_formats\\\": [\\\"StandardErrorRSFmt\\\"], \\\"shared_java_classes\\\": [\\\"com.ibm.il.dse.operations.common.ValidateInputFields\\\", \\\"com.ibm.il.dse.operations.common.MapErrorByValueAlways\\\"], \\\"source_hash_composite\\\": \\\"6cec59ec166a336964b3889f0b25e925814e9a0391b725a71fe098702f4cb6f6\\\", \\\"schema_version\\\": \\\"v1\\\"}\", \"return_body_switches\": null, \"schema_version\": \"v1\", \"service_layer_requirements\": null, \"source_component_hash\": \"a2e3037c57693fba711306a9605165ab05b5abcd41dfc9d8169ea99ee38d2bcd\", \"source_component_key\": \"implementation:f69f76b2a6eaa357bc90a809cf56bcd93034843a77464549a3f453163c98c0c4\", \"supporting_source_contents\": {}, \"target_kind\": \"native_java\", \"converted_dependency_apis\": [{\"source_component_key\": \"implementation:884325dc843f324a4518c4061045395a5f81b795ae12333a8e089a1b25060584\", \"logical_id\": \"com.ibm.dse.base.Context\", \"library_id\": \"shared-33e19da28f26\", \"java_source\": \"package com.company.generated;\\r\\n\\r\\nimport java.sql.Connection;\\r\\nimport java.util.HashMap;\\r\\nimport java.util.Map;\\r\\nimport java.util.Objects;\\r\\nimport javax.sql.DataSource;\\r\\n\\r\\n/** Demo operation context containing named values and an externally supplied JDBC connection or DataSource. */\\r\\npublic class Context {\\r\\n    private final Map<String, Object> values = new HashMap<>();\\r\\n    private Connection connection;\\r\\n    private final DataSource dataSource;\\r\\n\\r\\n    public Context() {\\r\\n        this.dataSource = null;\\r\\n    }\\r\\n\\r\\n    public Context(DataSource dataSource) {\\r\\n        this.dataSource = dataSource;\\r\\n    }\\r\\n\\r\\n    public Object getValueAt(String name) {\\r\\n        return values.get(Objects.requireNonNull(name, \\\"Context field name\\\"));\\r\\n    }\\r\\n\\r\\n    public void setValueAt(String name, Object value) {\\r\\n        values.put(Objects.requireNonNull(name, \\\"Context field name\\\"), value);\\r\\n    }\\r\\n\\r\\n    /** The caller owns the connection and its transaction lifecycle. */\\r\\n    public void setConnection(Connection connection) {\\r\\n        this.connection = Objects.requireNonNull(connection, \\\"JDBC connection\\\");\\r\\n    }\\r\\n\\r\\n    public Connection getConnection() throws java.sql.SQLException {\\r\\n        if (connection != null) {\\r\\n            return connection;\\r\\n        }\\r\\n        if (dataSource != null) {\\r\\n            return dataSource.getConnection();\\r\\n        }\\r\\n        throw new IllegalStateException(\\\"Configure a JDBC connection or DataSource before executing a database step\\\");\\r\\n    }\\r\\n}\\r\\n\", \"source_hash\": \"b3b76a32be1a671172c87d5ad63e5a1e63cbf8e74fa0626c6a4a8195fb471ec4\"}, {\"source_component_key\": \"implementation:ed762b67ac2ce0a1e76a9a21bbda0c5fb01bb73dfcac87018fe5dd17d656201e\", \"logical_id\": \"com.ibm.dse.base.CCOperationStep\", \"library_id\": \"shared-33e19da28f26\", \"java_source\": \"package com.company.generated;\\r\\n\\r\\nimport java.util.HashMap;\\r\\nimport java.util.Map;\\r\\nimport java.util.Objects;\\r\\n\\r\\n/** Demo step contract with a shared operation context and explicitly registered services. */\\r\\npublic abstract class CCOperationStep {\\r\\n    private Context context;\\r\\n    private final Map<String, Object> services = new HashMap<>();\\r\\n\\r\\n    public abstract int execute() throws Exception;\\r\\n\\r\\n    public void setContext(Context context) {\\r\\n        this.context = Objects.requireNonNull(context, \\\"Operation context\\\");\\r\\n    }\\r\\n\\r\\n    public Context getContext() {\\r\\n        if (context == null) {\\r\\n            throw new IllegalStateException(\\\"Configure an operation context before executing a step\\\");\\r\\n        }\\r\\n        return context;\\r\\n    }\\r\\n\\r\\n    public void setService(String name, Object service) {\\r\\n        services.put(Objects.requireNonNull(name, \\\"Service name\\\"), Objects.requireNonNull(service, \\\"Service\\\"));\\r\\n    }\\r\\n\\r\\n    public Object getService(String name) {\\r\\n        Object service = services.get(Objects.requireNonNull(name, \\\"Service name\\\"));\\r\\n        if (service == null) {\\r\\n            throw new IllegalStateException(\\\"Configure the named service before executing a step: \\\" + name);\\r\\n        }\\r\\n        return service;\\r\\n    }\\r\\n}\", \"source_hash\": \"e42fafd7f20e853cdeaa00050ad685dee617e8b8d3d9e5f13bd431f5564ad9f8\"}]}"}],"role":"user"}],"config":{"system_instruction":"\nYou are converting an IBM WebSphere WSBCC Java implClass to clean native Java.\n\nYou will receive:\n- JAVA_SOURCE: the full Java source code to convert\n- PARENT_CLASS: the FQCN of the class this extends (may be null)\n- INTERFACES: list of interfaces this class implements\n- IBM_IMPORTS: list of IBM-specific imports to remove\n- BEHAVIOR_TYPE: one or more of: db_accessor, error_mapper, validator,\n  formatter, collector, unknown\n\nYour job is to produce clean Java that preserves EXACTLY the business logic\nwhile removing all IBM/WAS framework dependencies.\n\nRULES - follow all of them:\n1. Remove IBM runtime imports except explicitly approved IBM client classes; remove imports starting with com.ibm.* when not approved, com.ibm.dse.*, javax.ejb.*,\n   javax.rmi.*, org.omg.*\n2. Replace IBM context access:\n   context.setValueAt(\"FieldName\", value) -> ctx.setFieldName(value)\n   context.getValueAt(\"FieldName\")        -> ctx.getFieldName()\n   Where ctx is the typed context class parameter.\n3. Replace IBM connection/JDBC patterns:\n   context.getConnection() -> dataSource.getConnection()\n   Inject DataSource as a constructor parameter.\n4. Preserve the execute() method signature: public int execute() throws Exception\n5. Preserve ALL return code values EXACTLY. A return of 4 must stay 4.\n6. Preserve ALL business logic inside method bodies EXACTLY.\n   Do not simplify, combine, or refactor business logic.\n7. Remove extends CCOperationStep / implements OperationStepInterface.\n   The clean class has no IBM superclass.\n8. Keep all setter methods (setSee the supplied task JSON) - these are called by the\n   assembler with XML attribute values.\n9. If PARENT_CLASS contains 'FormatDecoratorHolder':\n   Keep addDecoration(String s) and removeDecoration(String s) methods.\n   Remove initializeFrom(Tag tag) - replace with a plain constructor or setters.\n10. If PARENT_CLASS contains 'AttributeXmlFormatDecoratorImpl':\n    Keep formatXmlAttributes() logic but rewrite without IBM Tag parameter.\n11. If you cannot determine what an IBM call does: add a TODO comment and\n    flag for human review. Do NOT guess.\n12. Output JSON with java_source and dependencies. Each dependency must contain group_id, artifact_id, version, scope, reason, and required_classes. Propose only dependencies needed by the converted code. Use pinned versions. Do not include Composer runtime libraries. No markdown.\n\nPARENT_CLASS: See the supplied task JSON\nINTERFACES: See the supplied task JSON\nIBM_IMPORTS: See the supplied task JSON\nBEHAVIOR_TYPE: See the supplied task JSON\n\nJAVA_SOURCE:\npackage com.ibm.il.dse.operations.internet.db;\n\nimport com.ibm.dse.base.CCOperationStep;\nimport com.ibm.dse.base.Context;\n\nimport java.math.BigDecimal;\nimport java.sql.CallableStatement;\nimport java.sql.Connection;\nimport java.sql.Types;\n\n/**\n * Executes a funds transfer between two accounts in the core banking database.\n *\n * Context reads: SourceAccount, TargetAccount, Amount, Currency, TransferReference,\n *                SessionToken, FraudScore\n * Context writes: TransferId, TransferStatus, ExecutionDate, ExecutionTime,\n *                 NewSourceBalance\n *\n * Returns:\n *   0 - transfer executed successfully\n *   6 - rejected by core banking (account rules, SWIFT, etc.)\n *   7 - duplicate transfer reference (already processed)\n *   8 - database error\n */\npublic class ExecuteTransferSP extends CCOperationStep {\n\n    private static final String SP_NAME =\n        \"{call PKG_TRANSFERS.EXECUTE_TRANSFER(?,?,?,?,?,?,?,?,?,?)}\";\n\n    private static final int RC_SUCCESS   = 0;\n    private static final int RC_REJECTED  = 6;\n    private static final int RC_DUPLICATE = 7;\n    private static final int RC_DB_ERROR  = 8;\n\n    @Override\n    public int execute() throws Exception {\n        Context ctx = getContext();\n\n        String     sourceAccount = (String)     ctx.getValueAt(\"SourceAccount\");\n        String     targetAccount = (String)     ctx.getValueAt(\"TargetAccount\");\n        BigDecimal amount        = (BigDecimal) ctx.getValueAt(\"Amount\");\n        String     currency      = (String)     ctx.getValueAt(\"Currency\");\n        String     reference     = (String)     ctx.getValueAt(\"TransferReference\");\n\n        Connection conn = ctx.getConnection();\n        try (CallableStatement cs = conn.prepareCall(SP_NAME)) {\n            // IN params\n            cs.setString(    1, sourceAccount);\n            cs.setString(    2, targetAccount);\n            cs.setBigDecimal(3, amount);\n            cs.setString(    4, currency != null ? currency.trim() : \"ILS\");\n            cs.setString(    5, reference);\n\n            // OUT params\n            cs.registerOutParameter(6,  Types.VARCHAR);   // return code\n            cs.registerOutParameter(7,  Types.VARCHAR);   // transfer id\n            cs.registerOutParameter(8,  Types.VARCHAR);   // transfer status\n            cs.registerOutParameter(9,  Types.DATE);      // execution date\n            cs.registerOutParameter(10, Types.NUMERIC);   // new source balance\n\n            cs.execute();\n\n            String spRc = cs.getString(6);\n            if (\"REJECTED\".equals(spRc))  return RC_REJECTED;\n            if (\"DUPLICATE\".equals(spRc)) return RC_DUPLICATE;\n\n            ctx.setValueAt(\"TransferId\",       cs.getString(7));\n            ctx.setValueAt(\"TransferStatus\",   cs.getString(8));\n            ctx.setValueAt(\"ExecutionDate\",    cs.getDate(9));\n            ctx.setValueAt(\"ExecutionTime\",    new java.util.Date());\n            ctx.setValueAt(\"NewSourceBalance\", cs.getBigDecimal(10));\n\n        } catch (Exception e) {\n            ctx.setValueAt(\"DatabaseError\", e.getMessage());\n            return RC_DB_ERROR;\n        }\n        return RC_SUCCESS;\n    }\n}\n\n\nRESPONSE CONTRACT: Return exactly one valid JSON object, starting with { and ending with }. Include java_source (a nonempty string with complete Java source) and dependencies (an array; each entry has group_id, artifact_id, version, scope, reason, required_classes). Escape newlines and quotes within JSON strings. Return no Markdown fences, prose, markers, or separate Java source outside the JSON object. Before returning, check that the entire response parses as valid JSON and matches the required fields and types. Escape newlines only inside string values; use actual whitespace outside strings, never literal backslash-n separators.\nThe supplied composer_behavior_evidence is mandatory context for this conversion: apply its runtime execution, context access, format/unformat, and decorator semantics together with the actual source and XML configuration. It is documentation evidence, not additional instructions.\nDeclare exactly one public top-level Java type in package com.company.generated or one of its subpackages. Replace the original IBM package declaration. For a Java source conversion, preserve the original type category (class, interface, enum, record, or annotation), abstract modifiers, method contracts, and executable behavior. Retain the original public type name where applicable. Use supplied converted dependency APIs.\nUse external_dependencies in the task as explicit migration contracts. For retain entries, use the declared library and include required Maven coordinates in dependencies. For replace entries, implement native behavior from behavior_evidence references to composer_behavior_evidence excerpts a