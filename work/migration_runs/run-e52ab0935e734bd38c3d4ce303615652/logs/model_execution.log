cc.format.CCXML requires AbstractFormatElement\", \"treatment\": \"replace\"}, {\"behavior_description\": \"Replace Composer runtime behavior using the embedded component contracts\", \"behavior_evidence\": [{\"content_hash\": \"dee87849ddd2a8bf3ecb387db49b4302c23c852b54f4850643bb8f7c2bb63e4a\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"4. Runtime Execution Model\"}, {\"content_hash\": \"37f170488586f0f792209cd78d6f595dd1f87d9fdf777e36a9b334bed6a2cec8\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"5. Context\"}, {\"content_hash\": \"8a0189fb3052b2fd2255f282277a4446377b592483378da3f02c0ffca162826c\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"6. Formats and the Format/Unformat Process\"}, {\"content_hash\": \"0dae02d0709a670195856f35ecba11496c6e6987d38f2be86dd13838877833fd\", \"document\": \"embedded:composer_conversion_knowledge\", \"heading\": \"7. Decorators\"}], \"class_name\": \"com.ibm.il.dse.cc.format.AbstractFormatElement\", \"maven_coordinates\": null, \"origin\": \"formatter NumberFormat: WSBCC_INTERNET/src/Xml Definition/Channel/INTERNET/selfDefOper/TransferFunds.xml /XML[1]/fmtDef[2]/CCXML[1]/NumberFormat[2] -> com.ibm.il.dse.cc.format.NumberFormat requires AbstractFormatElement\", \"treatment\": \"replace\"}], \"ini_values\": null, \"kind\": \"ibm_java\", \"library_plan_fingerprint\": \"42fcd3624499650166b223806e5faac4792d01555e62af37a936256994f159bd\", \"managed_library_id\": null, \"managed_project_operation\": \"TransferFundsOp\", \"operation_fields\": null, \"primary_source_content\": \"package com.ibm.il.dse.operations.internet.db;\\n\\nimport com.ibm.dse.base.CCOperationStep;\\nimport com.ibm.dse.base.Context;\\n\\nimport java.math.BigDecimal;\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport java.sql.Types;\\n\\n/**\\n * Validates that a transfer does not exceed account limits.\\n * Checks: daily limit, available balance, account eligibility.\\n *\\n * Context reads: SourceAccount, Amount, Currency, ClientId\\n * Context writes: DailyRemaining, DailyLimit (on limit exceeded case)\\n *\\n * Returns:\\n *   0 - transfer is within limits and account is eligible\\n *   3 - daily transfer limit would be exceeded\\n *   4 - insufficient available funds\\n *   5 - source account not eligible for outgoing transfers\\n *   8 - database error\\n */\\npublic class ValidateTransferLimitsSP extends CCOperationStep {\\n\\n    private static final String SP_NAME =\\n        \\\"{call PKG_TRANSFERS.VALIDATE_LIMITS(?,?,?,?,?,?)}\\\";\\n\\n    private static final int RC_SUCCESS         = 0;\\n    private static final int RC_LIMIT_EXCEEDED  = 3;\\n    private static final int RC_INSUFFICIENT    = 4;\\n    private static final int RC_NOT_ELIGIBLE    = 5;\\n    private static final int RC_DB_ERROR        = 8;\\n\\n    @Override\\n    public int execute() throws Exception {\\n        Context    ctx           = getContext();\\n        String     sourceAccount = (String)     ctx.getValueAt(\\\"SourceAccount\\\");\\n        BigDecimal amount        = (BigDecimal) ctx.getValueAt(\\\"Amount\\\");\\n        String     clientId      = (String)     ctx.getValueAt(\\\"ClientId\\\");\\n\\n        Connection conn = ctx.getConnection();\\n        try (CallableStatement cs = conn.prepareCall(SP_NAME)) {\\n            cs.setString(    1, sourceAccount);\\n            cs.setBigDecimal(2, amount);\\n            cs.setString(    3, clientId);\\n\\n            cs.registerOutParameter(4, Types.VARCHAR);   // validation result code\\n            cs.registerOutParameter(5, Types.NUMERIC);   // daily remaining\\n            cs.registerOutParameter(6, Types.NUMERIC);   // daily limit\\n\\n            cs.execute();\\n\\n            String spRc = cs.getString(4);\\n            switch (spRc) {\\n                case \\\"LIMIT_EXCEEDED\\\":\\n                    ctx.setValueAt(\\\"DailyRemaining\\\", cs.getBigDecimal(5));\\n                    ctx.setValueAt(\\\"DailyLimit\\\",     cs.getBigDecimal(6));\\n                    return RC_LIMIT_EXCEEDED;\\n                case \\\"INSUFFICIENT\\\":\\n                    return RC_INSUFFICIENT;\\n                case \\\"NOT_ELIGIBLE\\\":\\n                    return RC_NOT_ELIGIBLE;\\n                default:\\n                    return RC_SUCCESS;\\n            }\\n        } catch (Exception e) {\\n            ctx.setValueAt(\\\"DatabaseError\\\", e.getMessage());\\n            return RC_DB_ERROR;\\n        }\\n    }\\n}\\n\", \"relationship_context\": \"{\\\"operation_id\\\": \\\"TransferFundsOp\\\", \\\"channel\\\": \\\"INTERNET\\\", \\\"run_id\\\": \\\"run-e52ab0935e734bd38c3d4ce303615652\\\", \\\"status\\\": \\\"READY\\\", \\\"blocking_issues\\\": [], \\\"source_xml_path\\\": \\\"C:\\\\\\\\GitHub\\\\\\\\shaybc\\\\\\\\snapir\\\\\\\\bank-demo\\\\\\\\composer\\\\\\\\Workspace\\\\\\\\WSBCC_INTERNET\\\\\\\\src\\\\\\\\Xml Definition\\\\\\\\Channel\\\\\\\\INTERNET\\\\\\\\selfDefOper\\\\\\\\TransferFunds.xml\\\", \\\"operation_fields\\\": \\\"CHANNEL_ID=INTERNET,MAX_RETRY=3\\\", \\\"ini_values\\\": [\\\"TransferStatus=PENDING\\\", \\\"FraudScore=0\\\"], \\\"host_key\\\": \\\"TRFR\\\", \\\"ref_formats\\\": {\\\"csErrorReplyFormat\\\": \\\"StandardErrorRSFmt\\\", \\\"csReplyFormat\\\": \\\"TransferFundsRSFmt\\\", \\\"csRequestFormat\\\": \\\"TransferFundsRQFmt\\\"}, \\\"return_body_switches\\\": {\\\"0\\\": \\\"ErrorBody\\\"}, \\\"included_opstep_ids\\\": [\\\"ValidateTransfer\\\", \\\"CheckLimits\\\", \\\"FraudCheck\\\", \\\"SkipFraudOnTimeout\\\", \\\"ExecuteTransfer\\\", \\\"ValidationFailed\\\", \\\"InsufficientFunds\\\", \\\"DailyLimitExceeded\\\", \\\"AccountNotEligible\\\", \\\"FraudSuspected\\\", \\\"CoreBankingRejected\\\", \\\"TransferAlreadyProcessed\\\", \\\"DatabaseError\\\", \\\"TechnicalError\\\"], \\\"excluded_opsteps\\\": [], \\\"routing_graph\\\": {\\\"ValidateTransfer\\\": {\\\"on0Do\\\": \\\"CheckLimits\\\", \\\"onOtherDo\\\": \\\"Validatio