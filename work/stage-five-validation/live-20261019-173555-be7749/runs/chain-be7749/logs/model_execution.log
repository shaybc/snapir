rtifact_targets\": {\"INTERNET/GetClientLinksOp\": \"C:\\\\GitHub\\\\shaybc\\\\snapir\\\\work\\\\stage-five-validation\\\\live-20261019-173555-be7749\\\\runs\\\\chain-be7749\\\\generated\\\\INTERNET\\\\GetClientLinksOp\"}, \"managed_dependencies\": [], \"known_dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"testing_contract\": {\"requirement\": {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}, \"java_version\": 25, \"dependencies\": [{\"group_id\": \"org.junit.jupiter\", \"artifact_id\": \"junit-jupiter\", \"version\": \"5.10.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.mockito\", \"artifact_id\": \"mockito-core\", \"version\": \"5.23.0\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"net.bytebuddy\", \"artifact_id\": \"byte-buddy-agent\", \"version\": \"1.17.7\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}, {\"group_id\": \"org.objenesis\", \"artifact_id\": \"objenesis\", \"version\": \"3.3\", \"scope\": \"test\", \"reason\": \"Application-owned Java 25 test template\", \"required_classes\": []}], \"rules\": [\"Keep each test focused on one evidenced outcome or side effect.\", \"Cover meaningful behavior across the bundle, not every class individually; wire models and simple helpers may be covered through mapper or caller tests.\", \"The platform policy is checked directly; it needs no coverage entry or unit-contract requirement declaration.\", \"Separate business behavior tests from adapter/infrastructure contract tests.\", \"Use JUnit Jupiter and plain Mockito mock/when/verify calls; no experimental JVM compatibility flags.\", \"Mock external interfaces instead of generating handwritten implementations.\", \"Prefer narrow generated collaborators; do not change accepted production APIs just for tests.\", \"Preserve meaningful assertions and derive expectations from evidence, not from the example values.\"], \"examples\": [{\"path\": \"AdapterContractTest.java\", \"content\": \"package example;\\n\\nimport java.sql.CallableStatement;\\nimport java.sql.Connection;\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Infrastructure contract example: no database connection or handwritten JDBC implementation. */\\npublic class AdapterContractTest {\\n    @Test void adapterPassesTheIdentifierToItsDependency() throws Exception {\\n        Connection connection = mock(Connection.class);\\n        CallableStatement statement = mock(CallableStatement.class);\\n        when(connection.prepareCall(\\\"{call sample(?)}\\\")).thenReturn(statement);\\n        when(statement.getString(1)).thenReturn(\\\"sample-result\\\");\\n        try (CallableStatement call = connection.prepareCall(\\\"{call sample(?)}\\\")) {\\n            call.setString(1, \\\"sample-id\\\");\\n            call.execute();\\n            assertEquals(\\\"sample-result\\\", call.getString(1));\\n        }\\n        verify(statement).setString(1, \\\"sample-id\\\");\\n        verify(statement).execute();\\n        verify(statement).close();\\n    }\\n}\\n\"}, {\"path\": \"BusinessBehaviorTest.java\", \"content\": \"package example;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.assertEquals;\\nimport static org.mockito.Mockito.*;\\n\\n/** Reference structure only: derive real expected values from migration evidence. */\\npublic class BusinessBehaviorTest {\\n    interface NotificationPort { void send(String reference); }\\n    static class CompletionService {\\n        private final NotificationPort notifications;\\n        CompletionService(NotificationPort notifications) { this.notifications = notifications; }\\n        String complete(String reference) { notifications.send(reference); return reference; }\\n    }\\n\\n    @Test void returnsTheCompletedReference() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        CompletionService service = new CompletionService(notifications);\\n        assertEquals(\\\"sample-reference\\\", service.complete(\\\"sample-reference\\\"));\\n    }\\n\\n    @Test void notifiesTheCollaboratorOnce() {\\n        NotificationPort notifications = mock(NotificationPort.class);\\n        new CompletionService(notifications).complete(\\\"sample-reference\\\");\\n        verify(notifications).send(\\\"sample-reference\\\");\\n        verifyNoMoreInteractions(notifications);\\n    }\\n}\\n\"}]}, \"final_validation_feedback\": null, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\", \"versioned_requirements\": [{\"requirement_id\": \"business\", \"version\": 1, \"description\": \"Preserve this complete configured unit's evidenced behavior\"}, {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}], \"format_reference_example\": {\"example_version\": 1, \"verified_platform\": {\"java_version\": 25, \"jackson_xml_version\": \"2.15.2\", \"junit_version\": \"5.10.0\"}, \"files\": [{\"path\": \"src/main/java/example/format/FormatExample.java\", \"content\": \"package example.format;\\n\\nimport com.fasterxml.jackson.dataformat.xml.XmlMapper;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement;\\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlText;\\nimport com.fasterxml.jackson.dataformat.xml.ser.ToXmlGenerator;\\nimport java.math.BigDecimal;\\nimport java.time.LocalDate;\\nimport java.time.format.DateTimeFormatter;\\nimport java.util.Objects;\\n\\n/** Illustrative rules only: width three, implied two decimals, basic [REDACTED] date and nullable child. */\\npublic final class FormatExample {\\n    private final XmlMapper mapper;\\n\\n    public FormatExample() {\\n        mapper = new XmlMapper();\\n        // XML-specific features belong to ToXmlGenerator, not SerializationFeature.\\n        mapper.configure(ToXmlGenerator.Feature.WRITE_XML_DECLARATION, false);\\n    }\\n\\n    public record Value(String code, BigDecimal amount, LocalDate date, Boolean enabled) {}\\n\\n    @JacksonXmlRootElement(localName = \\\"Envelope\\\")\\n    public static class Wire {\\n        @JacksonXmlProperty(localName = \\\"Code\\\") public String code;\\n        @JacksonXmlProperty(localName = \\\"Amount\\\") public String amount;\\n        @JacksonXmlProperty(localName = \\\"Date\\\") public String date;\\n        @JacksonXmlProperty(localName = \\\"Enabled\\\") public NullableText enabled;\\n    }\\n\\n    /** A nil attribute belongs to this child element, never to the populated envelope. */\\n    public static class NullableText {\\n        @JacksonXmlText public String value;\\n        @JacksonXmlProperty(localName = \\\"nil\\\", isAttribute = true,\\n            namespace = \\\"http://www.w3.org/2001/XMLSchema-instance\\\") public String nil;\\n    }\\n\\n    public String format(Value value) throws Exception {\\n        Objects.requireNonNull(value, \\\"Example requires a populated root\\\");\\n        Wire wire = new Wire();\\n        String code = Objects.requireNonNull(value.code());\\n        wire.code = code.length() < 3 ? \\\" \\\".repeat(3 - code.length()) + code : code;\\n        wire.amount = value.amount().movePointRight(2).toBigIntegerExact().toString();\\n        wire.date = value.date().format(DateTimeFormatter.BASIC_ISO_DATE);\\n        wire.enabled = new NullableText();\\n        if (value.enabled() == null) {\\n            wire.enabled.nil = \\\"true\\\";\\n        } else {\\n            wire.enabled.value = value.enabled().toString();\\n        }\\n        return mapper.writeValueAsString(wire);\\n    }\\n\\n    public Value unformat(String xml) throws Exception {\\n        Wire wire = mapper.readValue(xml, Wire.class);\\n        Objects.requireNonNull(wire, \\\"Example requires a populated root\\\");\\n        Boolean enabled = null;\\n        if (wire.enabled != null && !\\\"true\\\".equals(wire.enabled.nil)) {\\n            if (!\\\"true\\\".equals(wire.enabled.value) && !\\\"false\\\".equals(wire.enabled.value)) {\\n                throw new IllegalArgumentException(\\\"Expected true, false or a nil child\\\");\\n            }\\n            enabled = Boolean.valueOf(wire.enabled.value);\\n        }\\n        return new Value(wire.code.replaceFirst(\\\"^ +\\\", \\\"\\\"),\\n            new BigDecimal(wire.amount).movePointLeft(2),\\n            LocalDate.parse(wire.date, DateTimeFormatter.BASIC_ISO_DATE), enabled);\\n    }\\n}\\n\"}, {\"path\": \"src/test/java/example/format/FormatExampleTest.java\", \"content\": \"package example.format;\\n\\nimport org.junit.jupiter.api.Test;\\nimport static org.junit.jupiter.api.Assertions.*;\\nimport java.io.ByteArrayInputStream;\\nimport java.math.BigDecimal;\\nimport java.nio.charset.StandardCharsets;\\nimport java.time.LocalDate;\\nimport javax.xml.parsers.DocumentBuilderFactory;\\nimport org.w3c.dom.Element;\\n\\n/** Use real Jackson/mapper objects; derive real migration expectations from its evidence. */\\npublic class FormatExampleTest {\\n    private final FormatExample mapper = new FormatExample();\\n    private static final String XSI = \\\"http://www.w3.org/2001/XMLSchema-instance\\\";\\n\\n    private FormatExample.Value value(String code, Boolean enabled) {\\n        return new FormatExample.Value(code, new BigDecimal(\\\"12.50\\\"), LocalDate.of(2024, 1, 2), enabled);\\n    }\\n\\n    private Element root(String xml) throws Exception {\\n        DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();\\n        factory.setNamespaceAware(true);\\n        return factory.newDocumentBuilder().parse(new ByteArrayInputStream(xml.getBytes(StandardCharsets.UTF_8))).getDocumentElement();\\n    }\\n\\n    private String text(Element root, String name) {\\n        return root.getElementsByTagName(name).item(0).getTextContent();\\n    }\\n\\n    @Test public void serializationPreservesStructureAndAppliesConfirmedConversions() throws Exception {\\n        String xml = mapper.format(value(\\\"A\\\", false));\\n        Element root = root(xml);\\n        assertEquals(\\\"Envelope\\\", root.getTagName());\\n        assertFalse(xml.startsWith(\\\"<?xml\\\"));\\n        assertFalse(root.hasAttributeNS(XSI, \\\"nil\\\"));\\n        assertEquals(\\\"  A\\\", text(root, \\\"Code\\\"));\\n        assertEquals(\\\"1250\\\", text(root, \\\"Amount\\\"));\\n        assertEquals(\\\"20240102\\\", text(root, \\\"Date\\\"));\\n        assertEquals(\\\"false\\\", text(root, \\\"Enabled\\\"));\\n    }\\n\\n    @Test public void paddingUsesTargetLengthRatherThanAlwaysAddingCharacters() throws Exception {\\n        assertEquals(\\\"ABC\\\", text(root(mapper.format(value(\\\"ABC\\\", true))), \\\"Code\\\"));\\n        assertEquals(\\\"ABCD\\\", text(root(mapper.format(value(\\\"ABCD\\\", true))), \\\"Code\\\"));\\n    }\\n\\n    @Test public void parsingHasIndependentEvidenceBasedExpectations() throws Exception {\\n        String xml = \\\"<Envelope><Code>  A</Code><Amount>1250</Amount><Date>20240102</Date><Enabled>true</Enabled></Envelope>\\\";\\n        FormatExample.Value result = mapper.unformat(xml);\\n        assertEquals(\\\"A\\\", result.code());\\n        assertEquals(new BigDecimal(\\\"12.50\\\"), result.amount());\\n        assertEquals(LocalDate.of(2024, 1, 2), result.date());\\n        assertTrue(result.enabled());\\n    }\\n\\n    @Test public void nullableChildKeepsPopulatedParentAndSiblings() throws Exception {\\n        String xml = mapper.format(value(\\\"ABC\\\", null));\\n        Element root = root(xml);\\n        assertFalse(root.hasAttributeNS(XSI, \\\"nil\\\"));\\n        Element child = (Element) root.getElementsByTagName(\\\"Enabled\\\").item(0);\\n        assertEquals(\\\"true\\\", child.getAttributeNS(XSI, \\\"nil\\\"));\\n        assertEquals(\\\"ABC\\\", text(root, \\\"Code\\\"));\\n        FormatExample.Value result = mapper.unformat(xml);\\n        assertNotNull(result);\\n        assertEquals(\\\"ABC\\\", result.code());\\n        assertNull(result.enabled());\\n    }\\n\\n    @Test public void evidencedMissingEmptyAndInvalidValuesRemainDistinct() throws Exception {\\n        String prefix = \\\"<Envelope><Code>ABC</Code><Amount>1250</Amount><Date>20240102</Date>\\\";\\n        assertNull(mapper.unformat(prefix + \\\"</Envelope>\\\").enabled());\\n        assertThrows(IllegalArgumentException.class, () -> mapper.unformat(prefix + \\\"<Enabled></Enabled></Envelope>\\\"));\\n        assertThrows(IllegalArgumentException.class, () -> mapper.unformat(prefix + \\\"<Enabled>invalid</Enabled></Envelope>\\\"));\\n        assertThrows(NumberFormatException.class, () -> mapper.unformat(prefix.replace(\\\"1250\\\", \\\"invalid\\\") + \\\"</Envelope>\\\"));\\n    }\\n\\n    @Test public void roundTripIsAdditionalEvidenceRatherThanTheOnlyTest() throws Exception {\\n        FormatExample.Value original = value(\\\"ABC\\\", true);\\n        assertEquals(original, mapper.unformat(mapper.format(original)));\\n    }\\n}\\n\"}]}, \"schema\": {\"$defs\": {\"MavenDependency\": {\"additionalProperties\": false, \"description\": \"Identify a pinned Maven artifact and the APIs that justify its inclusion.\", \"properties\": {\"group_id\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Group Id\", \"type\": \"string\"}, \"artifact_id\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Artifact Id\", \"type\": \"string\"}, \"version\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Version\", \"type\": \"string\"}, \"scope\": {\"default\": \"compile\", \"enum\": [\"compile\", \"runtime\", \"provided\", \"test\"], \"title\": \"Scope\", \"type\": \"string\"}, \"reason\": {\"minLength\": 1, \"title\": \"Reason\", \"type\": \"string\"}, \"required_classes\": {\"items\": {\"type\": \"string\"}, \"title\": \"Required Classes\", \"type\": \"array\"}}, \"required\": [\"group_id\", \"artifact_id\", \"version\", \"reason\"], \"t