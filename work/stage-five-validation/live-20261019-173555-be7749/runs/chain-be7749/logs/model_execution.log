{"files": [{"path": "src/main/java/com/company/generated/units/u3a42c4326e3d/MapErrorByValueAlways.java", "content": "package com.company.generated.units.u3a42c4326e3d;\n\nimport com.ibm.dse.base.CCOperationStep;\nimport com.ibm.dse.base.Context;\n\npublic class MapErrorByValueAlways extends CCOperationStep {\n    private String errorCategory = \"99\";\n    private String errorNumber = \"8\";\n\n    public void setErrorCategory(String errorCategory) {\n        this.errorCategory = errorCategory;\n    }\n\n    public void setErrorNumber(String errorNumber) {\n        this.errorNumber = errorNumber;\n    }\n\n    @Override\n    public int execute() throws Exception {\n        Context ctx = getContext();\n        ctx.setValueAt(\"ErrorCategory\", errorCategory);\n        ctx.setValueAt(\"ErrorNumber\", errorNumber);\n        ctx.setValueAt(\"ErrorDescription\", resolveErrorDescription(errorCategory, errorNumber));\n        return 0;\n    }\n\n    private String resolveErrorDescription(String category, String number) {\n        String key = category + \"_\" + number;\n        switch (key) {\n            case \"10_2\": return \"Validation failed: required field missing or invalid\";\n            case \"20_1\": return \"No data found for the provided criteria\";\n            case \"20_4\": return \"Account not found\";\n            case \"30_5\": return \"Access denied: insufficient permissions\";\n            case \"40_3\": return \"Daily transfer limit exceeded\";\n            case \"40_4\": return \"Insufficient funds\";\n            case \"40_5\": return \"Account not eligible for this operation\";\n            case \"50_2\": return \"Transfer blocked: fraud risk detected\";\n            case \"60_6\": return \"Core banking system rejected the request\";\n            case \"60_7\": return \"Transfer already processed\";\n            case \"99_0\": return \"Technical error: unexpected system failure\";\n            case \"99_8\": return \"Technical error: database connection failure\";\n            default:     return \"System error (category=\" + category + \", number=\" + number + \")\";\n        }\n    }\n}\n"}, {"path": "src/test/java/com/company/generated/units/u3a42c4326e3d/MapErrorByValueAlwaysTest.java", "content": "package com.company.generated.units.u3a42c4326e3d;\n\nimport com.ibm.dse.base.Context;\nimport org.junit.jupiter.api.Test;\nimport static org.junit.jupiter.api.Assertions.assertEquals;\n\npublic class MapErrorByValueAlwaysTest {\n\n    @Test\n    public void executesAndSetsConfiguredDatabaseError() throws Exception {\n        Context context = new Context();\n        MapErrorByValueAlways step = new MapErrorByValueAlways();\n        step.setContext(context);\n        \n        int result = step.execute();\n        \n        assertEquals(0, result);\n        assertEquals(\"99\", context.getValueAt(\"ErrorCategory\"));\n        assertEquals(\"8\", context.getValueAt(\"ErrorNumber\"));\n        assertEquals(\"Technical error: database connection failure\", context.getValueAt(\"ErrorDescription\"));\n    }\n\n    @Test\n    public void executesWithCustomErrorValues() throws Exception {\n        Context context = new Context();\n        MapErrorByValueAlways step = new MapErrorByValueAlways();\n        step.setContext(context);\n        step.setErrorCategory(\"10\");\n        step.setErrorNumber(\"2\");\n        \n        int result = step.execute();\n        \n        assertEquals(0, result);\n        assertEquals(\"10\", context.getValueAt(\"ErrorCategory\"));\n        assertEquals(\"2\", context.getValueAt(\"ErrorNumber\"));\n        assertEquals(\"Validation failed: required field missing or invalid\", context.getValueAt(\"ErrorDescription\"));\n    }\n}\n"}], "dependencies": [{"group_id": "org.junit.jupiter", "artifact_id": "junit-jupiter", "version": "5.10.0", "scope": "test", "reason": "JUnit Jupiter tests and execution engine", "required_classes": ["org.junit.jupiter.api.Test", "org.junit.jupiter.api.Assert