l, \"method_contract_validation\": \"resolved-java-types-v1\", \"generic_method_validation\": \"erased-type-arguments-v1\", \"dependency_validation\": \"resolved-class-ownership-v1\", \"transitive_class_validation\": \"resolved-transitive-api-v1\", \"source_comment_validation\": \"comments-ignored-v1\", \"versioned_requirements\": [{\"requirement_id\": \"business\", \"version\": 1, \"description\": \"Preserve this complete configured unit's evidenced behavior\"}, {\"requirement_id\": \"java25-test-template\", \"version\": 1, \"description\": \"Use the verified Java 25 JUnit/Mockito testing platform with small focused behavior tests and separate adapter contract tests; mock external interfaces rather than hand implement them.\"}], \"schema\": {\"$defs\": {\"MavenDependency\": {\"additionalProperties\": false, \"description\": \"Identify a pinned Maven artifact and the APIs that justify its inclusion.\", \"properties\": {\"group_id\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Group Id\", \"type\": \"string\"}, \"artifact_id\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Artifact Id\", \"type\": \"string\"}, \"version\": {\"pattern\": \"^[A-Za-z0-9_][A-Za-z0-9_.-]*$\", \"title\": \"Version\", \"type\": \"string\"}, \"scope\": {\"default\": \"compile\", \"enum\": [\"compile\", \"runtime\", \"provided\", \"test\"], \"title\": \"Scope\", \"type\": \"string\"}, \"reason\": {\"minLength\": 1, \"title\": \"Reason\", \"type\": \"string\"}, \"required_classes\": {\"items\": {\"type\": \"string\"}, \"title\": \"Required Classes\", \"type\": \"array\"}}, \"required\": [\"group_id\", \"artifact_id\", \"version\", \"reason\"], \"title\": \"MavenDependency\", \"type\": \"object\"}, \"NativeApiContract\": {\"additionalProperties\": false, \"description\": \"A planned native type and exact public methods it must expose.\", \"properties\": {\"type_name\": {\"title\": \"Type Name\", \"type\": \"string\"}, \"method_signatures\": {\"items\": {\"type\