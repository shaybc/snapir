{"parts":[{"text":"{\"unit_id\": \"configured_step-3a42c4326e3d7f21467b61b2\", \"kind\": \"configured_step\", \"logical_id\": \"DatabaseError\", \"configuration_xml\": \"<opStep id=\\\"DatabaseError\\\" implClass=\\\"com.ibm.il.dse.operations.common.MapErrorByValueAlways\\\" ErrorCategory=\\\"99\\\" ErrorNumber=\\\"8\\\" on0Return=\\\"ErrorBody\\\" onOtherDo=\\\"end\\\" />\\n\\n    \", \"sources\": [{\"identity\": \"com.ibm.dse.base.CCOperationStep\", \"content\": \"package com.ibm.dse.base;\\n\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\n/** Demo step contract with a shared operation context and explicitly registered services. */\\npublic abstract class CCOperationStep {\\n    private Context context;\\n    private final Map<String, Object> services = new HashMap<>();\\n\\n    public abstract int execute() throws Exception;\\n\\n    public void setContext(Context context) {\\n        this.context = Objects.requireNonNull(context, \\\"Operation context\\\");\\n    }\\n\\n    public Context getContext() {\\n        if (context == null) {\\n            throw new IllegalStateException(\\\"Configure an operation context before executing a step\\\");\\n        }\\n        return context;\\n    }\\n\\n    public void setService(String name, Object service) {\\n        services.put(Objects.requireNonNull(name, \\\"Service name\\\"), Objects.requireNonNull(service, \\\"Service\\\"));\\n    }\\n\\n    public Object getService(String name) {\\n        Object service = services.get(Objects.requireNonNull(name, \\\"Service name\\\"));\\n        if (service == null) {\\n            throw new IllegalStateException(\\\"Configure the named service before executing a step: \\\" + name);\\n        }\\n        return service;\\n    }\\n}\\n\", \"content_hash\": \"bdba80eb19b1472b584f9e327d0e51c64249bc354b6f84f97ab3828e3e026bff\"}, {\"identity\": \"com.ibm.dse.base.Context\", \"content\": \"package com.ibm.dse.base;\\n\\nimport java.sql.Connection;\\nimport java.util.HashMap;\\nimport java.util.Map;\\nimport java.util.Objects;\\n\\n/** Demo operation context containing named values and an externally supplied JDBC connection. */\\npublic class Context {\\n    private final Map<String, Object> values = new HashMap<>();\\n    private Connection connection;\\n\\n    public Object getValueAt(String name) {\\n        return values.get(Objects.requireNonNull(name, \\\"Context field name\\\"));\\n    }\\n\\n    public void setValueAt(String name, Object value) {\\n        values.put(Objects.requireNonNull(name, \\\"Context field name\\\"), value);\\n    }\\n\\n    /** The caller owns the connection and its transaction lifecycle. */\\n    public void setConnection(Connection connection) {\\n        this.connection = Objects.requireNonNull(connection, \\\"JDBC connection\\\");\\n    }\\n\\n    public Connection getConnection() {\\n        if (connection == null) {\\n            throw new IllegalStateException(\\\"Configure a JDBC connection before executing a database step\\\");\\n        }\\n        return connection;\\n    }\\n}\\n\", \"content_hash\": \"2ecbe34eb7f561dab6bdbe5d9949b56e652f33c8a8e792994fdba33114cacf71\"}, {\"identity\": \"com.ibm.il.dse.operations.common.MapErrorByValueAlways\", \"content\": \"package com.ibm.il.dse.operations.common;\\n\\nimport com.ibm.dse.base.CCOperationStep;\\nimport com.ibm.dse.base.Context;\\n\\n/**\\n * Shared utility opStep. Sets ErrorCategory and ErrorNumber in context.\\n * Used by virtually every operation for error handling.\\n *\\n * XML attributes (passed via setter methods):\\n *   ErrorCategory - string category code (e.g. \\\"10\\\", \\\"99\\\")\\n *   ErrorNumber   - string error number within category (e.g. \\\"0\\\", \\\"4\\\")\\n *\\n * Returns:\\n *   0 - always (mapping always succeeds)\\n */\\npublic class MapErrorByValueAlways extends CCOperationStep {\\n\\n    private String errorCategory = \\\"99\\\";\\n    private String errorNumber   = \\\"0\\\";\\n\\n    public void setErrorCategory(String errorCategory) {\\n        this.errorCategory = errorCategory;\\n    }\\n\\n    public void setErrorNumber(String errorNumber) {\\n        this.errorNumber = errorNumber;\\n    }\\n\\n    @Override\\n    public int execute() throws Exception {\\n        Context ctx = getContext();\\n        ctx.setValueAt(\\\"ErrorCategory\\\",   errorCategory);\\n        ctx.setValueAt(\\\"ErrorNumber\\\",     errorNumber);\\n        ctx.setValueAt(\\\"ErrorDescription\\\", resolveErrorDescription(errorCategory, errorNumber));\\n        return 0;\\n    }\\n\\n    private String resolveErrorDescription(String category, String number) {\\n        // Lookup from error message catalog (simplified for demo)\\n        String key = category + \\\"_\\\" + number;\\n        switch (key) {\\n            case \\\"10_2\\\": return \\\"Validation failed: required field missing or invalid\\\";\\n            case \\\"20_1\\\": return \\\"No data found for the provided criteria\\\";\\n            case \\\"20_4\\\": return \\\"Account not found\\\";\\n            case \\\"30_5\\\": return \\\"Access denied: insufficient permissions\\\";\\n            case \\\"40_3\\\": return \\\"Daily transfer limit exceeded\\\";\\n            case \\\"40_4\\\": return \\\"Insufficient funds\\\";\\n            case \\\"40_5\\\": return \\\"Account not eligible for this operation\\\";\\n            case \\\"50_2\\\": return \\\"Transfer blocked: fraud risk detected\\\";\\n            case \\\"60_6\\\": return \\\"Core banking system rejected the request\\\";\\n            case \\\"60_7\\\": return \\\"Transfer already processed\\\";\\n            case \\\"99_0\\\": return \\\"Technical error: unexpected system failure\\\";\\n            case \\\"99_8\\\": return \\\"Technical error: database connection failure\\\";\\n            default:     return \\\"System error (category=\\\" + category + \\\", number=\\\" + number + \\\")\\\";\\n        }\\n    }\\n}\\n\", \"content_hash